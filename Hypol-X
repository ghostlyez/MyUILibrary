        for i, row in ipairs(ordered) do
            local pad, tag = row.Padding, row.TabTag
            if show then
                row.Button.TextTransparency = 1
                tag.TextTransparency = 1
                pad.PaddingLeft = UDim.new(0, 30)
                tag.Position = QPTag.UDim(row, 32)
                local rowDelay = 0.14 + (i - 1) * step
                task.delay(rowDelay, function()
                    if animationId ~= quickPagesAnimationId then return end
                    if row.Button and row.Button.Parent then
                        Tween(row.Button, { TextTransparency = 0 }, QPInfo(0.5))
