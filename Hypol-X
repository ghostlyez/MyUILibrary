                FXMark(Create("UIGradient", { Parent = scan, Rotation = 90,
                    Color = ColorSequence.new(Color3.fromRGB(255, 35, 78), Color3.fromRGB(145, 73, 255)),
                    Transparency = NumberSequence.new({ KN(0, 1), KN(0.5, 0.7), KN(1, 1) }) }))
                Loop("ZXExploiter_Scan_" .. i, scan, { Position = UDim2.new(0, 0, 0.88, 0) }, 3.2 + i * 0.35, true)

                -- Angular corner ticks and four small telemetry nodes make the theme read at a glance.
