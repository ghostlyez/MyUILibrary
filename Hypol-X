                    Tween(btn, { BackgroundColor3 = KEY_CHIP_BG_HOVER }, TI.Fast); Tween(st, { Color = FIELD_STROKE_HOT }, TI.Fast)
                end)
                btn.MouseLeave:Connect(function()
                    Tween(btn, { BackgroundColor3 = KEY_CHIP_BG }, TI.Fast); Tween(st, { Color = KEY_CHIP_STROKE }, TI.Fast)
                end)
                AddBounce(btn, 0.9)
                return btn
            end
            local plus = mk("+", -12)
            local label = Create("TextLabel", { Parent = card, Text = "", Font = Enum.Font.GothamBold, TextSize = 11,
                TextScaled = false, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(0, 40, 0, 22),
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -38, 0.5, 0) })
            local minus = mk("-", -82)
            local function set(v)
                v = math.clamp(tonumber(v) or initial, minV, maxV)
                v = minV + math.floor((v - minV) / stepV + 0.5) * stepV
                value = v
                label.Text = fmt(v)
                minus.TextTransparency = v <= minV and 0.6 or 0
                plus.TextTransparency = v >= maxV and 0.6 or 0
                onChange(v)
            end
            minus.MouseButton1Click:Connect(function() PlayUISound(UI_SOUND_IDS.Control); set(value - stepV) end)
            plus.MouseButton1Click:Connect(function() PlayUISound(UI_SOUND_IDS.Control); set(value + stepV) end)
            set(initial)
            return set, function() return value end
        end

