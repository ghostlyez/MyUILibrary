                Create("UIGradient",{Parent=SectionContainer,Rotation=90,Color=ColorSequence.new(
                    Color3.fromRGB(255,255,255),Color3.fromRGB(238,237,244))})
                local CardStroke = Create("UIStroke",{Parent=SectionContainer,Color=Color3.fromRGB(104,106,122),Thickness=1.25,Transparency=0.12,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
                CardStroke:SetAttribute("zx_keep", true)
                Create("UIGradient",{Parent=CardStroke,Rotation=90,Color=ColorSequence.new({
                    ColorSequenceKeypoint.new(0,Color3.fromRGB(150,152,168)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(86,88,102)),
                    ColorSequenceKeypoint.new(1,Color3.fromRGB(122,124,140))})})
                SectionContainer.ZIndex = 1

                table.insert(Window.AllCards, { Card=SectionContainer, Group=SectionGroup, OrigParent=target,
                    Tab=TabConfig, Page=PageObj, SearchIndex=nil })

                local ItemContainer = Create("Frame",{Parent=SectionContainer,BackgroundTransparency=1,
                    Size=UDim2.new(1,0,0,0),Position=UDim2.new(0,0,0,0),AutomaticSize=Enum.AutomaticSize.Y})
                Create("UIPadding",{Parent=ItemContainer,PaddingBottom=UDim.new(0,10),PaddingTop=UDim.new(0,8)})
                Create("UIListLayout",{Parent=ItemContainer,SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,8)})

                local Elements = {}

                -- ------------------------------------------------------------
                -- Card minimize / restore (height-driven so the cards below glide up and fill the gap;
                -- title bar + button stay put). Only runs while the window is at rest.
                -- ------------------------------------------------------------
                local collapsed, cardToken, cardBusy, lastFullH = false, 0, false, 60
                local function CardSetCollapsed(state)
                    if state == collapsed or not RS.AtRest() then return end
                    local mf = Window.MainFrame
                    local s = mf.AbsoluteSize.X / math.max(mf.Size.X.Offset, 1)
                    if s < 0.05 then return end
                    collapsed = state
                    cardToken = cardToken + 1
                    local token = cardToken
                    cardBusy = true
                    PlayUISound(UI_SOUND_IDS.Control)
                    Tween(MinChevron, { Rotation = state and 0 or 180 }, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out))
                    Tween(TitleStroke, { Transparency = 0.05, Color = AccentColor }, TI.Fast)
                    task.delay(0.35, function()
                        if TitleStroke.Parent then Tween(TitleStroke, { Transparency = 0.5, Color = LiveTheme.Map(Color3.fromRGB(88,72,138)) }, TI.Slow) end
                    end)
                    TitleLaser.Position = UDim2.new(0, -60, 1, 0)
                    TitleLaser.BackgroundTransparency = 0
                    Tween(TitleLaser, { Position = UDim2.new(1, 0, 1, 0) }, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)).Completed:Once(function()
                        TitleLaser.BackgroundTransparency = 1
                    end)
                    local slide = TweenInfo.new(0.32, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                    if state then
                        local h = math.max(1, SectionContainer.AbsoluteSize.Y / s)
                        lastFullH = h
                        SectionContainer.AutomaticSize = Enum.AutomaticSize.None
                        SectionContainer.Size = UDim2.new(1, 0, 0, h)
                        Tween(ItemContainer, { Position = UDim2.new(0, 0, 0, -h) }, slide)
                        Tween(CardStroke, { Transparency = 1 }, slide)
                        Tween(SectionContainer, { Size = UDim2.new(1, 0, 0, 0) }, slide).Completed:Once(function()
                            if token ~= cardToken then return end
                            SectionContainer.Visible = false
                            cardBusy = false
                        end)
                    else
                        SectionContainer.Visible = true
                        SectionContainer.AutomaticSize = Enum.AutomaticSize.None
                        SectionContainer.Size = UDim2.new(1, 0, 0, 0)
                        ItemContainer.Position = UDim2.new(0, 0, 0, -lastFullH)
                        task.spawn(function()
                            task.wait()
                            if token ~= cardToken then return end
                            local h = ItemContainer.AbsoluteSize.Y / s
                            if h < 8 then h = lastFullH end
                            ItemContainer.Position = UDim2.new(0, 0, 0, -h)
                            Tween(ItemContainer, { Position = UDim2.new(0, 0, 0, 0) }, slide)
                            Tween(CardStroke, { Transparency = 0.3 }, slide)
                            Tween(SectionContainer, { Size = UDim2.new(1, 0, 0, h) }, slide).Completed:Once(function()
                                if token ~= cardToken then return end
                                SectionContainer.AutomaticSize = Enum.AutomaticSize.Y
                                SectionContainer.Size = UDim2.new(1, 0, 0, 0)
                                ItemContainer.Position = UDim2.new(0, 0, 0, 0)
                                cardBusy = false
                            end)
                        end)
                    end
                end
                -- Instant expand (used by Settings > Reset Settings): no animation, card is simply open again.
                Window.AllCards[#Window.AllCards].Expand = function()
                    if not collapsed then return end
                    collapsed = false
                    cardToken = cardToken + 1
                    cardBusy = false
                    SectionContainer.Visible = true
                    SectionContainer.AutomaticSize = Enum.AutomaticSize.Y
                    SectionContainer.Size = UDim2.new(1, 0, 0, 0)
                    ItemContainer.Position = UDim2.new(0, 0, 0, 0)
                    CardStroke.Transparency = 0.3
                    MinChevron.Rotation = 180
                end
                MinBtn.MouseButton1Click:Connect(function() CardSetCollapsed(not collapsed) end)
                -- Self-repair after the window minimize/restore cycle: re-asserts position, clip and auto-size so a card
                -- can never come back displaced below the section or with a stale height.
                RS.Healers[#RS.Healers + 1] = function()
                    if cardBusy or not SectionGroup.Parent then return end
                    SectionContainer.Position = UDim2.new(0, 0, 0, 30)
                    TitleBar.Position = UDim2.new(0, 0, 0, 0)
                    if collapsed then
                        SectionContainer.Visible = false
                        return
                    end
                    ItemContainer.Position = UDim2.new(0, 0, 0, 0)
                    SectionContainer.AutomaticSize = Enum.AutomaticSize.None
                    SectionContainer.AutomaticSize = Enum.AutomaticSize.Y
                    SectionGroup.AutomaticSize = Enum.AutomaticSize.None
                    SectionGroup.AutomaticSize = Enum.AutomaticSize.Y
                end

                -- ------------------------------------------------------------
                -- Shared action-button builder (Button and Copy Button look identical)
                -- ------------------------------------------------------------
                local function BuildActionButton(name, infoData, onClick)
                    local BtnFrame = Create("Frame",{Parent=ItemContainer,BackgroundTransparency=1,Size=UDim2.new(1,0,0,32)})
                    local Btn = Create("TextButton",{Parent=BtnFrame,Text=tostring(name),Font=Enum.Font.GothamBold,TextSize=12,
                        TextColor3=TextColor,BackgroundColor3=BackgroundColor,Size=UDim2.new(1,-35,1,0),
                        Position=UDim2.new(0,10,0,0),AutoButtonColor=false,
                        TextXAlignment=Enum.TextXAlignment.Center,TextTruncate=Enum.TextTruncate.AtEnd})
                    Create("UIPadding",{Parent=Btn,PaddingLeft=UDim.new(0,40),PaddingRight=UDim.new(0,40)})
                    Create("UICorner",{Parent=Btn,CornerRadius=UDim.new(0,8)})
                    Create("UIStroke",{Parent=Btn,Color=Color3.fromRGB(45,45,50),Thickness=1})
                    ApplyDarkButtonStyle(Btn, 8, true)
                    AddBounce(Btn, 0.97)

                    local deco = Btn.ZIndex + 1
                    local Notch = Create("Frame",{Parent=BtnFrame,BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,
                        Size=UDim2.new(0,3,0,12),AnchorPoint=Vector2.new(0,0.5),Position=UDim2.new(0,18,0.5,0),
                        Active=false,ZIndex=deco})
                    Create("UICorner",{Parent=Notch,CornerRadius=UDim.new(1,0)})
                    Create("UIGradient",{Parent=Notch,Rotation=90,Color=ColorSequence.new(
                        AccentColor,Color3.fromRGB(110,72,210))})

                    local Chip = Create("Frame",{Parent=BtnFrame,BackgroundColor3=Color3.fromRGB(30,31,40),BorderSizePixel=0,
                        Size=UDim2.new(0,24,0,20),AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-31,0.5,0),
                        Active=false,ZIndex=deco})
                    Create("UICorner",{Parent=Chip,CornerRadius=UDim.new(0,6)})
                    local ChipStroke = Create("UIStroke",{Parent=Chip,Color=Color3.fromRGB(62,64,78),Thickness=1,Transparency=0.35})
                    local Arrow, ArrowBars = CreateChevron(Chip, SubTextColor, deco + 1, 8)
                    Arrow.Rotation = -90

                    local function Light(on)
                        Tween(Notch, { Size = UDim2.new(0, 3, 0, on and 18 or 12) },
                            TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
                        Tween(Chip, { BackgroundColor3 = on and AccentColor or Color3.fromRGB(30,31,40) }, TI.Fast)
                        Tween(ChipStroke, { Transparency = on and 1 or 0.35 }, TI.Fast)
                        Tween(Arrow, { Position = UDim2.new(0.5, on and 2 or 0, 0.5, 0) },
                            TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
                        for _, bar in ipairs(ArrowBars) do
                            Tween(bar, { BackgroundColor3 = on and Color3.fromRGB(16,16,20) or SubTextColor }, TI.Fast)
                        end
                    end
                    Btn.MouseEnter:Connect(function() Light(true) end)
                    Btn.MouseLeave:Connect(function() Light(false) end)

                    Btn.MouseButton1Click:Connect(function()
                        PlayUISound(UI_SOUND_IDS.Control)
                        Tween(Arrow, { Position = UDim2.new(0.5, 7, 0.5, 0) },
                            TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)).Completed:Once(function()
                            Tween(Arrow, { Position = UDim2.new(0.5, 2, 0.5, 0) },
                                TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
                        end)
                        if onClick then onClick(Btn) end
                    end)
                    AddInfoIcon(BtnFrame, UDim2.new(1,-20,0.5,-8), infoData)
                    return Btn
                end

                function Elements:AddCopyButton(name, copyText, infoData)
                    local Btn
                    local originalText = tostring(name)
                    local feedbackGeneration = 0
                    Btn = BuildActionButton(name, infoData, function()
                        local copied, copyError = CopyToClipboard(copyText)
                        if not copied then
                            warn(copyError or "Clipboard copy failed.")
                            return
                        end
                        feedbackGeneration = feedbackGeneration + 1
                        local generation = feedbackGeneration
                        Btn.Text = "Copied to Clipboard"
                        Tween(Btn, {TextColor3=AccentColor}, TI.Linear)
                        task.delay(1.5, function()
                            if Btn.Parent and feedbackGeneration == generation then
                                Btn.Text = originalText
                                Tween(Btn, {TextColor3=TextColor}, TI.Linear)
                            end
                        end)
                    end)
                end

                function Elements:AddButton(name, callback, infoData)
                    local confirmCfg = Library.GetConfirm(infoData) -- optional: infoData.Confirm = { Title, Description, Yes, No }
                    BuildActionButton(name, infoData, function(anchor)
                        local function run() if callback then callback() end end
                        if confirmCfg and RS.Ask then RS.Ask(anchor, confirmCfg, run) else run() end
                    end)
                end

                -- ------------------------------------------------------------
                -- Toggle
                -- ------------------------------------------------------------
                function Elements:AddToggle(name, default, callback, infoData)
                    local state = default or false
                    local defaultEnabled = IsDefaultEnabled(infoData, false)
                    if defaultEnabled then
                        local configuredState = GetConfiguredValue(infoData, "DefaultState", "DefaultValue", "Default")
                        if type(configuredState) == "boolean" then state = configuredState end
                    end
                    local TogFrame = Create("Frame",{Parent=ItemContainer,BackgroundTransparency=1,Size=UDim2.new(1,0,0,24)})
                    Create("TextLabel",{Parent=TogFrame,Text=name,Font=Enum.Font.GothamBold,TextSize=12,
                        TextColor3=SubTextColor,BackgroundTransparency=1,Size=UDim2.new(1,-60,1,0),
                        Position=UDim2.new(0,10,0,0),TextXAlignment=Enum.TextXAlignment.Left})
                    local ToggleButton, SetToggleVisual = CreateSquareToggle(TogFrame,
                        UDim2.new(1,-28,0.5,-9), state, UDim2.new(0,18,0,18))

                    local function internalSet(v)
                        state = v
                        SetToggleVisual(state)
                        if callback then callback(state) end
                    end
                    local confirmCfg = Library.GetConfirm(infoData) -- optional: infoData.Confirm = { Title, Description, Yes, No }
                    ToggleButton.MouseButton1Click:Connect(function()
                        local want = not state
                        if confirmCfg and RS.Ask then
                            -- nothing changes (visual, state, callback) until Yes; No / dismiss leaves the toggle as it was
                            RS.Ask(ToggleButton, confirmCfg, function() internalSet(want) end)
                        else
                            internalSet(want)
                        end
                    end)

                    do
                        local tw = MeasureTitleWidth(name)
                        AddInfoIcon(TogFrame, UDim2.new(0, 10+tw+5, 0.5, -8), infoData)
                    end
                    Window.ConfigElements[name] = { Set=internalSet, Get=function() return state end, Default=state }
                    if defaultEnabled or state == true then
                        -- A toggle that starts ON must actually run its feature, not just look on.
                        FireInitialCallback(callback, state)
                    end
                end

                -- ------------------------------------------------------------
                -- Slider
                -- ------------------------------------------------------------
                function Elements:AddSlider(name, min, max, default, callback, infoData)
                    if max < min then min, max = max, min end
                    local explicitDefaultSetting = type(infoData) == "table" and infoData.DefaultEnabled ~= nil
                    local defaultEnabled = IsDefaultEnabled(infoData, false)
                    local configuredDefault = tonumber(default)
                    if defaultEnabled then
                        configuredDefault = tonumber(GetConfiguredValue(infoData, "DefaultValue", "InitialValue", "Default")) or configuredDefault
                    elseif not explicitDefaultSetting and type(infoData) == "table"
                    and infoData.Default ~= nil and type(infoData.Default) ~= "boolean" then
                        -- Legacy numeric infoData.Default still works if the new flag is omitted.
                        configuredDefault = tonumber(infoData.Default) or configuredDefault
                    end
                    if configuredDefault == nil then configuredDefault = min end
                    local sliderStep = tonumber(type(infoData) == "table" and (infoData.Step or infoData.SliderStep) or nil)
                    if not sliderStep or sliderStep <= 0 then sliderStep = nil end
                    local function NormalizeSliderValue(value)
                        value = math.clamp(value, min, max)
                        if sliderStep then
                            value = min + math.floor(((value - min) / sliderStep) + 0.5) * sliderStep
                            value = math.clamp(value, min, max)
                        end
                        return value
                    end
                    local val = NormalizeSliderValue(configuredDefault)
                    local range = max - min
                    local function ValueRatio(v)
                        if range <= 0 then return 0 end
                        return math.clamp((v - min) / range, 0, 1)
                    end
                    local SliFrame = Create("Frame",{Parent=ItemContainer,BackgroundTransparency=1,Size=UDim2.new(1,0,0,45)})
                    Create("TextLabel",{Parent=SliFrame,Text=name,Font=Enum.Font.GothamBold,TextSize=12,
                        TextColor3=SubTextColor,BackgroundTransparency=1,Size=UDim2.new(1,-60,0,15),
                        Position=UDim2.new(0,10,0,0),TextXAlignment=Enum.TextXAlignment.Left})
                    local ValTxt = Create("TextLabel",{Parent=SliFrame,Text=tostring(val),Font=Enum.Font.GothamBold,
                        TextSize=12,TextColor3=TextColor,BackgroundTransparency=1,Size=UDim2.new(0,40,0,15),
                        Position=UDim2.new(0.94,0,0,0),AnchorPoint=Vector2.new(1,0),
                        TextXAlignment=Enum.TextXAlignment.Right,TextScaled=true,TextTruncate=Enum.TextTruncate.None,
                        ClipsDescendants=true})
                    Create("UITextSizeConstraint",{Parent=ValTxt,MaxTextSize=12,MinTextSize=6})

                    local TrackBase = Create("Frame",{Parent=SliFrame,BackgroundColor3=Color3.fromRGB(38,38,42),
                        Size=UDim2.new(1,-20,0,8),Position=UDim2.new(0,10,0,24),BorderSizePixel=0,Active=true})
                    Create("UICorner",{Parent=TrackBase,CornerRadius=UDim.new(1,0)})

                    local Fill = Create("Frame",{Parent=TrackBase,BackgroundColor3=AccentColor,BorderSizePixel=0,
                        Size=UDim2.new(ValueRatio(val),0,1,0),Active=true})
                    Create("UICorner",{Parent=Fill,CornerRadius=UDim.new(1,0)})
                    local Knob = Create("Frame",{Parent=Fill,BackgroundColor3=Color3.fromRGB(248,248,250),
                        BackgroundTransparency=1,BorderSizePixel=0,Active=true,
                        Size=UDim2.new(0,12,0,12),Position=UDim2.new(1,-6,0.5,-6),ZIndex=TrackBase.ZIndex+2})
                    Create("UICorner",{Parent=Knob,CornerRadius=UDim.new(1,0)})
                    Create("UIStroke",{Parent=Knob,Color=Color3.fromRGB(150,150,160),Thickness=1,Transparency=1})

                    local function internalSet(v)
                        local numericValue = tonumber(v)
                        if numericValue == nil then return end
                        v = NormalizeSliderValue(numericValue)
                        val = v
                        ValTxt.Text = tostring(v)
                        Fill.Size = UDim2.new(ValueRatio(v), 0, 1, 0)
                        if callback then callback(val) end
                    end

                    local activeInput, activeInputType
                    local activeChangedConn, activeEndConn, activeTouchEndedConn, activeFocusLostConn
                    local function StopDrag(expectedInput)
                        -- End/cancel events from another finger must not release this drag.
                        if expectedInput and activeInput and expectedInput ~= activeInput then return end
                        if not activeInput and not activeChangedConn and not activeEndConn
                        and not activeTouchEndedConn and not activeFocusLostConn then return end
                        activeInput = nil
                        activeInputType = nil
                        if ActiveControlDragOwner == SliFrame then ActiveControlDragOwner = nil end
                        if activeChangedConn then activeChangedConn:Disconnect(); activeChangedConn = nil end
                        if activeEndConn then activeEndConn:Disconnect(); activeEndConn = nil end
                        if activeTouchEndedConn then activeTouchEndedConn:Disconnect(); activeTouchEndedConn = nil end
                        if activeFocusLostConn then activeFocusLostConn:Disconnect(); activeFocusLostConn = nil end
                    end

                    local function ApplyInputPosition(position)
                        local width = TrackBase.AbsoluteSize.X
                        if width <= 0 then return end
                        local ratio = math.clamp((position.X - TrackBase.AbsolutePosition.X) / width, 0, 1)
                        local rawValue = min + ((max - min) * ratio)
                        -- Preserve the existing integer drag behavior unless a step was specified.
                        if not sliderStep then rawValue = math.floor(rawValue + 0.5) end
                        internalSet(rawValue)
                    end

                    local function BeginDrag(input)
                        if input.UserInputType ~= Enum.UserInputType.MouseButton1
                        and input.UserInputType ~= Enum.UserInputType.Touch then return end
                        if activeInput or ActiveControlDragOwner then return end

                        activeInput = input
                        activeInputType = input.UserInputType
                        ActiveControlDragOwner = SliFrame
                        ApplyInputPosition(input.Position)

                        activeFocusLostConn = UserInputService.WindowFocusReleased:Connect(function()
                            StopDrag()
                        end)
                        if activeInputType == Enum.UserInputType.Touch then
                            activeChangedConn = UserInputService.TouchMoved:Connect(function(touch)
                                if activeInput and ActiveControlDragOwner == SliFrame and touch == activeInput then
                                    ApplyInputPosition(touch.Position)
                                end
                            end)
                            activeTouchEndedConn = UserInputService.TouchEnded:Connect(function(touch)
                                if activeInput and touch == activeInput then StopDrag(touch) end
                            end)
                            -- InputEnded provides a cancellation fallback while its identity check
                            -- still prevents a second finger from terminating this drag.
                            activeEndConn = UserInputService.InputEnded:Connect(function(endedInput)
                                if activeInput and endedInput == activeInput then StopDrag(endedInput) end
                            end)
                        else
                            activeChangedConn = UserInputService.InputChanged:Connect(function(changedInput)
                                if activeInput and activeInputType == Enum.UserInputType.MouseButton1
                                and ActiveControlDragOwner == SliFrame
                                and changedInput.UserInputType == Enum.UserInputType.MouseMovement then
                                    ApplyInputPosition(changedInput.Position)
                                end
                            end)
                            activeEndConn = UserInputService.InputEnded:Connect(function(endedInput)
                                if not activeInput then return end
                                if endedInput == activeInput
                                or (activeInputType == Enum.UserInputType.MouseButton1
                                    and endedInput.UserInputType == Enum.UserInputType.MouseButton1) then
                                    StopDrag()
                                end
                            end)
                        end
                    end

                    local function OnInput(input)
                        BeginDrag(input)
                    end
                    Knob.InputBegan:Connect(OnInput)
                    Fill.InputBegan:Connect(OnInput)
                    TrackBase.InputBegan:Connect(OnInput)
                    SliFrame.Destroying:Connect(function() StopDrag() end)

                    do
                        local tw = MeasureTitleWidth(name)
                        AddInfoIcon(SliFrame, UDim2.new(0, 10+tw+6, 0, 0), infoData)
                    end
                    -- Apply the configured value immediately (no tween); the displayed
                    -- fill/label and the value returned by Get() share this exact value.
                    ValTxt.Text = tostring(val)
                    Fill.Size = UDim2.new(ValueRatio(val), 0, 1, 0)
                    Window.ConfigElements[name] = { Set=internalSet, Get=function() return val end, Default=val }
                    if defaultEnabled then
                        FireInitialCallback(callback, val)
                    end
                end

                -- ------------------------------------------------------------
                -- Keybind
                -- ------------------------------------------------------------
                function Elements:AddKeybind(name, defaultKey, callback, infoData)
                    local enabled = false
                    local currentKeyName = defaultKey or "..."
                    local currentKeyCode = nil
                    local listening = false
                    if defaultKey and defaultKey ~= "..." and defaultKey ~= "" then
                        local ok, kc = pcall(function() return Enum.KeyCode[defaultKey] end)
                        if ok and kc then currentKeyCode = kc end
                    end

                    local KFrame = Create("Frame",{Parent=ItemContainer,BackgroundTransparency=1,Size=UDim2.new(1,0,0,26)})
                    Create("TextLabel",{Parent=KFrame,Text=name,Font=Enum.Font.GothamBold,TextSize=12,
                        TextColor3=SubTextColor,BackgroundTransparency=1,Size=UDim2.new(1,-118,1,0),
                        Position=UDim2.new(0,10,0,0),TextXAlignment=Enum.TextXAlignment.Left})

                    local KEY_W = 56
                    -- Toggle sits just left of the key chip (chip right edge = 6px from the row edge).
                    local ToggleButton, SetToggleVisual = CreateSquareToggle(KFrame,
                        UDim2.new(1,-(KEY_W+32),0.5,-9), enabled, UDim2.new(0,18,0,18))

                    -- Simple key chip: flat rounded body, quiet border, accent only while listening.
                    local KeyChip = CreateKeyChip(KFrame, UDim2.new(1,-6,0.5,0), currentKeyName, KEY_W)
                    local KeyBtn = KeyChip.Button

                    do
                        local tw = MeasureTitleWidth(name)
                        AddInfoIcon(KFrame, UDim2.new(0, 10+tw+5, 0.5, -8), infoData)
                    end

                    local function SetKeyText(keyName)
                        KeyChip.SetKey(keyName)
                    end
                    local function SetListeningVisual(on)
                        KeyChip.SetListening(on)
                    end
                    -- Short confirmation nudge after a new key is captured.
                    local function PopKey()
                        local scale = KeyBtn:FindFirstChild("__BounceScale")
                        if not scale then return end
                        Tween(scale, {Scale = 1.08}, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
                            .Completed:Once(function()
                                Tween(scale, {Scale = 1}, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
                            end)
                    end

                    local function RefreshToggleVisual()
                        SetToggleVisual(enabled)
                    end
                    local function SetState(v)
                        enabled = v
                        RefreshToggleVisual()
                        if callback then callback(enabled) end
                    end

                    KeyBtn.MouseButton1Click:Connect(function()
                        if Window._cancelActiveKeybind then
                            Window._cancelActiveKeybind()
                            Window._cancelActiveKeybind = nil
                        end
                        listening = true
                        SetListeningVisual(true)
                        Window._cancelActiveKeybind = function()
                            listening = false
                            SetKeyText(currentKeyName)
                            SetListeningVisual(false)
                        end
                    end)

                    UserInputService.InputBegan:Connect(function(input, gpe)
                        if gpe then return end
                        if listening then
                            if input.UserInputType == Enum.UserInputType.Keyboard then
                                local kc = input.KeyCode
                                if kc == Enum.KeyCode.Unknown then return end
                                currentKeyCode = kc
                                currentKeyName = kc.Name
                                SetKeyText(currentKeyName)
                                listening = false
                                SetListeningVisual(false)
                                PopKey()
                                Window._cancelActiveKeybind = nil
                                return
                            end
                        end
                        if currentKeyCode and input.KeyCode == currentKeyCode then
                            PlayUISound(UI_SOUND_IDS.Toggle)
                            SetState(not enabled)
                        end
                    end)

                    ToggleButton.MouseButton1Click:Connect(function() SetState(not enabled) end)
                    RefreshToggleVisual()

                    Window.ConfigElements[name] = {
                        Set=function(v)
                            if type(v)=="boolean" then
                                enabled = v; RefreshToggleVisual()
                                if callback then callback(enabled) end
                            elseif type(v)=="table" then
                                if v.enabled ~= nil then
                                    enabled = v.enabled; RefreshToggleVisual()
                                    if callback then callback(enabled) end
                                end
                                if v.key then
                                    currentKeyName = tostring(v.key)
                                    SetKeyText(currentKeyName)
                                    local ok, kc = pcall(function() return Enum.KeyCode[tostring(v.key)] end)
                                    if ok and kc then currentKeyCode = kc end
                                end
                            elseif type(v)=="string" then
                                currentKeyName = v; SetKeyText(v)
                                local ok, kc = pcall(function() return Enum.KeyCode[v] end)
                                if ok and kc then currentKeyCode = kc end
                            end
                        end,
                        Get=function() return {enabled=enabled, key=currentKeyName} end,
                        Default={enabled=false, key=defaultKey or "..."}
                    }
                end

                -- ------------------------------------------------------------
                -- Shared dropdown UI (single-select, multi-select, and limited multi-select)
                -- ------------------------------------------------------------
                local function BuildDropdownUi(name, options, isMulti, limit, callback, infoData, showLimitInfo)
                    options = type(options) == "table" and options or {}
                    limit = math.max(0, math.floor(tonumber(limit) or 4))
                    local selectionLimit = (isMulti and showLimitInfo) and limit or nil
                    local legacyDropdownDefault = type(infoData) == "table" and infoData.Default == true
                    local configuredDefault = IsDefaultEnabled(infoData, legacyDropdownDefault)
                    local defaultOptionsValue
                    if configuredDefault and type(infoData) == "table" then
                        if infoData.DefaultEnabled ~= nil then
                            -- New universal configuration: options may be supplied as either
                            -- a list or a single value; aliases keep the API convenient.
                            defaultOptionsValue = GetConfiguredValue(infoData,
                                "DefaultSelections", "DefaultOptions", "Default Options", "DefaultValue")
                            if defaultOptionsValue == nil and infoData.Default ~= true then
                                defaultOptionsValue = infoData.Default
                            end
                        else
                            -- Preserve the existing legacy key precedence exactly.
                            defaultOptionsValue = infoData["Default Options"]
                            if defaultOptionsValue == nil then defaultOptionsValue = infoData.DefaultOptions end
                        end
                    end
                    local defaultOptionsSpecified = defaultOptionsValue ~= nil

                    local function FindValidOption(value)
                        local directIndex = table.find(options, value)
                        if directIndex then return options[directIndex] end
                        local valueText = tostring(value)
                        for _, availableOption in ipairs(options) do
                            if tostring(availableOption) == valueText then return availableOption end
                        end
                        return nil
                    end
                    local function ParseDefaultOptions(value)
                        local parsed = {}
                        if type(value) == "table" then
                            for _, item in ipairs(value) do parsed[#parsed + 1] = item end
                        elseif type(value) == "string" then
                            for item in string.gmatch(value, "([^,]+)") do
                                item = item:gsub("^%s+", ""):gsub("%s+$", "")
                                if item ~= "" then parsed[#parsed + 1] = item end
                            end
                        elseif value ~= nil then
                            parsed[1] = value
                        end
                        return parsed
                    end
                    local function ResolveConfiguredDefaults()
                        local rawDefaults = ParseDefaultOptions(defaultOptionsValue)
                        local validDefaults = {}
                        for _, requestedOption in ipairs(rawDefaults) do
                            local validOption = FindValidOption(requestedOption)
                            if validOption ~= nil and not table.find(validDefaults, validOption) then
                                validDefaults[#validDefaults + 1] = validOption
                            end
                        end
                        if not isMulti then
                            -- A single picker accepts only one valid option. Keep
                            -- the order authored in Default Options for predictability.
                            return validDefaults[1]
                        end
                        if selectionLimit and #validDefaults > selectionLimit then
                            -- Choose a random subset if the requested defaults exceed
                            -- the configured limit, then restore source-option order.
                            for i = #validDefaults, 2, -1 do
                                local j = math.random(1, i)
                                validDefaults[i], validDefaults[j] = validDefaults[j], validDefaults[i]
                            end
                            while #validDefaults > selectionLimit do table.remove(validDefaults) end
                            table.sort(validDefaults, function(a, b)
                                return table.find(options, a) < table.find(options, b)
                            end)
                        end
                        return validDefaults
                    end

                    local selected = isMulti and {} or (options[1] or nil)
                    if configuredDefault then
                        if defaultOptionsSpecified then
                            selected = ResolveConfiguredDefaults()
                        elseif isMulti then
                            selected = {}
                        end
                    end
                    local dropped = false
                    local optionRows = {}
                    local visibleOptionCount = 0
                    local rowHeight = 25
                    local COLLAPSED_ROWS, EXPANDED_ROWS = 3, 10
                    local hasWiden = #options > COLLAPSED_ROWS
                    local widened = false
                    local listHeight = math.min(#options, COLLAPSED_ROWS) * rowHeight
                    local closeToken = 0
                    local WIDEN_TWEEN = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                    local limitX = hasWiden and 42 or 10
                    local userScrolled = false
                    local settingScroll = false

                    local DropFrame = Create("Frame", {
                        Parent = ItemContainer, BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 0, 70), ClipsDescendants = true,
                    })
                    Create("TextLabel", {
                        Parent = DropFrame, Text = tostring(name), Font = Enum.Font.GothamBold,
                        TextSize = 12, TextColor3 = SubTextColor, BackgroundTransparency = 1,
                        Size = UDim2.new(1, -20, 0, 15), Position = UDim2.new(0, 10, 0, 0),
                        TextXAlignment = Enum.TextXAlignment.Left,
                    })

                    local MainBtn = Create("TextButton", {
                        Parent = DropFrame, Text = isMulti and "Select Options..." or "Select...",
                        Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = FIELD_PLACEHOLDER,
                        BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, -20, 0, 26),
                        Position = UDim2.new(0, 10, 0, 20), AutoButtonColor = false,
                        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
                        ClipsDescendants = false, ZIndex = 4,
                    })
                    Create("UIPadding", { Parent = MainBtn, PaddingLeft = UDim.new(0, 11), PaddingRight = UDim.new(0, 34) })
                    -- Select-field chrome (inset body + separated chevron chip) instead of a gradient button.
                    local FieldKit = StyleDropdownField(MainBtn, 8)
                    AddBounce(MainBtn, 0.985)
                    local Arrow = FieldKit.Arrow

                    Create("TextLabel", {
                        Parent = DropFrame, Text = "Options: " .. #options, Font = Enum.Font.Jura,
                        TextSize = 10, TextColor3 = SubTextColor, BackgroundTransparency = 1,
                        Size = UDim2.new(1, -20, 0, 16), Position = UDim2.new(0, 10, 0, 48),
                        TextXAlignment = Enum.TextXAlignment.Left,
                    })

                    local SearchBox = Create("TextBox", {
                        Parent = DropFrame, PlaceholderText = "Search...", Text = "",
                        Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = INPUT_TEXT,
                        BackgroundColor3 = INPUT_BG,
                        Size = UDim2.new(1, -20, 0, 24), Position = UDim2.new(0, 10, 0, 68),
                        TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
                        Visible = false, ZIndex = 5,
                    })
                    Create("UIPadding", { Parent = SearchBox, PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 6) })
                    Create("UICorner", { Parent = SearchBox, CornerRadius = UDim.new(0, 7) })
                    local SearchBoxStroke = Create("UIStroke", { Parent = SearchBox, Color = INPUT_STROKE, Thickness = 1 })
                    StyleCleanInput(SearchBox, SearchBoxStroke)
                    local SB = { tok = 0 }
                    function SB.In()
                        SB.tok = SB.tok + 1
                        SearchBox.BackgroundTransparency = 1; SearchBox.TextTransparency = 1; SearchBoxStroke.Transparency = 1
                        SearchBox.Position = UDim2.new(0, 30, 0, 68); SearchBox.Size = UDim2.new(1, -60, 0, 24)
                        local ti = TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, 0, false, 0.08)
                        Tween(SearchBox, { BackgroundTransparency = 0, TextTransparency = 0, Position = UDim2.new(0, 10, 0, 68), Size = UDim2.new(1, -20, 0, 24) }, ti)
                        Tween(SearchBoxStroke, { Transparency = 0, Color = AccentColor }, ti).Completed:Once(function()
                            Tween(SearchBoxStroke, { Color = INPUT_STROKE }, TweenInfo.new(0.45, Enum.EasingStyle.Sine))
                        end)
                    end
                    function SB.Out()
                        SB.tok = SB.tok + 1
                        local t = SB.tok
                        local ti = TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                        Tween(SearchBox, { BackgroundTransparency = 1, TextTransparency = 1, Position = UDim2.new(0, 30, 0, 68), Size = UDim2.new(1, -60, 0, 24) }, ti)
                        Tween(SearchBoxStroke, { Transparency = 1 }, ti)
                        task.delay(0.26, function() if t == SB.tok then SearchBox.Visible = false end end)
