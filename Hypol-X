-- A single shared, subtle world blur avoids stacking post-effects when more
-- than one ZyronX window is created. The blur is only enabled while a window
-- is visible and is released on minimize/exit.
local function AcquireUIBlur()
    if not SharedUIBlur or not SharedUIBlur.Parent then
        SharedUIBlur = Instance.new("BlurEffect")
        SharedUIBlur.Name = "ZyronX_UIBlur"
        SharedUIBlur.Size = 0
        SharedUIBlur.Enabled = true
        SharedUIBlur.Parent = Lighting
    end
    ActiveBlurUsers = ActiveBlurUsers + 1
    Tween(SharedUIBlur, { Size = 4 }, TI.Slow)
    return SharedUIBlur
end

local function ReleaseUIBlur()
    ActiveBlurUsers = math.max(0, ActiveBlurUsers - 1)
    if ActiveBlurUsers ~= 0 or not SharedUIBlur then return end
    local effect = SharedUIBlur
    local out = Tween(effect, { Size = 0 }, TI.Slow)
    out.Completed:Once(function()
        if ActiveBlurUsers == 0 and SharedUIBlur == effect then
            if effect and effect.Parent then effect:Destroy() end
            SharedUIBlur = nil
        end
    end)
end

-- ============================================================
-- [[ FADE-ALL-DESCENDANTS — one-shot sweep, all parallel ]]
-- ============================================================
local function FadeAllDescendants(root, duration, style, direction)
    if not root then return nil end
    local info = TweenInfo.new(
        duration or 0.35,
        style or Enum.EasingStyle.Quart,
        direction or Enum.EasingDirection.Out
    )
    local last
    local function HasCanvasGroupAncestor(instance)
        local ancestor = instance.Parent
        while ancestor and ancestor ~= root do
            if ancestor:IsA("CanvasGroup") then return true end
            ancestor = ancestor.Parent
        end
        return false
    end
    for _, d in ipairs(root:GetDescendants()) do
        -- A CanvasGroup is the rendered unit: tween its group transparency once
        -- and do not independently fade its children/strokes, which would recreate
        -- the same overlapping-alpha artifacts during exit animations.
        if not HasCanvasGroupAncestor(d) then
            if d:IsA("GuiObject") then
                local props = { BackgroundTransparency = 1 }
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    props.TextTransparency = 1
                    props.TextStrokeTransparency = 1
                end
                if d:IsA("ImageLabel") or d:IsA("ImageButton") then
                    props.ImageTransparency = 1
                end
                if d:IsA("ScrollingFrame") then
                    props.ScrollBarImageTransparency = 1
                end
                if d:IsA("CanvasGroup") then
                    props.GroupTransparency = 1
                end
                last = TweenService:Create(d, info, props)
                last:Play()
            elseif d:IsA("UIStroke") then
                last = TweenService:Create(d, info, { Transparency = 1 })
                last:Play()
            end
        end
    end
    return last
end

-- Keeps a TextBox's glyph size inside its own bounds. TextScaled stays off (no jitter while
-- typing); instead the size is stepped down from the requested size until the text (or the
-- placeholder when empty) fits the padded width and the box height. Re-runs on every change.
local function FitTextBox(box, baseSize)
    local MIN_SIZE = 8
    local fitting = false
    local lastW, lastH = -1, -1
    -- UIScale ancestors scale AbsoluteSize but not TextService measurements, so normalise by them.
    local function ancestorScale()
        local scale = 1
        local p = box.Parent
        while p do
            local u = p:FindFirstChildOfClass("UIScale")
            if u then scale = scale * u.Scale end
            p = p.Parent
        end
        return scale
    end
    local function refit(onlyIfResized)
        if fitting or not box.Parent then return end
        local abs = box.AbsoluteSize
        local scale = ancestorScale()
        if abs.X <= 0 or abs.Y <= 0 or scale <= 0.01 then return end
        local w, h = abs.X / scale, abs.Y / scale
        if onlyIfResized == true and math.abs(w - lastW) < 0.5 and math.abs(h - lastH) < 0.5 then return end
        lastW, lastH = w, h
        fitting = true
        local padL, padR = 0, 0
        local pad = box:FindFirstChildOfClass("UIPadding")
        if pad then
            padL = pad.PaddingLeft.Offset + pad.PaddingLeft.Scale * w
            padR = pad.PaddingRight.Offset + pad.PaddingRight.Scale * w
        end
        local availW = math.max(8, w - padL - padR - 4)
        local availH = math.max(MIN_SIZE, h - 4)
        local size = math.min(baseSize, math.max(MIN_SIZE, math.floor(availH / 1.15)))
        local text = box.Text ~= "" and box.Text or box.PlaceholderText
        if text ~= "" then
            while size > MIN_SIZE do
                local ok, bounds = pcall(function()
                    return TextService:GetTextSize(text, size, box.Font, Vector2.new(100000, 100000))
                end)
                if not ok or bounds.X <= availW then break end
                size = size - 1
            end
        end
        if box.TextSize ~= size then box.TextSize = size end
        fitting = false
    end
    box:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() refit(true) end)
    box:GetPropertyChangedSignal("Text"):Connect(function() refit(false) end)
    box:GetPropertyChangedSignal("PlaceholderText"):Connect(function() refit(false) end)
    box:GetPropertyChangedSignal("Font"):Connect(function() refit(false) end)
    box.AncestryChanged:Connect(function() task.defer(refit, false) end)
    task.defer(refit, false)
end

local function Create(className, properties)
    local inst = Instance.new(className)
    if className == "TextBox" then inst.Text = "" end
    for k, v in pairs(properties or {}) do inst[k] = v end
    if className == "TextBox" then
        -- Editing text: fixed size (no live scaling jitter), no stroke, always clipped to its box
        -- and auto-fitted by FitTextBox so it can never overflow the boundary.
        inst.TextScaled = false
        inst.TextStrokeTransparency = 1
        inst.RichText = false
        inst.TextWrapped = false
        inst.ClipsDescendants = true
        FitTextBox(inst, (properties and properties.TextSize) or 14)
    elseif className == "TextLabel" or className == "TextButton" then
        if properties.TextSize and properties.RichText ~= true then
            -- Keep the responsive default while respecting an explicit
            -- TextScaled=false for controls that need literal glyph sizing.
            if properties.TextScaled == nil then inst.TextScaled = true end
            local c = Instance.new("UITextSizeConstraint")
            c.MaxTextSize = properties.TextSize
            c.MinTextSize = math.min(properties.TextSize, math.max(8, math.floor(properties.TextSize * 0.75)))
            c.Parent = inst
        end
    end
    return inst
end

local function SafeClone(t)
    if type(t) ~= "table" then return t end
    if table.clone then return table.clone(t) end
    local c = {} for k,v in pairs(t) do c[k]=v end return c
end

-- Universal optional initial-default configuration shared by sliders, toggles,
-- single pickers, multi pickers, and selection-limited dropdowns. An explicit
-- DefaultEnabled=false always disables the new developer-default override.
-- When the flag is absent, legacy component-specific behavior remains intact.
local function IsDefaultEnabled(infoData, legacyEnabled)
    if type(infoData) ~= "table" then return false end
    if infoData.DefaultEnabled ~= nil then
        return infoData.DefaultEnabled == true
    end
    return legacyEnabled == true
end

-- Fires a control's callback once for its initial (default) value. It is deferred so the
-- script that built the UI has finished defining its own locals/functions first, and it is
-- wrapped in pcall so one bad callback cannot break the build of the rest of the window.

-- // Cinematic restore writer. Collect text BEFORE shell mode hides page roots,
-- then reveal each visible row in a readable cascade after the window materializes.
Library._TypeFX = {}
do
    local TypeFX = Library._TypeFX
    local function Shown(d, root)
        local p = d
        while p and p ~= root do
            if p:IsA("GuiObject") and not p.Visible then return false end
            p = p.Parent
        end
        return true
    end
    TypeFX.Shown = Shown

    -- Normalize vertical coordinates by the library window's UIScale so row-stagger timing
    -- remains consistent on small screens and user-adjusted scale settings.
    local function RevealY(d)
        local y = d.AbsolutePosition.Y
        local p = d.Parent
        while p do
            local scale = p:FindFirstChild("MainScale")
            if scale and scale:IsA("UIScale") then
                return y / math.max(scale.Scale, 0.05)
            end
            p = p.Parent
        end
        return y
    end

    function TypeFX.Collect(root)
        local list = {}
        if not root then return list end
        for _, d in ipairs(root:GetDescendants()) do
            local textObject = d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")
            if textObject and d.Text ~= "" and d.MaxVisibleGraphemes == -1
                and d.Name ~= "HackerRain" and not d:GetAttribute("NoType") and Shown(d, root) then
                list[#list + 1] = d
            end
        end
        return list
    end

    function TypeFX.Prepare(root)
        if IsReducedMotion() then return {} end
        local list = TypeFX.Collect(root)
        for _, d in ipairs(list) do
            if d.Parent then d.MaxVisibleGraphemes = 0 end
        end
        return list
    end

    -- Empty text inputs still contain visible copy via PlaceholderText. Reveal that copy
    -- progressively too, without changing the input's actual Text value.
    function TypeFX.PreparePlaceholders(root)
        if IsReducedMotion() or not root then return {} end
        local list = {}
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("TextBox") and d.Text == "" and d.PlaceholderText ~= ""
                and not d:GetAttribute("NoType") and Shown(d, root) then
                local original = d.PlaceholderText
                list[#list + 1] = { Object = d, Text = original,
                    Y = d.AbsolutePosition.Y, X = d.AbsolutePosition.X }
                d.PlaceholderText = ""
            end
        end
        table.sort(list, function(a, b)
            if math.abs(a.Y - b.Y) > 7 then return a.Y < b.Y end
            return a.X < b.X
        end)
        return list
    end

    function TypeFX.RunPlaceholders(list, startDelay, spread, perChar)
        if not list or #list == 0 then return end
        if IsReducedMotion() then
            for _, item in ipairs(list) do
                if item.Object and item.Object.Parent then item.Object.PlaceholderText = item.Text end
            end
            return
        end
        local n = #list
        local t0 = os.clock() + (startDelay or 0)
        local items = {}
        for i, item in ipairs(list) do
            local len = utf8.len(item.Text) or #item.Text
            items[i] = { item = item, len = len,
                start = t0 + (n > 1 and ((i - 1) / (n - 1)) * (spread or 0.8) or 0),
                dur = math.clamp(len * (perChar or 0.034), 0.3, 0.85) }
        end
        local conn
        conn = RunService.Heartbeat:Connect(function()
            local now, alive = os.clock(), 0
            for i, state in ipairs(items) do
                if state then
                    local item, box = state.item, state.item.Object
                    if not box or not box.Parent then
                        items[i] = false
                    elseif box.Text ~= "" then
                        box.PlaceholderText = item.Text
                        items[i] = false
                    else
                        alive = alive + 1
                        if now >= state.start then
                            local a = math.clamp((now - state.start) / state.dur, 0, 1)
                            local count = math.floor(a * state.len)
                            local nextByte = utf8.offset(item.Text, count + 1)
                            box.PlaceholderText = count >= state.len and item.Text
                                or (nextByte and string.sub(item.Text, 1, nextByte - 1) or "")
                            if a >= 1 then items[i] = false end
                        end
                    end
                end
            end
            if alive == 0 then conn:Disconnect() end
        end)
    end

    -- Surfaces are made transparent while still hidden, then faded back to their exact
    -- original values once shell mode ends. Background scenery stays untouched.
    function TypeFX.PrepareVisuals(root)
        if IsReducedMotion() or not root then return {} end
        local list = {}
        local chosen = setmetatable({}, { __mode = "k" })
        local function SkipVisual(d)
            local p = d
            while p and p ~= root do
                if p.Name == "LeftBackgroundGroup" or p.Name == "RightBackgroundGroup"
                    or p.Name == "HackerRain" or p:GetAttribute("NoReveal") then
                    return true
                end
                p = p.Parent
            end
            return false
        end
        local function Add(obj, prop, target)
            if #list >= 240 then return end
            local props = chosen[obj]
            if not props then props = {}; chosen[obj] = props end
            if props[prop] then return end
            props[prop] = true
            -- UIStroke is not a GuiObject and has no AbsolutePosition; sort it at its
            -- owning surface so the reveal can include borders without aborting Restore.
            local positionObject = obj:IsA("GuiObject") and obj or obj.Parent
            local position = (positionObject and positionObject:IsA("GuiObject"))
                and positionObject.AbsolutePosition or Vector2.new(0, 0)
            list[#list + 1] = { Object = obj, Property = prop, Target = target,
                Y = position.Y, X = position.X }
            obj[prop] = 1
        end
        local surfaces = 0
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("GuiObject") and d.Visible and Shown(d, root) and not SkipVisual(d) then
                if d:IsA("CanvasGroup") and d.GroupTransparency < 0.995 then
                    Add(d, "GroupTransparency", d.GroupTransparency)
                elseif (d:IsA("Frame") or d:IsA("ScrollingFrame") or d:IsA("TextButton") or d:IsA("ImageButton"))
                    and d.BackgroundTransparency < 0.995 and d:FindFirstChildOfClass("UICorner") then
                    Add(d, "BackgroundTransparency", d.BackgroundTransparency)
                    surfaces = surfaces + 1
                    if surfaces <= 120 then
                        for _, child in ipairs(d:GetChildren()) do
                            if child:IsA("UIStroke") and child.Transparency < 0.995 then
                                Add(child, "Transparency", child.Transparency)
                            end
                        end
                    end
                end
                if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.ImageTransparency < 0.995 then
                    Add(d, "ImageTransparency", d.ImageTransparency)
                end
            end
        end
        table.sort(list, function(a, b)
            if math.abs(a.Y - b.Y) > 7 then return a.Y < b.Y end
            return a.X < b.X
        end)
        return list
    end

    function TypeFX.RunVisuals(list, startDelay, spread)
        if not list or #list == 0 then return end
        if IsReducedMotion() then
            for _, item in ipairs(list) do
                local obj = item.Object
                if obj and obj.Parent then pcall(function() obj[item.Property] = item.Target end) end
            end
            return
        end
        local n = #list
        local span = spread or 0.62
        for i, item in ipairs(list) do
            local obj = item.Object
            if obj and obj.Parent then
                local delay = (startDelay or 0) + (n > 1 and ((i - 1) / (n - 1)) * span or 0)
                local info = TweenInfo.new(0.34, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0, false, delay)
                local ok, tween = pcall(function()
                    return TweenService:Create(obj, info, { [item.Property] = item.Target })
                end)
                if ok and tween then tween:Play() end
            end
        end
    end

    function TypeFX.Run(list, startDelay, spread, perChar)
        if not list or #list == 0 then return end
        if IsReducedMotion() then
            for _, d in ipairs(list) do if d.Parent then d.MaxVisibleGraphemes = -1 end end
            return
        end
        for _, d in ipairs(list) do
            if d.Parent and d.MaxVisibleGraphemes == -1 then d.MaxVisibleGraphemes = 0 end
        end
        table.sort(list, function(a, b)
            local ay, by = RevealY(a), RevealY(b)
            if math.abs(ay - by) > 7 then return ay < by end
            return a.AbsolutePosition.X < b.AbsolutePosition.X
        end)

        -- Use rows, not a tiny delay per individual label: this keeps large UI pages from
        -- starting hundreds of typewriters in the same frame while still finishing quickly.
        local rows, row, rowY = {}, nil, nil
        for _, d in ipairs(list) do
            local y = RevealY(d)
            if not row or not rowY or math.abs(y - rowY) > 9 then
                row = {}
                rows[#rows + 1] = row
                rowY = y
            end
            row[#row + 1] = d
        end
        local rowSpan = spread or 1.55
        local rowStep = rowSpan / math.max(1, #rows - 1)
        local t0 = os.clock() + (startDelay or 0)
        local items = {}
        local index = 0
        for ri, group in ipairs(rows) do
            for ci, d in ipairs(group) do
                index = index + 1
                local len = utf8.len(d.Text) or #d.Text
                local withinRow = math.min(0.045, (ci - 1) * 0.012)
                items[index] = { d = d, start = t0 + (ri - 1) * rowStep + withinRow,
                    dur = math.clamp(len * (perChar or 0.034), 0.32, 1.05), len = len }
            end
        end
        local conn
        conn = RunService.Heartbeat:Connect(function()
            local now, alive = os.clock(), 0
            for i = 1, #items do
                local it = items[i]
                if it then
                    local d = it.d
                    if not d.Parent then
                        items[i] = false
                    else
                        alive = alive + 1
                        if now >= it.start then
                            local a = (now - it.start) / it.dur
                            if a >= 1 then
                                d.MaxVisibleGraphemes = -1
                                items[i] = false
                            else
                                local len = utf8.len(d.Text) or #d.Text
                                d.MaxVisibleGraphemes = math.clamp(math.floor(a * math.max(1, len)), 0, len)
                            end
                        end
                    end
                end
            end
            if alive == 0 then conn:Disconnect() end
        end)
    end
end

local IntroGate = { done = false, queue = {} }
function IntroGate.Open()
    if IntroGate.done then return end
    IntroGate.done = true
    local q = IntroGate.queue
    IntroGate.queue = {}
    for _, run in ipairs(q) do task.defer(run) end
end
local function FireInitialCallback(callback, ...)
    if type(callback) ~= "function" then return end
    local args = table.pack(...)
    local function run()
        local ok, err = pcall(callback, table.unpack(args, 1, args.n))
        if not ok then warn("[ZyronX] default callback error: " .. tostring(err)) end
    end
    -- Default-ON features wait until the intro has finished and the UI is on screen.
    if not IntroGate.done then
        IntroGate.queue[#IntroGate.queue + 1] = run
        return
    end
    task.defer(run)
end

local function GetConfiguredValue(infoData, ...)
    if type(infoData) ~= "table" then return nil end
    for index = 1, select("#", ...) do
        local key = select(index, ...)
        if infoData[key] ~= nil then return infoData[key] end
    end
    return nil
end

local function CopyToClipboard(value)
    local clipboard = setclipboard or toclipboard
    if type(clipboard) ~= "function" then
        return false, "Clipboard unsupported."
    end
    local ok, result = pcall(clipboard, tostring(value or ""))
    if not ok then return false, tostring(result) end
    if result == false then return false, "Clipboard copy was rejected." end
    return true
end

local function BuildSearchIndex(card)
    local parts = {}
    for _, d in ipairs(card:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            if d.Text and d.Text ~= "" then
                parts[#parts+1] = d.Text:lower()
            end
        end
    end
    return table.concat(parts, " ")
end

-- ============================================================
-- BOUNCE — created ONCE per button, replayed (no alloc)
-- ============================================================
local function AddBounce(button, scaleFactor)
    scaleFactor = scaleFactor or 0.96
    local targets = { button }
    local surfaceName = "__DarkGradientSurface_" .. button.Name
    local surface = button.Parent and button.Parent:FindFirstChild(surfaceName)
    if surface then targets[#targets + 1] = surface end

    local upTweens, downTweens = {}, {}
    for _, target in ipairs(targets) do
        local scaleObj = target:FindFirstChild("__BounceScale")
        if not scaleObj then
            scaleObj = Instance.new("UIScale")
            scaleObj.Name = "__BounceScale"
            scaleObj.Scale = 1
            scaleObj.Parent = target
        end
        upTweens[#upTweens + 1] = TweenService:Create(scaleObj, TI.Fast, { Scale = scaleFactor })
        downTweens[#downTweens + 1] = TweenService:Create(scaleObj, TI.Fast, { Scale = 1 })
    end

    local function press(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            for _, tween in ipairs(upTweens) do tween:Play() end
        end
    end
    local function release(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            for _, tween in ipairs(downTweens) do tween:Play() end
        end
    end

    button.InputBegan:Connect(press)
    button.InputEnded:Connect(release)
end

-- ============================================================
-- DRAG — direct position set during drag (NO tween in hot loop)
-- ============================================================
local function MakeDraggable(topbar, object, canDrag)
    topbar.Active = true
    object.Active = true

    local dragging = false
    local activeInput, activeInputType
    local dragStart, startPos
    local changedConn, endedConn

    local function StopDragging()
        dragging = false
        activeInput = nil
        activeInputType = nil
        if changedConn then changedConn:Disconnect(); changedConn = nil end
        if endedConn then endedConn:Disconnect(); endedConn = nil end
    end

    local function MoveTo(position)
        if not dragging or not object or not object.Parent then return end
        local delta = (position - dragStart) / ActiveGlobalScale
        object.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end

    topbar.InputBegan:Connect(function(input)
        if activeInput then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        -- Optional gate (Settings > Lock Window). Sphere dragging does not use this.
        if canDrag and not canDrag() then return end

        activeInput = input
        activeInputType = input.UserInputType
        dragStart = input.Position
        startPos = object.Position
        dragging = true

        if activeInputType == Enum.UserInputType.Touch then
            changedConn = UserInputService.TouchMoved:Connect(function(touch)
                if touch == activeInput then MoveTo(touch.Position) end
            end)
            endedConn = UserInputService.TouchEnded:Connect(function(touch)
                if touch == activeInput then StopDragging() end
            end)
        else
            changedConn = UserInputService.InputChanged:Connect(function(changed)
                if activeInput and changed.UserInputType == Enum.UserInputType.MouseMovement then
                    MoveTo(changed.Position)
                end
            end)
            endedConn = UserInputService.InputEnded:Connect(function(ended)
                if ended.UserInputType == Enum.UserInputType.MouseButton1 then StopDragging() end
            end)
        end
    end)

    topbar.Destroying:Connect(StopDragging)
    object.Destroying:Connect(StopDragging)
end
local function MeasureTextWidth(text, font, size)
    if not text or text == "" then return 0 end
    local ok, result = pcall(TextService.GetTextSize, TextService,
        text, size or 12, font or Enum.Font.GothamBold, Vector2.new(math.huge, 40))
    if ok and result then return result.X end
    return #text * ((size or 12) * 0.6)
end
local function MeasureTitleWidth(titleText)
    if not titleText or titleText == "" then return 0 end
    local ok, size = pcall(TextService.GetTextSize, TextService,
        titleText, 12, Enum.Font.GothamBold, Vector2.new(math.huge, 20))
    if ok and size then return size.X end
    return #titleText * 7
end

