    local function ScrollPageButtonIntoView(page)
        local nav = page and page.Nav
        local button = page and page.Btn
        if not nav or not button or not nav:IsA("ScrollingFrame") then return end
        local viewWidth = nav.AbsoluteWindowSize.X
        local contentWidth = math.max(nav.CanvasSize.X.Offset, nav.AbsoluteCanvasSize.X)
        local left = button.AbsolutePosition.X - nav.AbsolutePosition.X + nav.CanvasPosition.X
        local right = left + button.AbsoluteSize.X
        local targetX = nav.CanvasPosition.X
        if left < targetX then targetX = left
        elseif right > targetX + viewWidth then targetX = right - viewWidth end
        targetX = math.clamp(targetX, 0, math.max(0, contentWidth - viewWidth))
        nav.CanvasPosition = Vector2.new(targetX, 0)
    end

    -- Page reveal (cinematic v2): every card is hidden behind a cover that wipes away top -> bottom with a
    -- glowing scan edge, while the card springs up from 88%, its outline flares, and its text is typed in.
    RS.RevealPage = function(page)
        pcall(function()
            local scroll = page and page.Scroll
            if not scroll then return end
            local now = os.clock()
            if page._revealAt and now - page._revealAt < 0.35 then return end
            page._revealAt = now
            local TypeFX = Library._TypeFX
            local rise = TweenInfo.new(0.85, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            local wipe = TweenInfo.new(0.62, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
            local ACC = AccentColor
            local n = 0
            for _, d in ipairs(scroll:GetDescendants()) do
                if d:IsA("Frame") and d.Parent ~= scroll and d:FindFirstChild("SectionTitleBar") then
                    n = n + 1
                    if n > 24 then break end
                    local delayT = math.min((n - 1) * 0.075, 0.6)
                    local sc = Create("UIScale", { Name = "ZXReveal", Parent = d, Scale = 0.88 })
                    local cover = Create("Frame", { Name = "ZXRevealCover", Parent = d, BackgroundColor3 = BackgroundColor, BorderSizePixel = 0,
                        AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 1, 0), ZIndex = 80, Active = false })
                    Create("UICorner", { Parent = cover, CornerRadius = UDim.new(0, 9) })
                    local glow = Create("Frame", { Name = "ZXRevealGlow", Parent = d, BackgroundColor3 = ACC, BorderSizePixel = 0, BackgroundTransparency = 1,
                        AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 0, 26), Size = UDim2.new(1, 0, 0, 26), ZIndex = 81, Active = false })
                    Create("UIGradient", { Parent = glow, Rotation = 90, Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.25) }) })
                    local edge = Create("Frame", { Name = "ZXRevealEdge", Parent = d, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, BackgroundTransparency = 1,
                        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 0, 2), ZIndex = 82, Active = false })
                    Create("UIGradient", { Parent = edge, Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.25), NumberSequenceKeypoint.new(0.5, 0),
                        NumberSequenceKeypoint.new(0.8, 0.25), NumberSequenceKeypoint.new(1, 1) }) })
                    -- outline flare (originals are remembered once so overlapping reveals can never leave a tinted stroke behind)
                    local st = d:FindFirstChildOfClass("UIStroke")
                    if st and st:GetAttribute("ZXOrigTh") == nil then
                        st:SetAttribute("ZXOrigTh", st.Thickness); st:SetAttribute("ZXOrigTr", st.Transparency); st:SetAttribute("ZXOrigCol", st.Color)
                    end
                    -- text: hidden now, written in by the typewriter while the cover lifts
                    local list = TypeFX.Prepare(d)
                    TypeFX.Run(list, delayT + 0.2, 0.5, 0.02)
                    task.delay(delayT + 2.0, function()
                        for _, t in ipairs(list) do if t.Parent and t.MaxVisibleGraphemes == 0 then t.MaxVisibleGraphemes = -1 end end
                    end)
                    task.delay(delayT, function()
                        if not cover.Parent then return end
                        Tween(sc, { Scale = 1 }, rise)
                        Tween(cover, { Size = UDim2.new(1, 0, 0, 0) }, wipe)
                        edge.BackgroundTransparency = 0
                        Tween(edge, { Position = UDim2.new(0, 0, 1, 0) }, wipe)
                        glow.BackgroundTransparency = 0.5
                        Tween(glow, { Position = UDim2.new(0, 0, 1, 0) }, wipe)
                        if st and st.Parent and st:GetAttribute("ZXOrigTh") then
                            st.Color = ACC; st.Thickness = st:GetAttribute("ZXOrigTh") + 1.6; st.Transparency = 0
                            Tween(st, { Color = st:GetAttribute("ZXOrigCol"), Thickness = st:GetAttribute("ZXOrigTh"),
                                Transparency = st:GetAttribute("ZXOrigTr") }, TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.Out))
                        end
                        task.delay(0.55, function()
                            if edge.Parent then Tween(edge, { BackgroundTransparency = 1 }, TweenInfo.new(0.15)) end
                            if glow.Parent then Tween(glow, { BackgroundTransparency = 1 }, TweenInfo.new(0.2)) end
                        end)
                        task.delay(1.0, function()
                            for _, o in ipairs({ cover, edge, glow, sc }) do if o and o.Parent then o:Destroy() end end
                        end)
                    end)
                end
            end
        end)
    end

    ActivatePage = function(tab, page)
        if not tab or not page then return false end
        if Window.CurrentTab ~= tab then
            return ActivateTab(tab, page, true)
        end
        if tab.CurrentPage ~= page then
            if tab.CurrentPage then
                Tween(tab.CurrentPage.Btn, { TextColor3 = SubTextColor }, TI.Fast)
                Tween(tab.CurrentPage.Highlight, { Size = UDim2.new(0, 0, 0, 2), BackgroundTransparency = 1 }, TI.Fast)
                if tab.CurrentPage.SetSelected then tab.CurrentPage.SetSelected(false) end
                tab.CurrentPage.Scroll.Visible = false
            end
            tab.CurrentPage = page
            page.Scroll.Visible = true
            page.Scroll.Position = UDim2.new(0, 5, 0, 20)
            Tween(page.Scroll, { Position = UDim2.new(0, 5, 0, 5) }, TI.Slow)
            Tween(page.Btn, { TextColor3 = TextColor }, TI.Fast)
            Tween(page.Highlight, { Size = UDim2.new(0.5, 0, 0, 2), BackgroundTransparency = 0 }, TI.Fast)
            if page.SetSelected then page.SetSelected(true) end
            RS.RevealPage(page)
        else
            page.Scroll.Visible = true
            if page.SetSelected then page.SetSelected(true) end
            RS.RevealPage(page)
        end
        ScrollPageButtonIntoView(page)
        selectedQuickPage = page
        if RefreshQuickPages then RefreshQuickPages(false) end
        RefreshGlobalSearch()
        if CloseQuickPagesPanel then CloseQuickPagesPanel() end
        return true
    end

    ActivateTab = function(tab, targetPage, fromQuickPages)
        if not tab then return false end
        if tab.IsLocked and not tab.IsWhitelisted then
            Library:Notify({ Title = "Access Denied", Desc = "You Are not Whitelisted to Unlock this tabs.", Be = "Error" })
            return false
        end
        if Window.CurrentTab == tab then
            if targetPage then return ActivatePage(tab, targetPage) end
            return true
        end
        if RS.HideHome then RS.HideHome() end
        if Window.CurrentTab then
            Tween(Window.CurrentTab.Button, { BackgroundTransparency = 1 }, TI.Linear)
            Tween(Window.CurrentTab.Indicator, { Size = UDim2.new(0, 3, 0, 0) }, TI.Linear)
            Tween(Window.CurrentTab.Txt, { TextColor3 = SubTextColor }, TI.Linear)
            Window.CurrentTab.Content.Visible = false
        end
        Window.CurrentTab = tab
        tab.Content.Visible = true
        tab.Content.Position = UDim2.new(0, 0, 0, 15)
        Tween(tab.Content, { Position = UDim2.new(0, 0, 0, 0) }, TI.Slow)
        Tween(tab.Button, { BackgroundTransparency = TAB_SELECTED_TRANSPARENCY }, TI.Linear)
        Tween(tab.Indicator, { Size = UDim2.new(0, 3, 0, 18) }, TI.Slow)
        Tween(tab.Txt, { TextColor3 = TextColor }, TI.Linear)

        local pageToShow = targetPage or tab.CurrentPage or tab.Pages[1]
        if pageToShow then
            ActivatePage(tab, pageToShow)
        else
            tab.CurrentPage = nil
            selectedQuickPage = nil
            for _, page in ipairs(tab.Pages) do page.Scroll.Visible = false end
            if RefreshQuickPages then RefreshQuickPages(false) end
        end
        RefreshGlobalSearch()
        if CloseQuickPagesPanel then CloseQuickPagesPanel() end
        return true
    end

