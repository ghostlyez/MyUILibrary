                    for b = 1, nodeCount do
                        if b ~= a then order[#order + 1] = { b, (pts[a].x - pts[b].x) ^ 2 + (pts[a].y - pts[b].y) ^ 2 } end
                    end
                    table.sort(order, function(u, v) return u[2] < v[2] end)
                    for k = 1, 2 do
                        local b = order[k] and order[k][1]
                        if b then
                            local key = math.min(a, b) .. "_" .. math.max(a, b)
                            if not seen[key] then seen[key] = true; edges[#edges + 1] = { a, b } end
                        end
                    end
                end
                for _, e in ipairs(edges) do
