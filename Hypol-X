        local function IsPurple(c)
            local h, s, v = c:ToHSV()
            return s > 0.2 and v > 0.25 and h >= 0.68 and h <= 0.82
        end
        local function SeqHasPurple(seq)
            for _, kp in ipairs(seq.Keypoints) do if IsPurple(kp.Value) then return true end end
            return false
        end
        local function RemapColor(c, th)
            if th.IsDefault then return c end
            local _, s, v = c:ToHSV()
            return Color3.fromHSV(th.Hue % 1, math.clamp(s * th.SatMul, 0, 1), v)
        end
        local function RemapSeq(seq, th)
            local kps = {}
            for i, kp in ipairs(seq.Keypoints) do
                kps[i] = ColorSequenceKeypoint.new(kp.Time, IsPurple(kp.Value) and RemapColor(kp.Value, th) or kp.Value)
            end
            return ColorSequence.new(kps)
        end
        local function Reg(inst, prop, kind)
            local value = inst[prop]
            if kind == "seq" then
                if not SeqHasPurple(value) then return end
            elseif not IsPurple(value) then return end
            RemapList[#RemapList + 1] = { Inst = inst, Prop = prop, Kind = kind, Orig = value }
        end
        local function ScanInstance(inst)
            if RemapSeen[inst] or NoRemap[inst] or inst:GetAttribute("ZXNoTheme") then return end
            RemapSeen[inst] = true
            if inst:IsA("UIGradient") then
                Reg(inst, "Color", "seq")
            elseif inst:IsA("UIStroke") then
                Reg(inst, "Color", "color")
            elseif inst:IsA("GuiObject") then
                Reg(inst, "BackgroundColor3", "color")
                if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then Reg(inst, "TextColor3", "color") end
                if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then Reg(inst, "ImageColor3", "color") end
                if inst:IsA("ScrollingFrame") then Reg(inst, "ScrollBarImageColor3", "color") end
            end
        end
        local function ApplyEntry(e, th)
            if not e.Inst or not e.Inst.Parent then return end
            if e.Kind == "seq" then
