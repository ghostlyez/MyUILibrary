        -- Anchor the dropdown directly beneath the Config button (right-aligned, caret under the button).
        local function Place()
            local ratio = MainFrame.AbsoluteSize.X / math.max(MainFrame.Size.X.Offset, 1)
            if ratio <= 0 then ratio = 1 end
            local bx = (CfgBtn.AbsolutePosition.X - MainFrame.AbsolutePosition.X) / ratio
            local bw = CfgBtn.AbsoluteSize.X / ratio
            local by = (CfgBtn.AbsolutePosition.Y - MainFrame.AbsolutePosition.Y) / ratio + CfgBtn.AbsoluteSize.Y / ratio
            local mainW = MainFrame.AbsoluteSize.X / ratio
            local right = math.clamp(bx + bw / 2 + MW / 2, MW + 8, mainW - 8)
            local top = by + 8
            Wrap.Position = UDim2.new(0, right, 0, top)
            Pin.Position = UDim2.new(0, math.clamp(bx + bw / 2, right - MW + 14, right - 14), 0, top)
        end
        ScaleHooks[#ScaleHooks + 1] = function() pcall(Reposition); if menuOpen then pcall(Place) end end
