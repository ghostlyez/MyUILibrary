                    local CompareStroke = Create("UIStroke",{Parent=Compare,Color=Color3.new(1,1,1),Transparency=0.82,Thickness=1})

                    -- Hex input + copy
                    local HexRow = Create("Frame",{Parent=PickerArea,BackgroundTransparency=1,
                        Size=UDim2.new(1,-20,0,28),Position=UDim2.new(0,10,0,190)})
                    local HexBox = Create("TextBox",{Parent=HexRow,Text="#"..color:ToHex():upper(),PlaceholderText="#RRGGBB",
                        Font=Enum.Font.Code,TextSize=12,TextColor3=INPUT_TEXT,BackgroundColor3=INPUT_BG,
                        Size=UDim2.new(1,-80,1,0),TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false})
                    Create("UIPadding",{Parent=HexBox,PaddingLeft=UDim.new(0,10),PaddingRight=UDim.new(0,8)})
                    Create("UICorner",{Parent=HexBox,CornerRadius=UDim.new(0,8)})
                    local HexBoxStroke = Create("UIStroke",{Parent=HexBox,Color=INPUT_STROKE,Thickness=1})
                    StyleCleanInput(HexBox, HexBoxStroke)
                    HexBox.Font = Enum.Font.Code

                    local CopyHolder = Create("Frame",{Parent=HexRow,BackgroundTransparency=1,Size=UDim2.new(0,72,1,0),
                        AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,0,0,0)})
                    local CopyCodeBtn = Create("TextButton",{Name="CopyBtn",Parent=CopyHolder,Text="Copy",Font=Enum.Font.GothamBold,
                        TextSize=11,TextScaled=false,TextColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=1,
                        Size=UDim2.new(1,0,1,0),AutoButtonColor=false,ZIndex=3})
                    local CopySurface = Create("Frame",{Name="__DarkGradientSurface_CopyBtn",Parent=CopyHolder,BorderSizePixel=0,
                        BackgroundColor3=Color3.new(1,1,1),Size=UDim2.new(1,0,1,0),Active=false,ZIndex=2})
                    Create("UICorner",{Parent=CopySurface,CornerRadius=UDim.new(0,8)})
                    Create("UIGradient",{Parent=CopySurface,Rotation=100,Color=ColorSequence.new(
                        Color3.fromRGB(150,104,235),Color3.fromRGB(104,66,200))})
                    AddBounce(CopyCodeBtn)
                    local copyCodeFeedbackGeneration = 0
                    CopyCodeBtn.MouseButton1Click:Connect(function()
                        PlayUISound(UI_SOUND_IDS.Control)
                        local copied, copyError = CopyToClipboard("#" .. color:ToHex():upper())
                        if not copied then warn(copyError or "Clipboard copy failed."); return end
                        copyCodeFeedbackGeneration = copyCodeFeedbackGeneration + 1
                        local generation = copyCodeFeedbackGeneration
                        CopyCodeBtn.Text = "Copied!"
                        task.delay(1.5, function()
                            if CopyCodeBtn.Parent and copyCodeFeedbackGeneration == generation then CopyCodeBtn.Text = "Copy" end
                        end)
                    end)

                    -- R / G / B chips
                    local rgbValues = {}
                    do
                        local letters = { "R", "G", "B" }
                        local tints = { Color3.fromRGB(255,98,116), Color3.fromRGB(104,226,142), Color3.fromRGB(96,166,255) }
                        for i = 1, 3 do
                            local chip = Create("Frame",{Parent=PickerArea,BackgroundColor3=FIELD_BG,BorderSizePixel=0,
                                Size=UDim2.new(1/3,-4,0,24),Position=UDim2.new((i-1)/3,(i-1)*2,0,226)})
                            Create("UICorner",{Parent=chip,CornerRadius=UDim.new(0,7)})
                            Create("UIStroke",{Parent=chip,Color=FIELD_STROKE,Thickness=1})
                            Create("TextLabel",{Parent=chip,Text=letters[i],Font=Enum.Font.GothamBlack,TextSize=10,TextScaled=false,
                                TextColor3=tints[i],BackgroundTransparency=1,Size=UDim2.new(0,18,1,0),Position=UDim2.new(0,6,0,0),
                                TextXAlignment=Enum.TextXAlignment.Left})
                            rgbValues[i] = Create("TextLabel",{Parent=chip,Text="0",Font=Enum.Font.Code,TextSize=11,TextScaled=false,
                                TextColor3=TextColor,BackgroundTransparency=1,Size=UDim2.new(1,-30,1,0),Position=UDim2.new(0,24,0,0),
                                TextXAlignment=Enum.TextXAlignment.Right})
                        end
                    end

                    -- Quick palette
                    local PaletteHexes = {"FF5C7A","FF9F5A","FFD25A","6BE08A","4FD6D0","5AA2FF","B78BFF","FFFFFF","1E1E24"}
                    local PaletteRow = Create("Frame",{Parent=PickerArea,BackgroundTransparency=1,
                        Size=UDim2.new(1,-20,0,18),Position=UDim2.new(0,10,0,254)})
                    Create("UIListLayout",{Parent=PaletteRow,FillDirection=Enum.FillDirection.Horizontal,
                        SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,6),VerticalAlignment=Enum.VerticalAlignment.Center})
                    local paletteButtons = {}

                    local function SyncPickerVisuals()
                        local hex = "#" .. color:ToHex():upper()
                        DisplayBtn.BackgroundColor3 = color
                        SVCursor.BackgroundColor3 = color
                        HueThumb.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                        HexLabel.Text = hex
                        LiveHex.Text = hex
                        NewHalf.BackgroundColor3 = color
                        NewHalf.TextColor3 = Contrast(color)
                        if not HexBox:IsFocused() then HexBox.Text = hex end
                        rgbValues[1].Text = tostring(math.floor(color.R*255+0.5))
                        rgbValues[2].Text = tostring(math.floor(color.G*255+0.5))
                        rgbValues[3].Text = tostring(math.floor(color.B*255+0.5))
                    end

                    local function internalSet(hex)
                        local ok, c = pcall(function() return Color3.fromHex(hex) end)
                        if ok and c then
                            color = c
                            h, s, v_hsv = color:ToHSV()
                            SVMap.BackgroundColor3 = Color3.fromHSV(h,1,1)
                            SVCursor.Position = UDim2.new(s,0,1-v_hsv,0)
                            HueThumb.Position = UDim2.new(h,0,0.5,0)
                            SyncPickerVisuals()
                            if callback then callback(color) end
                        end
                    end

                    for index, hex in ipairs(PaletteHexes) do
                        local swatch = Create("TextButton",{Parent=PaletteRow,Text="",LayoutOrder=index,
                            BackgroundColor3=Color3.fromHex(hex),Size=UDim2.new(0,16,0,16),AutoButtonColor=false})
                        Create("UICorner",{Parent=swatch,CornerRadius=UDim.new(1,0)})
                        local swatchStroke = Create("UIStroke",{Parent=swatch,Color=Color3.new(1,1,1),Thickness=1.5,Transparency=0.82})
                        swatch.MouseEnter:Connect(function() Tween(swatchStroke,{Transparency=0.05},TI.Fast) end)
                        swatch.MouseLeave:Connect(function() Tween(swatchStroke,{Transparency=0.82},TI.Fast) end)
                        AddBounce(swatch, 0.85)
                        swatch.MouseButton1Click:Connect(function()
                            PlayUISound(UI_SOUND_IDS.Control)
                            internalSet(hex)
                        end)
                        paletteButtons[index] = swatch
                    end

                    OldHalf.MouseButton1Click:Connect(function()
                        PlayUISound(UI_SOUND_IDS.Control)
                        internalSet(startColor:ToHex())
                    end)
                    HexBox.FocusLost:Connect(function()
                        local t = (HexBox.Text:gsub("[#%s]", ""))
                        if #t == 6 and t:match("^%x+$") then
                            internalSet(t)
                        else
                            HexBox.Text = "#" .. color:ToHex():upper()
                        end
                    end)

                    local function UpdateColor()
                        color = Color3.fromHSV(h, s, v_hsv)
                        SVMap.BackgroundColor3 = Color3.fromHSV(h,1,1)
                        SyncPickerVisuals()
                        if callback then callback(color) end
                    end

                    -- One initiating input owns the whole drag (mirrors slider ownership); page scrolling is
                    -- always restored when the drag ends or focus is lost.
                    local activeColorInput, activeColorInputType, colorDragMode
                    local colorDragConn, colorEndConn, colorTouchEndedConn, colorFocusLostConn
                    local previousPageScrollingEnabled

                    StopColorDrag = function(expectedInput)
                        if expectedInput and activeColorInput and expectedInput ~= activeColorInput then return end
                        if not activeColorInput and not colorDragConn and not colorEndConn
                        and not colorTouchEndedConn and not colorFocusLostConn then return end

                        activeColorInput = nil
                        activeColorInputType = nil
                        colorDragMode = nil
                        if ActiveControlDragOwner == CFrame then ActiveControlDragOwner = nil end

                        if colorDragConn then colorDragConn:Disconnect(); colorDragConn = nil end
                        if colorEndConn then colorEndConn:Disconnect(); colorEndConn = nil end
                        if colorTouchEndedConn then colorTouchEndedConn:Disconnect(); colorTouchEndedConn = nil end
                        if colorFocusLostConn then colorFocusLostConn:Disconnect(); colorFocusLostConn = nil end

                        if PageObj and PageObj.Scroll and previousPageScrollingEnabled ~= nil then
                            PageObj.Scroll.ScrollingEnabled = previousPageScrollingEnabled
                        end
                        previousPageScrollingEnabled = nil
                        local settle = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                        Tween(SVScale, { Scale = 1 }, settle)
                        Tween(HueScale, { Scale = 1 }, settle)
                    end

                    local function ApplyColorDrag(position)
                        if colorDragMode == "SV" then
                            local mapSize = SVMap.AbsoluteSize
                            if mapSize.X <= 0 or mapSize.Y <= 0 then return end
                            local rx = math.clamp((position.X - SVMap.AbsolutePosition.X) / mapSize.X, 0, 1)
                            local ry = math.clamp((position.Y - SVMap.AbsolutePosition.Y) / mapSize.Y, 0, 1)
                            s, v_hsv = rx, 1 - ry
                            SVCursor.Position = UDim2.new(s, 0, 1 - v_hsv, 0)
                        elseif colorDragMode == "Hue" then
                            local sliderWidth = HueSlider.AbsoluteSize.X
                            if sliderWidth <= 0 then return end
                            h = math.clamp((position.X - HueSlider.AbsolutePosition.X) / sliderWidth, 0, 1)
                            HueThumb.Position = UDim2.new(h, 0, 0.5, 0)
                        else
                            return
                        end
                        UpdateColor()
                    end

                    local function BeginColorDrag(input, mode)
                        if input.UserInputType ~= Enum.UserInputType.MouseButton1
                        and input.UserInputType ~= Enum.UserInputType.Touch then return end
                        if activeColorInput or ActiveControlDragOwner then return end

                        activeColorInput = input
                        activeColorInputType = input.UserInputType
                        colorDragMode = mode
                        ActiveControlDragOwner = CFrame
                        if PageObj and PageObj.Scroll then
                            previousPageScrollingEnabled = PageObj.Scroll.ScrollingEnabled
                            PageObj.Scroll.ScrollingEnabled = false
                        else
                            previousPageScrollingEnabled = nil
                        end
                        Tween(mode == "SV" and SVScale or HueScale, { Scale = 1.3 }, TI.Fast)
                        ApplyColorDrag(input.Position)

                        colorFocusLostConn = UserInputService.WindowFocusReleased:Connect(function()
                            StopColorDrag()
                        end)

                        if activeColorInputType == Enum.UserInputType.Touch then
                            colorDragConn = UserInputService.TouchMoved:Connect(function(touch)
                                if activeColorInput and ActiveControlDragOwner == CFrame and touch == activeColorInput then
                                    ApplyColorDrag(touch.Position)
                                end
                            end)
                            colorTouchEndedConn = UserInputService.TouchEnded:Connect(function(touch)
                                if activeColorInput and touch == activeColorInput then StopColorDrag(touch) end
                            end)
                            colorEndConn = UserInputService.InputEnded:Connect(function(endedInput)
                                if activeColorInput and endedInput == activeColorInput then StopColorDrag(endedInput) end
                            end)
                        else
                            colorDragConn = UserInputService.InputChanged:Connect(function(changedInput)
                                if activeColorInput and activeColorInputType == Enum.UserInputType.MouseButton1
                                and ActiveControlDragOwner == CFrame
                                and changedInput.UserInputType == Enum.UserInputType.MouseMovement then
                                    ApplyColorDrag(changedInput.Position)
                                end
                            end)
                            colorEndConn = UserInputService.InputEnded:Connect(function(endedInput)
                                if not activeColorInput then return end
                                if endedInput == activeColorInput
                                or (activeColorInputType == Enum.UserInputType.MouseButton1
                                    and endedInput.UserInputType == Enum.UserInputType.MouseButton1) then
                                    StopColorDrag(endedInput == activeColorInput and endedInput or nil)
                                end
                            end)
                        end
                    end

                    SVMap.InputBegan:Connect(function(input) BeginColorDrag(input, "SV") end)
                    HueSlider.InputBegan:Connect(function(input) BeginColorDrag(input, "Hue") end)
                    CFrame.Destroying:Connect(function() StopColorDrag() end)

                    -- Open/close: swatch + hex fade out, the body rises in and the cursors spring into place.
                    local pickerToken = 0
                    SetPickerOpen = function(open)
                        if open == dropped then return end
                        dropped = open
                        pickerToken = pickerToken + 1
                        local token = pickerToken
                        if not open then StopColorDrag() end
                        DisplayBtn.Active = not open
                        if open then
                            PickerBody.Visible = true
                            PickerBody.Position = UDim2.new(0, 0, 0, 14)
                            SVScale.Scale = 0
                            HueScale.Scale = 0
                            Tween(CFrame, {Size=UDim2.new(1,0,0,PICKER_OPEN_HEIGHT)},
                                TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
                            local fadeOut = TweenInfo.new(0.22, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                            Tween(DisplayBtn, {BackgroundTransparency=1}, fadeOut)
                            Tween(DisplayStroke, {Transparency=1}, fadeOut)
                            Tween(HexLabel, {TextTransparency=1}, fadeOut)
                            Tween(PickerBody, {GroupTransparency=0},
                                TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, false, 0.08))
                            Tween(PickerBody, {Position=UDim2.new(0,0,0,0)},
                                TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.05))
                            local spring = TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.3)
                            Tween(SVScale, {Scale=1}, spring)
                            Tween(HueScale, {Scale=1}, spring)
                        else
                            Tween(PickerBody, {GroupTransparency=1},
                                TweenInfo.new(0.22, Enum.EasingStyle.Sine, Enum.EasingDirection.In))
                            Tween(CFrame, {Size=UDim2.new(1,0,0,30)},
                                TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut))
                            local fadeIn = TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, false, 0.2)
                            Tween(DisplayBtn, {BackgroundTransparency=0}, fadeIn)
                            Tween(DisplayStroke, {Transparency=0.55}, fadeIn)
                            Tween(HexLabel, {TextTransparency=0}, fadeIn)
                            task.delay(0.47, function()
                                if token == pickerToken and not dropped then PickerBody.Visible = false end
                            end)
                        end
                    end
                    DisplayBtn.MouseButton1Click:Connect(function()
                        if Window._isMinimized then return end
                        PlayUISound(UI_SOUND_IDS.Control)
                        SetPickerOpen(true)
                    end)

                    SyncPickerVisuals()
                    do
                        local tw = MeasureTitleWidth(name)
                        AddInfoIcon(CFrame, UDim2.new(0, 10+tw+5, 0, 7), infoData)
                    end
                    Window.ConfigElements[name] = {
                        Set=internalSet,
                        Get=function() return color:ToHex() end,
                        Default=(defaultColor or Color3.fromRGB(255,255,255)):ToHex()
                    }
                end

                -- ------------------------------------------------------------
                -- Indicator
                -- ------------------------------------------------------------
                function Elements:AddIndicator(name, defaultEnabled, valueProvider, infoData)
                    local enabled = defaultEnabled or false
                    local indicatorFrame = Create("Frame",{Parent=ItemContainer,BackgroundTransparency=1,Size=UDim2.new(1,0,0,24)})
                    Create("TextLabel",{Parent=indicatorFrame,Text=name,Font=Enum.Font.GothamBold,TextSize=12,
                        TextColor3=SubTextColor,BackgroundTransparency=1,Size=UDim2.new(1,-115,1,0),
                        Position=UDim2.new(0,10,0,0),TextXAlignment=Enum.TextXAlignment.Left})
                    local ValueLabel = Create("TextLabel",{Parent=indicatorFrame,Text="0",Font=Enum.Font.GothamBold,
                        TextSize=12,TextColor3=AccentColor,BackgroundTransparency=1,Size=UDim2.new(0,40,0,15),
                        Position=UDim2.new(1,-54,0.5,0),AnchorPoint=Vector2.new(1,0.5),
                        TextXAlignment=Enum.TextXAlignment.Center,TextScaled=true,ClipsDescendants=true})
                    Create("UITextSizeConstraint",{Parent=ValueLabel,MaxTextSize=12,MinTextSize=6})

                    local ToggleButton, SetToggleVisual = CreateSquareToggle(indicatorFrame,
                        UDim2.new(1,-28,0.5,-9), enabled, UDim2.new(0,18,0,18))

                    do
                        local tw = MeasureTitleWidth(name)
                        AddInfoIcon(indicatorFrame, UDim2.new(0, 10+tw+5, 0.5, -8), infoData)
                    end

                    local updateConn, lastTick = nil, 0
                    local function UpdateIndicator()
                        if enabled then
                            local val = valueProvider and valueProvider() or 0
                            ValueLabel.Text = tostring(val)
                        else
                            ValueLabel.Text = "0"
                        end
                    end

                    local function SetEnabled(newState)
                        enabled = newState
                        SetToggleVisual(enabled)
                        if enabled then
                            UpdateIndicator()
                            if not updateConn then
                                lastTick = 0
                                updateConn = RunService.Heartbeat:Connect(function()
                                    if not Window._active then return end
                                    local now = tick()
                                    if now - lastTick >= 0.1 then
                                        lastTick = now
                                        UpdateIndicator()
                                    end
                                end)
                            end
                        else
                            if updateConn then updateConn:Disconnect(); updateConn = nil end
                            ValueLabel.Text = "0"
                        end
                    end

                    ToggleButton.MouseButton1Click:Connect(function() SetEnabled(not enabled) end)
                    SetEnabled(enabled)
                    Window.ConfigElements[name] = { Set=SetEnabled, Get=function() return enabled end, Default=defaultEnabled or false }
                end

                -- ------------------------------------------------------------
                -- HV Indicator Group
                -- ------------------------------------------------------------
                function Elements:AddHVIndicatorGroup(groupTitle, defaultEnabled, infoData)
                    local groupEnabled = defaultEnabled or false
                    local GroupFrame = Create("Frame",{Parent=ItemContainer,BackgroundTransparency=1,
                        Size=UDim2.new(1,0,0,26),AutomaticSize=Enum.AutomaticSize.Y})
                    local Header = Create("Frame",{Parent=GroupFrame,BackgroundTransparency=1,Size=UDim2.new(1,0,0,24)})
                    Create("TextLabel",{Parent=Header,Text=groupTitle,Font=Enum.Font.GothamBold,TextSize=12,
                        TextColor3=SubTextColor,BackgroundTransparency=1,Size=UDim2.new(1,-80,1,0),
                        Position=UDim2.new(0,10,0,0),TextXAlignment=Enum.TextXAlignment.Left})

                    local ToggleButton, SetToggleVisual = CreateSquareToggle(Header,
                        UDim2.new(1,-28,0.5,-9), groupEnabled, UDim2.new(0,18,0,18))

                    do
                        local tw = MeasureTitleWidth(groupTitle)
                        AddInfoIcon(Header, UDim2.new(0, 10+tw+5, 0.5, -8), infoData)
                    end

                    local SubContainer = Create("Frame",{Parent=GroupFrame,BackgroundTransparency=1,
                        Size=UDim2.new(1,0,0,0),Position=UDim2.new(0,0,0,26),AutomaticSize=Enum.AutomaticSize.Y})
                    local SubLayout = Create("UIListLayout",{Parent=SubContainer,SortOrder=Enum.SortOrder.LayoutOrder,
                        Padding=UDim.new(0,4)})
                    Create("UIPadding",{Parent=SubContainer,PaddingLeft=UDim.new(0,10)})

                    SubLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(RS.Guarded(function()
                        GroupFrame.Size = UDim2.new(1,0,0, 26 + SubLayout.AbsoluteContentSize.Y)
                    end))

                    local indicators = {}
                    local isEnabled = groupEnabled
                    local updateConn, lastTick = nil, 0

                    local function UpdateAll()
                        for _, ind in ipairs(indicators) do
                            if isEnabled then
                                ind.label.Text = tostring(ind.provider and ind.provider() or 0)
                            else
                                ind.label.Text = "0"
                            end
                        end
                    end

                    local function SetGroupEnabled(v)
                        isEnabled = v
                        SetToggleVisual(isEnabled)
                        if isEnabled then
                            UpdateAll()
                            if not updateConn then
                                lastTick = 0
                                updateConn = RunService.Heartbeat:Connect(function()
                                    if not Window._active then return end
                                    local now = tick()
                                    if now - lastTick >= 0.1 then
                                        lastTick = now
                                        UpdateAll()
                                    end
                                end)
                            end
                        else
                            if updateConn then updateConn:Disconnect(); updateConn = nil end
                            for _, ind in ipairs(indicators) do ind.label.Text = "0" end
                        end
                    end

                    ToggleButton.MouseButton1Click:Connect(function() SetGroupEnabled(not isEnabled) end)
                    SetGroupEnabled(groupEnabled)

                    local HVGroup = {}
                    function HVGroup:AddIndicator(name, valueProvider, indInfoData)
                        local Row = Create("Frame",{Parent=SubContainer,BackgroundTransparency=1,Size=UDim2.new(1,0,0,20)})
                        Create("TextLabel",{Parent=Row,Text=name,Font=Enum.Font.GothamBold,TextSize=12,
                            TextColor3=SubTextColor,BackgroundTransparency=1,Size=UDim2.new(1,-80,1,0),
                            Position=UDim2.new(0,0,0,0),TextXAlignment=Enum.TextXAlignment.Left})
                        local ValueLabel = Create("TextLabel",{Parent=Row,Text="0",Font=Enum.Font.GothamBold,
                            TextSize=12,TextColor3=AccentColor,BackgroundTransparency=1,
                            Size=UDim2.new(0,40,1,0),Position=UDim2.new(1,-46,0,0),
                            TextXAlignment=Enum.TextXAlignment.Right,TextScaled=true,ClipsDescendants=true})
                        Create("UITextSizeConstraint",{Parent=ValueLabel,MaxTextSize=12,MinTextSize=6})
                        if indInfoData then
                            local tw = MeasureTitleWidth(name)
                            AddInfoIcon(Row, UDim2.new(0, tw+5, 0.5, -8), indInfoData)
                        end
                        local entry = {label=ValueLabel, provider=valueProvider}
                        table.insert(indicators, entry)
                        if isEnabled then
                            ValueLabel.Text = tostring(valueProvider and valueProvider() or 0)
                        end
                        return entry
                    end
                    function HVGroup:SetEnabled(v) SetGroupEnabled(v) end
                    function HVGroup:GetEnabled() return isEnabled end
                    Window.ConfigElements[groupTitle] = { Set=SetGroupEnabled, Get=function() return isEnabled end, Default=defaultEnabled or false }
                    return HVGroup
                end

                -- ------------------------------------------------------------
                -- Config Manager
                -- ------------------------------------------------------------
                function Elements:AddConfigManager(folderName)
                    folderName = folderName or "zyronxSavers"
                    Window._cfgFolder = folderName
                    if not _isfolder(folderName) then _makefolder(folderName) end

                    local CM_PANEL   = Color3.fromRGB(13, 14, 19)
                    local CM_ROW     = Color3.fromRGB(23, 24, 32)
                    local CM_ROW_HOT = Color3.fromRGB(66, 32, 40)
                    local CM_EDGE    = Color3.fromRGB(46, 48, 60)
                    local CM_MUTED   = Color3.fromRGB(128, 130, 148)
                    local CM_LIGHT   = Color3.fromRGB(232, 234, 244)
