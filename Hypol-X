                    TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd})
                Create("UITextSizeConstraint",{Parent=TitleText,MaxTextSize=13,MinTextSize=8})
                local TitleLaser = Create("Frame",{Parent=TitleBar,BackgroundColor3=Color3.fromRGB(230,205,255),BorderSizePixel=0,
                    Active=false,Size=UDim2.new(0,60,0,2),AnchorPoint=Vector2.new(0,1),Position=UDim2.new(0,-60,1,0),
                    BackgroundTransparency=1,ZIndex=4})
                Create("UIGradient",{Parent=TitleLaser,Transparency=NumberSequence.new({
                    NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.5,0),NumberSequenceKeypoint.new(1,1)})})
                local MinBtn = Create("TextButton",{Name="CardMinimize",Parent=TitleBar,Text="",AutoButtonColor=false,
                    BackgroundColor3=Color3.fromRGB(18,16,28),BackgroundTransparency=0.15,Size=UDim2.new(0,22,0,16),
                    AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-5,0.5,0),ZIndex=3})
                Create("UICorner",{Parent=MinBtn,CornerRadius=UDim.new(0,5)})
                Create("UIStroke",{Parent=MinBtn,Color=Color3.fromRGB(110,92,170),Thickness=1,Transparency=0.45})
                local MinChevron = CreateChevron(MinBtn, Color3.fromRGB(226,214,255), 4, 8)
                MinChevron.Rotation = 180
                AddBounce(MinBtn, 0.88)
                MinBtn.MouseEnter:Connect(function() Tween(MinBtn,{BackgroundColor3=LiveTheme.Map(Color3.fromRGB(96,66,176))},TI.Fast) end)
                MinBtn.MouseLeave:Connect(function() Tween(MinBtn,{BackgroundColor3=Color3.fromRGB(18,16,28)},TI.Fast) end)

                local SectionContainer = Create("Frame",{Name="CardContainer",Parent=SectionGroup,BackgroundColor3=CardColor,
