local function PreloadAssets(list, onProgress)
    local valid, seen = {}, {}
    for _, a in ipairs(list or {}) do
        if type(a) == "string" and a ~= "" and not seen[a] then
            seen[a] = true
            valid[#valid + 1] = a
        end
    end
    if #valid == 0 then return true, 0, 0, 0, nil end

    local completed, failed = 0, 0
    local ok, err = pcall(function()
        ContentProvider:PreloadAsync(valid, function(assetId, status)
            completed = completed + 1
            if status ~= Enum.AssetFetchStatus.Success then
                failed = failed + 1
            end
            if onProgress then
                pcall(onProgress, completed, #valid, failed, assetId, status)
            end
        end)
    end)
    return ok, completed, #valid, failed, err
end
-- Static assets are preloaded asynchronously after the loading intro is visible.
-- This keeps require() non-blocking and still completes before the main UI is revealed.

local function GetDensityFactor(px, plat)
    if plat == Enum.Platform.Android or plat == Enum.Platform.IOS then
        if px >= 2400 then return 3.5
        elseif px >= 1800 then return 3.0
        elseif px >= 1200 then return 2.5
        elseif px >= 800 then return 2.0
        else return 1.5 end
    elseif plat == Enum.Platform.Windows or plat == Enum.Platform.OSX or plat == Enum.Platform.Linux then
        return 1.0
    elseif plat == Enum.Platform.XboxOne or plat == Enum.Platform.PS4 or plat == Enum.Platform.PS5 then
        return 1.5
    end
    return 1.0
end

local function EstimateDeviceDP()
    local cam = workspace.CurrentCamera or workspace:FindFirstChildOfClass("Camera")
    local px = 1280
    if cam and cam.ViewportSize and cam.ViewportSize.X > 0 then px = cam.ViewportSize.X end
    return px / GetDensityFactor(px, UserInputService:GetPlatform())
end

local function ComputeUIScale()
    local dp = EstimateDeviceDP()
    if not dp or dp <= 0 then dp = REFERENCE_DP_WIDTH end
    return math.clamp(dp / REFERENCE_DP_WIDTH, 0.35, 4.0)
end

