            function PageObj:CreateSection(sectionName)
                local target = PageObj.Left and LeftColumn or RightColumn
                PageObj.Left = not PageObj.Left

                -- A transparent group keeps the external title and card together for search/reflow.
                local SectionGroup = Create("Frame",{Parent=target,BackgroundTransparency=1,BorderSizePixel=0,
                    Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,ClipsDescendants=false})
