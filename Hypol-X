    -- ============================================================
    do
        local function Jit(c, dx, dy) return UDim2.new(c.X.Scale, c.X.Offset + dx, c.Y.Scale, c.Y.Offset + dy) end
        local function Fx(props) props.Parent = Host; props.Active = false; props.BorderSizePixel = 0; return Create("Frame", props) end

        function M.Minimize()
            if Window._isMinimized or RS.Anim then return end
            RS.Anim = true
            PlayUISound(UI_SOUND_IDS.Navigation)
            if M.CloseSettings then M.CloseSettings() end
            if RS.CloseConfigMenu then pcall(RS.CloseConfigMenu, true) end
            Window._isMinimized = true
            Window._active = false
            M.Id = M.Id + 1
            SetLoops(false)
            BottomDragHitbox.Visible = false
            local home, rest = MainFrame.Position, windowScale
            M.WinHome = home                      -- remember where the window was
            local sph = M.SphereHome or home      -- orb appears where it was last left (first time: window centre)
            if IsReducedMotion() then
                DisableWindowBlur()
                SetShellMode(true)
                MainFrame.Visible = false
                MainFrame.Position = home
                MainFrame.Rotation = 0
                MainScale.Scale = rest
                Sphere.BackgroundColor3 = sphereOriginalColor
                Sphere:SetAttribute("Dragging", false)
                Sphere.Size = UDim2.new(0, 42, 0, 42)
                Sphere.Position = sph
                Sphere.Rotation = 0
                SphereScale.Scale = 1
                if not sphTextToggle and sphImage then SphereImgLabel.ImageTransparency = 0 end
                if sphTextToggle then SphereTxtLabel.TextTransparency = 0 end
                Sphere.Visible = true
                SetShellMode(false)
                RS.Apply(M.Snap); M.Snap = nil
                BottomDragHitbox.Visible = false
                RS.Anim = false
                return
            end
            task.spawn(function()
                pcall(function()
                    -- 1) scan beam sweeps down while the window glitches
                    local clip = Create("Frame", { Parent = MainFrame, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                        ClipsDescendants = true, Active = false, ZIndex = 210 })
                    local tint = Create("Frame", { Parent = clip, BackgroundColor3 = (LiveTheme.OrbAcc or AccentColor), BackgroundTransparency = 0.8,
                        BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0), Active = false, ZIndex = 211 })
                    local beam = Create("Frame", { Parent = clip, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
                        Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 0, -3), Active = false, ZIndex = 212 })
                    local scan = TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                    Tween(beam, { Position = UDim2.new(0, 0, 1, 0) }, scan)
                    Tween(tint, { Size = UDim2.new(1, 0, 1, 0) }, scan)
                    local rng = Random.new()
                    for _ = 1, 7 do
                        MainFrame.Position = Jit(home, rng:NextInteger(-9, 9), rng:NextInteger(-3, 3))
                        task.wait(0.04)
                    end
                    MainFrame.Position = home
                    clip:Destroy()
                    -- 2) implosion: rings + streaks race into the orb while the window collapses
                    DisableWindowBlur()
                    SetShellMode(true)
                    for i = 1, 3 do
                        local ring = Fx({ BackgroundTransparency = 1, Size = UDim2.new(0, 460, 0, 460), AnchorPoint = Vector2.new(0.5, 0.5),
                            Position = home, ZIndex = 120 })
                        Create("UICorner", { Parent = ring, CornerRadius = UDim.new(1, 0) })
                        local st = Create("UIStroke", { Parent = ring, Color = (i == 2) and Color3.new(1, 1, 1) or (LiveTheme.OrbAcc or AccentColor), Thickness = 2, Transparency = 0.2 })
                        local ti = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.In, 0, false, (i - 1) * 0.07)
                        Tween(ring, { Size = UDim2.new(0, 30, 0, 30), Position = sph }, ti)
                        Tween(st, { Transparency = 1 }, ti)
                        task.delay(0.8, function() ring:Destroy() end)
                    end
                    for i = 1, 16 do
                        local a = (i / 16) * math.pi * 2
                        local d = rng:NextNumber(260, 420)
                        local s = Fx({ BackgroundColor3 = (i % 2 == 0) and Color3.new(1, 1, 1) or (LiveTheme.OrbAcc or AccentColor),
                            Size = UDim2.new(0, 22, 0, 2), AnchorPoint = Vector2.new(0.5, 0.5), Rotation = math.deg(a),
                            Position = Jit(home, math.cos(a) * d, math.sin(a) * d), ZIndex = 119 })
                        local ti = TweenInfo.new(0.48, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
                        Tween(s, { Position = sph, BackgroundTransparency = 1, Size = UDim2.new(0, 4, 0, 2) }, ti)
                        task.delay(0.55, function() s:Destroy() end)
                    end
                    Tween(MainFrame, { Position = sph }, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.In))
                    Tween(MainScale, { Scale = 0 }, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In))
                    task.wait(0.52)
                    -- 3) window gone, orb ignites where it was
                    MainFrame.Visible = false
                    MainScale.Scale = rest
                    MainFrame.Position = home
                    MainFrame.Rotation = 0
                    SetShellMode(false)
                    RS.Apply(M.Snap); M.Snap = nil
                    Sphere.BackgroundColor3 = sphereOriginalColor
                    Sphere:SetAttribute("Dragging", false)
                    Sphere.Size = UDim2.new(0, 42, 0, 42)
                    Sphere.Position = sph
                    Sphere.Rotation = 0
                    SphereScale.Scale = 0
                    if not sphTextToggle and sphImage then SphereImgLabel.ImageTransparency = 0 end
                    if sphTextToggle then SphereTxtLabel.TextTransparency = 0 end
                    Sphere.Visible = true
                    Tween(SphereScale, { Scale = 1 }, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
                    FlashOrb(); PulseOrb(); SparkBurst(80)
                end)
                BottomDragHitbox.Visible = false
                RS.Anim = false
            end)
        end

        function M.Restore()
            if not Window._isMinimized or RS.Anim then return end
            RS.Anim = true
            PlayUISound(UI_SOUND_IDS.Navigation)
            Window._isMinimized = false
            M.Id = M.Id + 1
            local rest = windowScale
            if IsReducedMotion() then
                local c = Sphere.Position
                MainFrame.Position = M.WinHome or c
                MainFrame.Rotation = 0
                MainFrame.Visible = true
                MainFrame.ClipsDescendants = true
                MainScale.Scale = rest
                Sphere.Visible = false
                SphereScale.Scale = 1
                SetShellMode(false)
                RS.Apply(M.Snap); M.Snap = nil
                ApplyBackgroundTransparency(Window.CurrentTransparency)
                FloatingBottomBar.BackgroundTransparency = math.clamp((Window.CurrentTransparency or 0) + ThemeRefs.GlassExtra, 0, 1)
                BottomBarStroke.Transparency = 0
                EnableWindowBlur()
                RS.Anim = false
                Window._active = true
                UpdateBottomBar()
                SetLoops(true, 0)
                RS.Run()
                return
            end
            task.spawn(function()
                pcall(function()
                    local c = Sphere.Position
                    M.SphereHome = c                      -- remember the orb spot for next minimize
                    local winHome = M.WinHome or c
                    local rng = Random.new()
                    -- 1) CINEMATIC CHARGE: reticle collapses, rings implode into the orb, orb swells and shivers
                    -- targeting reticle collapses onto the orb (dashed energy ring)
                    local ret = Fx({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = c, Size = UDim2.new(0, 170, 0, 170), ZIndex = 172 })
                    Create("UICorner", { Parent = ret, CornerRadius = UDim.new(1, 0) })
                    local rst = Create("UIStroke", { Parent = ret, Color = (LiveTheme.OrbAcc or AccentColor), Thickness = 1.6, Transparency = 0.15 })
                    local rgr = Create("UIGradient", { Parent = rst, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 1),
                        NumberSequenceKeypoint.new(0.4, 0), NumberSequenceKeypoint.new(0.6, 1), NumberSequenceKeypoint.new(0.8, 0), NumberSequenceKeypoint.new(1, 1) }) })
                    Tween(rgr, { Rotation = 300 }, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
                    Tween(ret, { Size = UDim2.new(0, 46, 0, 46) }, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In))
                    Tween(rst, { Transparency = 1 }, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In))
                    task.delay(0.6, function() ret:Destroy() end)
                    for i = 1, 3 do
                        task.delay((i - 1) * 0.11, function()
                            if not Host.Parent then return end
                            local ring = Fx({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = c, Size = UDim2.new(0, 300, 0, 300), ZIndex = 130 })
                            Create("UICorner", { Parent = ring, CornerRadius = UDim.new(1, 0) })
                            local st = Create("UIStroke", { Parent = ring, Color = (i == 2) and Color3.new(1, 1, 1) or (LiveTheme.OrbAcc or AccentColor), Thickness = 2.5, Transparency = 0.2 })
                            Tween(ring, { Size = UDim2.new(0, 28, 0, 28) }, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In))
                            Tween(st, { Transparency = 1, Thickness = 0.6 }, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In))
                            task.delay(0.55, function() ring:Destroy() end)
                        end)
                    end
                    Tween(SphereScale, { Scale = 1.35 }, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
                    PulseOrb()
                    for _ = 1, 8 do
                        Sphere.Position = Jit(c, rng:NextInteger(-5, 5), rng:NextInteger(-5, 5))
                        task.wait(0.04)
                    end
                    Sphere.Position = c
                    PulseOrb()
                    -- 2) IGNITION: vertical light beam + flash + embers, orb vanishes, window unfolds out of it
                    local beam = Fx({ BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = c, Size = UDim2.new(0, 3, 0, 0), ZIndex = 140 })
                    Create("UIGradient", { Parent = beam, Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1),
                        NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) })
                    Tween(beam, { Size = UDim2.new(0, 4, 1.4, 0) }, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
                    task.delay(0.22, function() Tween(beam, { Size = UDim2.new(0, 0, 1.4, 0), BackgroundTransparency = 1 }, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)) end)
                    task.delay(0.7, function() beam:Destroy() end)
                    FlashOrb(); SparkBurst(90)
                    Sphere.Visible = false
                    SphereScale.Scale = 1
                    Sphere.Rotation = 0
                    MainFrame.Rotation = 0
                    MainFrame.Position = c
                    -- IMPORTANT: prepare while page roots are still visible. SetShellMode(true)
                    -- hides those roots; collecting afterwards silently produces an empty text list.
                    local zxTL = Library._TypeFX.Prepare(MainFrame)
                    local zxVisuals = Library._TypeFX.PrepareVisuals(MainFrame)
                    local zxPlaceholders = Library._TypeFX.PreparePlaceholders(MainFrame)
                    -- Safety release in case an interrupted restore prevents the normal reveal runner.
                    task.delay(4.5, function()
                        for _, d in ipairs(zxTL) do
                            if d.Parent and d.MaxVisibleGraphemes >= 0 then d.MaxVisibleGraphemes = -1 end
                        end
                        for _, item in ipairs(zxPlaceholders) do
                            local box = item.Object
                            if box and box.Parent and box.PlaceholderText == "" then box.PlaceholderText = item.Text end
                        end
                        for _, item in ipairs(zxVisuals) do
                            local obj = item.Object
                            if obj and obj.Parent then
                                pcall(function()
                                    if obj[item.Property] == 1 then obj[item.Property] = item.Target end
                                end)
                            end
                        end
                    end)
                    SetShellMode(true)
                    MainScale.Scale = 0
                    ApplyBackgroundTransparency(Window.CurrentTransparency)
                    FloatingBottomBar.BackgroundTransparency = math.clamp((Window.CurrentTransparency or 0) + ThemeRefs.GlassExtra, 0, 1)
                    BottomBarStroke.Transparency = 0
                    MainFrame.Visible = true
                    EnableWindowBlur()
                    Tween(MainScale, { Scale = rest }, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
                    Tween(MainFrame, { Position = winHome }, TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
                    -- Release the real controls partway through the expansion: their surfaces fade
                    -- and every visible text row starts typing while the window is still blooming.
                    local revealStarted = false
                    local function RevealContent()
                        if revealStarted then return end
                        revealStarted = true
                        SetShellMode(false)
                        RS.Apply(M.Snap); M.Snap = nil
                        Library._TypeFX.RunVisuals(zxVisuals, 0, 0.58)
                        Library._TypeFX.RunPlaceholders(zxPlaceholders, 0.06, 0.72, 0.04)
                        Library._TypeFX.Run(zxTL, 0.04, 1.65, 0.036)
                    end
                    task.delay(0.32, RevealContent)
                    -- holographic materialize: corner brackets snap in + scan beam sweeps the window
                    task.delay(0.12, function()
                        pcall(function()
                            local W, H = MainFrame.Size.X.Offset * rest, MainFrame.Size.Y.Offset * rest
                            local function Corner(sx, sy)
                                local px, py = winHome.X.Offset + sx * W / 2, winHome.Y.Offset + sy * H / 2
                                local h = Fx({ BackgroundTransparency = 1, Size = UDim2.new(0, 26, 0, 26), AnchorPoint = Vector2.new(sx < 0 and 0 or 1, sy < 0 and 0 or 1),
                                    Position = UDim2.new(winHome.X.Scale, px + sx * 40, winHome.Y.Scale, py + sy * 40), ZIndex = 172 })
                                local b1 = Create("Frame", { Parent = h, BackgroundColor3 = AccentColor, BorderSizePixel = 0, Active = false, ZIndex = 172,
                                    Size = UDim2.new(1, 0, 0, 2), AnchorPoint = Vector2.new(0, sy < 0 and 0 or 1), Position = UDim2.new(0, 0, sy < 0 and 0 or 1, 0) })
                                local b2 = Create("Frame", { Parent = h, BackgroundColor3 = AccentColor, BorderSizePixel = 0, Active = false, ZIndex = 172,
                                    Size = UDim2.new(0, 2, 1, 0), AnchorPoint = Vector2.new(sx < 0 and 0 or 1, 0), Position = UDim2.new(sx < 0 and 0 or 1, 0, 0, 0) })
                                Tween(h, { Position = UDim2.new(winHome.X.Scale, px, winHome.Y.Scale, py) }, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
                                task.delay(0.7, function()
                                    local fo = TweenInfo.new(0.4, Enum.EasingStyle.Sine)
                                    Tween(b1, { BackgroundTransparency = 1 }, fo); Tween(b2, { BackgroundTransparency = 1 }, fo)
                                end)
                                task.delay(1.15, function() h:Destroy() end)
                            end
                            Corner(-1, -1); Corner(1, -1); Corner(-1, 1); Corner(1, 1)
                            local beam = Fx({ AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, W, 0, 40), BackgroundColor3 = AccentColor, ZIndex = 171,
                                Position = UDim2.new(winHome.X.Scale, winHome.X.Offset, winHome.Y.Scale, winHome.Y.Offset - H / 2) })
                            Create("UIGradient", { Parent = beam, Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1),
                                NumberSequenceKeypoint.new(0.45, 0.8), NumberSequenceKeypoint.new(0.5, 0.15), NumberSequenceKeypoint.new(0.55, 0.8), NumberSequenceKeypoint.new(1, 1) }) })
                            Create("Frame", { Parent = beam, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Active = false, ZIndex = 172,
                                Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 0.5, 0) })
                            Tween(beam, { Position = UDim2.new(winHome.X.Scale, winHome.X.Offset, winHome.Y.Scale, winHome.Y.Offset + H / 2) },
                                TweenInfo.new(0.75, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut))
                            task.delay(0.8, function() beam:Destroy() end)
                        end)
                    end)
                    task.wait(0.62)
                    MainFrame.Position = winHome
                    MainScale.Scale = rest
                    -- Fallback if the delayed reveal could not run before the expansion completed.
                    RevealContent()
                end)
                MainScale.Scale = rest
                MainFrame.Rotation = 0
                RS.Anim = false
                Window._active = true
                UpdateBottomBar()
                SetLoops(true, 0.7)
                RS.Run()
                if RS.Sweep then RS.Sweep() end
            end)
        end

        Sphere.MouseButton1Click:Connect(function()
            if Sphere:GetAttribute("Dragging") then return end
            M.Restore()
        end)

        -- Watchdog: the orb can never linger over a visible window, and the window can never stay rotated / unclipped.
        task.spawn(function()
            while ScreenGui and ScreenGui.Parent do
                task.wait(0.5)
                if not RS.Anim and MainFrame.Visible then
                    if Sphere.Visible then Sphere.Visible = false end
                    Window._isMinimized = false
                    if MainFrame.Rotation ~= 0 then MainFrame.Rotation = 0 end
                    if not MainFrame.ClipsDescendants then MainFrame.ClipsDescendants = true end
                end
            end
        end)
    end

    ApplyIntroTransparency = function()
        local val = Window.CurrentTransparency or 0
        ApplyBackgroundTransparency(val, TI.Slow)
        Tween(FloatingBottomBar, {BackgroundTransparency=val}, TI.Slow)
    end

    function Window:SetTransparency(val)
        val = tonumber(val) or Window.CurrentTransparency or 0
        val = math.clamp(val, 0, 1)
        Window.CurrentTransparency = val
                if Window._isMinimized then return end
        if MainFrame.Visible then
            ApplyBackgroundTransparency(val, TI.Fade)
            Tween(FloatingBottomBar, {BackgroundTransparency=val}, TI.Fade)
        else
            -- Applied before the intro finishes (e.g. a default-ON transparency toggle):
            -- set it directly so the window is already transparent when it is revealed.
            ApplyBackgroundTransparency(val)
            FloatingBottomBar.BackgroundTransparency = val
        end
    end

