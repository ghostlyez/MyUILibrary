                    local function RebuildMonitor()
                        for _, v in ipairs(Monitor:GetChildren()) do
                            if v:IsA("Frame") then v:Destroy() end
                        end
                        selectedForDelete = {}
                        local entries = {}
                        local okL, listed = pcall(_listfiles, folderName)
                        if not okL or type(listed) ~= "table" then listed = {} end
                        for _, filepath in ipairs(listed) do
                            local rawName = filepath:match("([^/\\]+)%.json$")
                            if rawName then
                                entries[#entries + 1] = {
                                    path = filepath,
                                    display = (rawName:gsub("_%d+%.%d+$",""):gsub("_%d+$","")),
                                    ts = tonumber(rawName:match("_(%d+)$")) or 0,
                                }
                            end
                        end
                        table.sort(entries, function(a, b)
                            if a.ts ~= b.ts then return a.ts > b.ts end
                            return a.display < b.display
                        end)
                        for i, entry in ipairs(entries) do
                            local filepath, displayFName = entry.path, entry.display
                            local dateText = "Saved preset"
                            if entry.ts > 1000000000 then
