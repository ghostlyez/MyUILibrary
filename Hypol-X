                    local f = Node(root, { Position = P(x, -0.1), Size = UDim2.new(0, 2, 0, r:NextInteger(14, 26)), Rotation = 14, BackgroundColor3 = th.Light, BackgroundTransparency = 0.45 })
                    Run(st, f, { Position = P(x - 0.18, 1.1) }, 0.8 + (k % 5) * 0.2, false, LIN)
                end
                Pulse(st, root, th.Accent, r:NextNumber(0.2, 0.8), 0.85, 2, 90, 1.2)
            end

            B.Cyan = function(st, root, i, th, r)
                Beam(st, root, WH, 25, 36, 3 + i * 0.7, 0.5)
                Beam(st, root, th.Light, 25, 70, 5.5 + i, 0.8)
                for k = 1, 10 do Rise(st, root, WH, r:NextInteger(2, 4), r:NextNumber(0.05, 0.95), r:NextNumber(0.05, 0.95), -0.05, 1.05, 6 + k * 0.8, true) end
            end

            B.White = function(st, root, i, th, r)
                for k = 1, 4 do
                    local f = Node(root, { AnchorPoint = Vector2.new(0.5, 0), Position = P(0.2 + k * 0.17, -0.1), Size = UDim2.new(0, 34, 1.7, 0), Rotation = -14 + k * 3, BackgroundColor3 = WH, BackgroundTransparency = 0 })
                    Edge(f, 0.88)
                    Run(st, f, { Rotation = 14 - k * 2 }, 5 + k * 1.3, true)
                end
                for k = 1, 8 do
                    local s = Disc(root, WH, 3, r:NextNumber(0.05, 0.95), r:NextNumber(0.05, 0.95), 0.1)
                    Run(st, s, { BackgroundTransparency = 0.95 }, 0.8 + k * 0.3, true)
