function Library.GetConfirm(infoData)
    local c = type(infoData) == "table" and infoData.Confirm or nil
    if c == true then return {} end
    if type(c) == "table" then return c end
    return nil
end

function Library.NewCallout(Host, WindowFrame)
    local cur, token, hb, esc = nil, 0, nil, nil
    local live = {} -- running tweens; cancelled when a new popup starts
    local CARD = Color3.fromRGB(22, 23, 33)
    local W = 280
    local WHITE = Color3.new(1, 1, 1)
    local Catcher = Create("TextButton", { Name = "ZXConfirmCatcher", Parent = Host, Text = "", AutoButtonColor = false,
        BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), ZIndex = 120, Visible = false, Active = true })
    local Root = Create("Frame", { Name = "ZXConfirmRoot", Parent = Catcher, BackgroundTransparency = 1, BorderSizePixel = 0,
        Size = UDim2.new(0, W, 0, 100), ZIndex = 121, Active = true })
    local RootScale = Create("UIScale", { Parent = Root, Scale = 1 })
    local Notch = Create("Frame", { Parent = Root, BackgroundColor3 = CARD, BackgroundTransparency = 1, BorderSizePixel = 0,
        Size = UDim2.new(0, 12, 0, 12), AnchorPoint = Vector2.new(0.5, 0.5), Rotation = 45, ZIndex = 121, Active = false })
    local NotchStroke = Create("UIStroke", { Parent = Notch, Color = AccentColor, Thickness = 1.2, Transparency = 1 })
    -- NOTE: never put a UIGradient on a CanvasGroup (it tints every child). The gradient lives on a background frame.
    local Card = Create("CanvasGroup", { Parent = Root, BackgroundTransparency = 1, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0), GroupTransparency = 0, ZIndex = 122, Active = true })
    Create("UICorner", { Parent = Card, CornerRadius = UDim.new(0, 12) })
    local CardBg = Create("Frame", { Name = "Bg", Parent = Card, BackgroundColor3 = WHITE, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0), ZIndex = 1, Active = false })
    Create("UIGradient", { Parent = CardBg, Rotation = 120, Color = ColorSequence.new(Color3.fromRGB(28, 29, 42), Color3.fromRGB(15, 16, 23)) })
    local CardStroke = Create("UIStroke", { Parent = Card, Color = AccentColor, Thickness = 1.2, Transparency = 0.35 })
    local Icon = Create("Frame", { Parent = Card, BackgroundColor3 = AccentColor, BackgroundTransparency = 0.82, BorderSizePixel = 0,
        Size = UDim2.new(0, 28, 0, 28), Position = UDim2.new(0, 12, 0, 13), ZIndex = 123, Active = false })
    Create("UICorner", { Parent = Icon, CornerRadius = UDim.new(1, 0) })
    local IconStroke = Create("UIStroke", { Parent = Icon, Color = AccentColor, Thickness = 1.4 })
    local IconText = Create("TextLabel", { Parent = Icon, Text = "?", Font = Enum.Font.GothamBlack, TextSize = 15, TextColor3 = AccentColor,
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 124 })
    local Title = Create("TextLabel", { Parent = Card, Text = "", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = WHITE,
        BackgroundTransparency = 1, Size = UDim2.new(1, -62, 0, 18), Position = UDim2.new(0, 50, 0, 11),
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 124 })
    local Desc = Create("TextLabel", { Parent = Card, Text = "", Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Color3.fromRGB(160, 163, 182),
        BackgroundTransparency = 1, Size = UDim2.new(1, -62, 0, 16), Position = UDim2.new(0, 50, 0, 30), TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 124 })
    local Div1 = Create("Frame", { Parent = Card, BackgroundColor3 = Color3.fromRGB(48, 50, 66), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 1, -34), ZIndex = 124, Active = false })
    local Div2 = Create("Frame", { Parent = Card, BackgroundColor3 = Color3.fromRGB(48, 50, 66), BorderSizePixel = 0, Size = UDim2.new(0, 1, 0, 33),
        Position = UDim2.new(0.5, 0, 1, -33), ZIndex = 124, Active = false })
    local function Half(isYes)
        return Create("TextButton", { Parent = Card, Text = "", AutoButtonColor = false, BackgroundColor3 = WHITE,
            BackgroundTransparency = 1, BorderSizePixel = 0, Font = Enum.Font.GothamBold, TextSize = 12,
            Size = UDim2.new(0.5, isYes and -1 or 0, 0, 33), Position = UDim2.new(isYes and 0.5 or 0, isYes and 1 or 0, 1, -33), ZIndex = 125 })
    end
    local NoBtn, YesBtn = Half(false), Half(true)
    NoBtn.MouseEnter:Connect(function() Tween(NoBtn, { BackgroundTransparency = 0.9 }, TI.Fast) end)
    NoBtn.MouseLeave:Connect(function() Tween(NoBtn, { BackgroundTransparency = 1 }, TI.Fast) end)
    YesBtn.MouseEnter:Connect(function() Tween(YesBtn, { BackgroundTransparency = 0.82 }, TI.Fast) end)
    YesBtn.MouseLeave:Connect(function() Tween(YesBtn, { BackgroundTransparency = 1 }, TI.Fast) end)

    local function T(inst, props, info)
        local t = TweenService:Create(inst, info, props)
        live[#live + 1] = t
        t:Play()
        return t
    end
    local function CancelLive()
        for _, t in ipairs(live) do pcall(function() t:Cancel() end) end
        live = {}
    end
    local function TInfo(d, style, dir, delay)
        return TweenInfo.new(d, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out, 0, false, delay or 0)
    end
    -- Fades every piece of content (icon, outline of the icon, text, dividers, button labels) with a small stagger.
    local function ContentFade(visible, delay, dur)
        local tr = visible and 0 or 1
        local style = Enum.EasingStyle.Quad
        local dir = visible and Enum.EasingDirection.Out or Enum.EasingDirection.In
        local items = {
            { Icon, { BackgroundTransparency = visible and 0.82 or 1 } }, { IconStroke, { Transparency = tr } },
            { IconText, { TextTransparency = tr } }, { Title, { TextTransparency = tr } }, { Desc, { TextTransparency = tr } },
            { Div1, { BackgroundTransparency = tr } }, { Div2, { BackgroundTransparency = tr } },
            { NoBtn, { TextTransparency = tr } }, { YesBtn, { TextTransparency = tr } },
        }
        for i, it in ipairs(items) do T(it[1], it[2], TInfo(dur, style, dir, delay + (i - 1) * 0.02)) end
    end

    local function finish(yes)
        local c = cur
        if not c then return end
        cur = nil; token = token + 1
        local my = token
        if hb then hb:Disconnect(); hb = nil end
        if esc then esc:Disconnect(); esc = nil end
        CancelLive()
        Catcher.Size = UDim2.new(0, 0, 0, 0) -- stop blocking clicks right away
        Root.Active = false; Card.Active = false
        -- cinematic close: 1) text + icon fade  2) outline flashes white, then burns out
        -- 3) frame collapses to a line toward the control, then pinches shut and fades
        ContentFade(false, 0, 0.12)
        T(CardStroke, { Color = WHITE, Thickness = 2.4 }, TInfo(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0.05))
        T(NotchStroke, { Color = WHITE }, TInfo(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0.05))
        T(CardStroke, { Transparency = 1, Thickness = 0.6 }, TInfo(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0.2))
        local collapse = T(Root, { Size = UDim2.new(0, W, 0, 2) }, TInfo(0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.In, 0.12))
        collapse.Completed:Once(function()
            if token ~= my then return end
            T(Root, { Size = UDim2.new(0, 0, 0, 2) }, TInfo(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.In))
            T(Card, { GroupTransparency = 1 }, TInfo(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In))
            T(Notch, { BackgroundTransparency = 1 }, TInfo(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In))
            T(NotchStroke, { Transparency = 1 }, TInfo(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In))
        end)
        task.delay(0.62, function() if token == my then Catcher.Visible = false end end)
        local cb = yes and c.yes or c.no
        if cb then
            local ok, err = pcall(cb)
            if not ok then warn("[ZyronX] confirm callback error: " .. tostring(err)) end
        end
    end
    YesBtn.MouseButton1Click:Connect(function() PlayUISound(UI_SOUND_IDS.Control); finish(true) end)
    NoBtn.MouseButton1Click:Connect(function() PlayUISound(UI_SOUND_IDS.Control); finish(false) end)
    Catcher.MouseButton1Click:Connect(function() finish(false) end) -- clicking outside = No
    Host.Destroying:Connect(function()
        if hb then hb:Disconnect() end
        if esc then esc:Disconnect() end
    end)

    local function Ask(anchor, cfg, onYes, onNo)
        if type(cfg) ~= "table" then cfg = {} end
        if cur then finish(false) end -- a still-open popup counts as dismissed
        CancelLive()
        token = token + 1
        local c = { yes = onYes, no = onNo }
        cur = c
        local acc = cfg.Danger == true and Color3.fromRGB(255, 88, 106) or AccentColor
        Title.Text = tostring(cfg.Title or "Are you sure?")
        Desc.Text = tostring(cfg.Description or cfg.Desc or "")
        YesBtn.Text = tostring(cfg.Yes or cfg.ConfirmText or "Yes")
        NoBtn.Text = tostring(cfg.No or cfg.CancelText or "No")
        IconText.Text = cfg.Danger == true and "!" or "?"
        Icon.BackgroundColor3 = acc; IconStroke.Color = acc; IconText.TextColor3 = acc
        NotchStroke.Color = acc
        YesBtn.TextColor3 = acc; YesBtn.BackgroundColor3 = acc
        NoBtn.TextColor3 = Color3.fromRGB(176, 179, 196); NoBtn.BackgroundColor3 = WHITE

        local dh = 0
        if Desc.Text ~= "" then
            local okm, sz = pcall(function()
                return TextService:GetTextSize(Desc.Text, 11, Enum.Font.GothamMedium, Vector2.new(W - 62, 1000))
            end)
            dh = (okm and sz.Y or 14) + 2
        end
        Desc.Visible = dh > 0
        Desc.Size = UDim2.new(1, -62, 0, dh)
        local H = math.max(30 + dh + 12 + 34, 84)

        local function place()
            local sc = 1
            local u = Host:FindFirstChildOfClass("UIScale")
            if u then sc = u.Scale end
            local hs = Host.AbsoluteSize / sc
            if anchor and anchor.Parent then
                local ap, az, hp = anchor.AbsolutePosition, anchor.AbsoluteSize, Host.AbsolutePosition
                local cx = (ap.X + az.X / 2 - hp.X) / sc
                local topY, botY = (ap.Y - hp.Y) / sc, (ap.Y + az.Y - hp.Y) / sc
                local below = (botY + 12 + H + 8 <= hs.Y) or (topY - 12 - H < 8)
                local x = math.clamp(cx, 8 + W / 2, math.max(8 + W / 2, hs.X - 8 - W / 2))
                Root.AnchorPoint = Vector2.new(0.5, below and 0 or 1)
                Root.Position = UDim2.fromOffset(x, below and botY + 12 or topY - 12)
                Notch.Visible = true
                Notch.Position = UDim2.new(0, math.clamp(cx - (x - W / 2), 20, W - 20), below and 0 or 1, 0)
            else
                Root.AnchorPoint = Vector2.new(0.5, 0.5)
                Root.Position = UDim2.fromOffset(hs.X / 2, hs.Y / 2)
                Notch.Visible = false
            end
        end

        -- cinematic open: bright line -> frame unfolds -> outline settles -> content fades in
        Catcher.Size = UDim2.new(1, 0, 1, 0)
        Catcher.Visible = true
        Root.Active = true; Card.Active = true
        Card.GroupTransparency = 0
        Root.Size = UDim2.new(0, W, 0, 2)
        RootScale.Scale = 0.96
        CardStroke.Color = WHITE; CardStroke.Thickness = 2.4; CardStroke.Transparency = 0
        Notch.BackgroundTransparency = 1; NotchStroke.Transparency = 1
        for _, it in ipairs({ Icon, Div1, Div2 }) do it.BackgroundTransparency = 1 end
        for _, it in ipairs({ IconStroke }) do it.Transparency = 1 end
        for _, it in ipairs({ IconText, Title, Desc, NoBtn, YesBtn }) do it.TextTransparency = 1 end
        place()
        T(Root, { Size = UDim2.new(0, W, 0, H) }, TInfo(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
        T(RootScale, { Scale = 1 }, TInfo(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
        T(CardStroke, { Color = acc, Thickness = 1.2, Transparency = 0.35 }, TInfo(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0.1))
        T(Notch, { BackgroundTransparency = 0 }, TInfo(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0.2))
        T(NotchStroke, { Transparency = 0.35 }, TInfo(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0.2))
        ContentFade(true, 0.18, 0.22)

        hb = RunService.Heartbeat:Connect(function()
            if cur ~= c then return end
            if (WindowFrame and not WindowFrame.Visible) or (anchor and not anchor:IsDescendantOf(game)) then finish(false); return end
            place()
        end)
        esc = UserInputService.InputBegan:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.Escape then finish(false) end
        end)
        PlayUISound(UI_SOUND_IDS.Confirm)
    end
    return Ask, function() finish(false) end
end

