        end
        -- Binary aura: idle 1/0 text outside (and faintly behind) the window; morphs between shapes with a typing cursor.
        SpaceFX.AuraS = { On = false, Cells = {} }
        function SpaceFX.Aura(on)
            local A = SpaceFX.AuraS
            on = on and true or false
            if A.On == on then return end
            A.On = on
            if A.Conn then A.Conn:Disconnect(); A.Conn = nil end
            if A.PosConn then A.PosConn:Disconnect(); A.PosConn = nil end
            if A.Frame then A.Frame:Destroy(); A.Frame = nil end
            A.Cells = {}
            if not on then return end
            local MARGIN = 110
            local GREEN = Color3.fromRGB(0, 255, 110)
            local frame = Create("Frame", { Name = "HackerAura", Parent = Host, BackgroundTransparency = 1, BorderSizePixel = 0,
                Active = false, ZIndex = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = MainFrame.Position, Size = UDim2.new(0, 10, 0, 10) })
            A.Frame = frame
            A.PosConn = MainFrame:GetPropertyChangedSignal("Position"):Connect(function() frame.Position = MainFrame.Position end)
            local function Shape(s, x, y, a, b)
                if s == 0 then
                    local o = math.max(math.abs(x) - a, math.abs(y) - b)
                    if o < 0 then return 0.3 end
                    return 1 - o / MARGIN
                elseif s == 1 then
                    local r = math.sqrt((x / (a + MARGIN * 0.5)) ^ 2 + (y / (b + MARGIN * 0.5)) ^ 2)
                    return 1 - math.abs(r - 0.95) / 0.25
                end
                local d = math.abs(x) / (a + MARGIN * 0.75) + math.abs(y) / (b + MARGIN * 0.75)
                return 1 - math.abs(d - 1) / 0.28
            end
            local function Build()
                for _, c in ipairs(A.Cells) do c.L:Destroy() end
                A.Cells = {}
                A.Ws = windowScale
                local ww, hh = 650, 420
                local a, b = ww / 2, hh / 2
                A.a, A.b = a, b
                local W, H = ww + MARGIN * 2, hh + MARGIN * 2
                frame.Size = UDim2.new(0, W, 0, H)
                local CELL = math.max(14, math.floor(math.sqrt(W * H / 1150)))
                local cols, rows = math.floor(W / CELL), math.floor(H / CELL)
                local n = 0
                for r = 0, rows - 1 do
                    for ci = 0, cols - 1 do
                        n = n + 1
                        local x = (ci + 0.5) * CELL - cols * CELL / 2
                        local y = (r + 0.5) * CELL - rows * CELL / 2
                        local inside = math.abs(x) < a and math.abs(y) < b
                        if (not inside) or (n % 6 == 0) then
                            local L = Create("TextLabel", { Parent = frame, Text = "1", Font = Enum.Font.Code, TextSize = math.floor(CELL * 0.8),
                                TextColor3 = GREEN, BackgroundTransparency = 1, TextTransparency = 1, Size = UDim2.new(0, CELL, 0, CELL),
                                Position = UDim2.new(0.5, x - CELL / 2, 0.5, y - CELL / 2), Active = false, ZIndex = 0 })
                            A.Cells[#A.Cells + 1] = { L = L, x = x, y = y, noise = ((n * 7919) % 97) / 97, q = 10, ch = "1", idx = n }
                        end
                    end
                end
                A.Total = math.max(n, 1)
            end
            Build()
            local fs = Create("UIScale", { Parent = frame, Scale = windowScale })
            local t0, acc = os.clock(), 0
            A.Conn = RunService.Heartbeat:Connect(function(dt)
                acc = acc + dt
                if acc < 0.09 then return end
                acc = 0
                local vis = MainFrame.Visible and ScreenGui.Enabled and not RS.Anim and not Window._isMinimized
                if frame.Visible ~= vis then frame.Visible = vis end
                if not vis then return end
                if fs.Scale ~= windowScale then fs.Scale = windowScale; return end
                local t = os.clock() - t0
                local phase = t / 5
                local i0 = math.floor(phase) % 3
                local i1 = (i0 + 1) % 3
                local k = math.clamp((phase - math.floor(phase) - 0.72) / 0.28, 0, 1)
                k = k * k * (3 - 2 * k)
                local a, b, total = A.a, A.b, A.Total
                local head = (t * 0.55) % 1
                local flick = math.floor(t * 10)
                for i, c in ipairs(A.Cells) do
                    local v0, v1 = Shape(i0, c.x, c.y, a, b), Shape(i1, c.x, c.y, a, b)
                    local score = v0 + (v1 - v0) * k + (c.noise - 0.5) * 0.35 + math.sin(t * 1.7 + c.idx) * 0.05
                    local tp, text, col = 1, nil, GREEN
                    if score > 0.35 then
                        tp = math.clamp(0.22 + (1 - score) * 0.6, 0.18, 0.9)
                        if math.abs(c.idx / total - head) < 0.006 then
                            text, tp, col = "█", 0.05, Color3.new(1, 1, 1)
                        elseif (i + flick) % 9 == 0 then
                            c.ch = (c.ch == "1") and "0" or "1"
                            text = c.ch
                        else
                            text = c.ch
                        end
                    end
                    local q = math.floor(tp * 10)
                    if c.q ~= q then c.q = q; c.L.TextTransparency = tp end
                    if text and c.L.Text ~= text then c.L.Text = text end
                    if c.L.TextColor3 ~= col then c.L.TextColor3 = col end
                end
            end)
        end

