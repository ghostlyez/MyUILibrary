                        Size = UDim2.new(0, len, 0, 1), Rotation = math.deg(math.atan2(dy, dx)), ZIndex = 5 })] = true
                    local pk = Create("Frame", { Parent = root, BackgroundColor3 = spec.C, BackgroundTransparency = 0.15, BorderSizePixel = 0, Active = false,
