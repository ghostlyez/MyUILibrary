-- Accessibility: Roblox exposes reduced-motion settings on supported clients. Guard the
-- property read so the library remains compatible with clients that do not expose it.
local function IsReducedMotion()
    local ok, value = pcall(function() return GuiService.ReducedMotionEnabled end)
    if ok then return value == true end
    ok, value = pcall(function() return UserInputService.ReducedMotionEnabled end)
    return ok and value == true
end

