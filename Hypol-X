                        Size = UDim2.new(0, spec.w, 0, spec.h), Rotation = spec.rot,
                        BackgroundTransparency = 1, ZIndex = 7 + j,
                    })
                    FXRound(ring)
                    local st = FXStroke(state, ring, Color3.new(1, 1, 1), spec.thick, spec.trans,
                        { KC(0, RED), KC(0.36, VIOLET), KC(0.68, ICE), KC(1, RED) })
                    local grad = st:FindFirstChildOfClass("UIGradient")
                    Loop("ZXExploiter_RingRotate_" .. i .. "_" .. j, ring,
                        { Rotation = spec.rot + spec.speed }, 8.5 + j * 2, false)
                    if grad then Loop("ZXExploiter_RingColor_" .. i .. "_" .. j, grad, { Rotation = 360 }, 2.35 + j * 0.42, false) end
                end

                -- A fast, soft-edged scanner crosses each side rail; it does not block input.
