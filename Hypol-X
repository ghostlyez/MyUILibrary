            local function Build(name)
                local th = Themes[name]
                local state = { Name = name, Roots = {}, Loops = {}, On = false }
                PremiumFX.AmbStates[name] = state
                local fn = B[name]
                if not (th and fn) then return state end
                local t = { Accent = th.Accent or WH, Light = th.Light or th.Accent or WH, Deep = th.Deep or th.Accent or WH }
                for i, group in ipairs({ LeftBackgroundGroup, RightBackgroundGroup }) do
                    local root = FXRoot(state, group, 90 + i)
                    pcall(fn, state, root, i, t, Random.new(i * 97 + #name))
                end
                return state
            end
            PremiumFX.AmbStates = {}
            function PremiumFX.AmbientSet(name)
                if not PremiumFX.AmbStates[name] and Themes[name] then Build(name) end
                for key, state in pairs(PremiumFX.AmbStates) do
                    local on = key == name
                    state.On = on
                    for _, root in ipairs(state.Roots) do if root.Parent then root.Visible = on end end
                    for _, tween in ipairs(state.Loops) do
                        if on and not IsReducedMotion() then pcall(function() tween:Play() end)
                        else pcall(function() tween:Cancel() end) end
                    end
                end
            end
        end)()

