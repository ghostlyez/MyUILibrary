        local function ReadList()
            local entries, folder = {}, Folder()
            local ok, files = pcall(function() return _listfiles(folder) end)
            if ok and type(files) == "table" then
                for _, path in ipairs(files) do
                    local raw = tostring(path):match("([^/\\]+)%.json$")
                    if raw then
                        entries[#entries + 1] = { path = path, ts = tonumber(raw:match("_(%d+)$")) or 0,
                            display = (raw:gsub("_%d+%.%d+$", ""):gsub("_%d+$", "")) }
                    end
                end
            end
            table.sort(entries, function(a, b) if a.ts ~= b.ts then return a.ts > b.ts end return a.display < b.display end)
            return entries
        end
        local function SetCurrent(name)
            currentName = name
