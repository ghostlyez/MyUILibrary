    -- ============================================================
    -- CreateTab
    -- ============================================================
    function Window:CreateTab(tabName, isDefault, isLocked)
        local isWhitelisted = false
        local plr = Players.LocalPlayer
        if plr then
            for _, u in ipairs(Library.WhitelistedUsers) do
                if plr.Name == u or plr.DisplayName == u then
                    isWhitelisted = true; break
                end
            end
        end

        -- Frosted "capsule" tab: tinted gradient fill + hairline glass border that both
        -- follow the button's BackgroundTransparency, so the existing activate/deactivate
        -- tweens (and hover) drive the whole look with no extra bookkeeping.
        -- Three-stop ramp: a vivid leading edge that melts into a deep, calm tail. Every stop is
        -- bright enough for the theme remap to recolor it, so non-default themes stay consistent.
        local tabTintStart = isLocked and Color3.fromRGB(132, 104, 26) or Color3.fromRGB(104, 72, 190)
        local tabTintMid   = isLocked and Color3.fromRGB(78, 62, 18)   or Color3.fromRGB(62, 46, 116)
        local tabTintEnd   = isLocked and Color3.fromRGB(40, 32, 12)   or Color3.fromRGB(36, 29, 68)
        local tabRail     = isLocked and Color3.fromRGB(255,215,0) or AccentColor
        local tabRailEnd  = isLocked and Color3.fromRGB(255,150,40) or Color3.fromRGB(110,72,210)
        local TabBtn = Create("TextButton",{Parent=TabContainer,Text="",BackgroundColor3=Color3.new(1,1,1),
            BackgroundTransparency=1,Size=UDim2.new(1,0,0,35),AutoButtonColor=false,
            LayoutOrder=#Window.Tabs + 1})
        Create("UICorner",{Parent=TabBtn,CornerRadius=UDim.new(0,8)})
        Create("UIGradient",{Parent=TabBtn,Rotation=0,Color=ColorSequence.new({
            ColorSequenceKeypoint.new(0,   tabTintStart),
            ColorSequenceKeypoint.new(0.55, tabTintMid),
            ColorSequenceKeypoint.new(1,   tabTintEnd),
        })})
        local TabGlass = Create("UIStroke",{Parent=TabBtn,Color=tabRail,Thickness=1,Transparency=1})
        -- Border follows the fill: invisible when idle, soft on hover, defined when selected.
        local TabTxtRef
        local TabGlow, TabChevron
        local function SyncTabGlass()
            local bt = TabBtn.BackgroundTransparency
            local k = 1 - bt                                  -- 0 idle .. ~0.6 selected
            local sel = math.clamp((bt - 0.4) / 0.6, 0, 1)    -- 0 selected .. 1 idle
            TabGlass.Transparency = 1 -- v20: selected tab no longer draws a neon outline
            if TabTxtRef then TabTxtRef.Position = UDim2.new(0, 22 + math.floor(k * 9), 0, 0) end
            if TabGlow then TabGlow.BackgroundTransparency = 1 - k * 0.55 end
            if TabChevron then
                TabChevron.TextTransparency = sel
