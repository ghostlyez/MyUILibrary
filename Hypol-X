        -- ===== Hacker theme extras: falling binary rain + scan beam live inside the flattened background groups =====
        SpaceFX.HK = { On = false }
        function SpaceFX.HDot(dot)
            for _, c in ipairs(dot:GetChildren()) do if c:IsA("UIGradient") then c:Destroy() end end
            NoRemap[Create("UIGradient", { Parent = dot, Rotation = 45, Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 120, 44)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 255, 130)) }) })] = true
