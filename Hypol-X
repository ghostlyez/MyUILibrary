        local TransHit = Create("TextButton", { Parent = TransCard, Text = "", AutoButtonColor = false,
            BackgroundTransparency = 1, Size = UDim2.new(1, -16, 0, 26), Position = UDim2.new(0, 8, 0, 24), ZIndex = 4 })

        local function SetTransparencyValue(value)
            value = math.clamp(tonumber(value) or 0, 0, TRANS_MAX)
            value = math.floor(value * 100 + 0.5) / 100
            local ratio = value / TRANS_MAX
            TransValue.Text = string.format("%d%%", math.floor(value * 100 + 0.5))
            TransFill.Size = UDim2.new(ratio, 0, 1, 0)
            Window:SetTransparency(value)
        end

        local transInput, transMoveConn, transEndConn
        local function StopTransDrag()
            transInput = nil
            if ActiveControlDragOwner == TransHit then ActiveControlDragOwner = nil end
            if transMoveConn then transMoveConn:Disconnect(); transMoveConn = nil end
            if transEndConn then transEndConn:Disconnect(); transEndConn = nil end
            OptionsScroll.ScrollingEnabled = true
        end
        local function ApplyTransX(x)
            local width = TransTrack.AbsoluteSize.X
            if width <= 0 then return end
            local ratio = math.clamp((x - TransTrack.AbsolutePosition.X) / width, 0, 1)
            SetTransparencyValue(ratio * TRANS_MAX)
        end
        TransHit.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
            if transInput or ActiveControlDragOwner then return end
            transInput = input
            ActiveControlDragOwner = TransHit
            OptionsScroll.ScrollingEnabled = false
            ApplyTransX(input.Position.X)
            if input.UserInputType == Enum.UserInputType.Touch then
                transMoveConn = UserInputService.TouchMoved:Connect(function(touch)
                    if transInput and touch == transInput then ApplyTransX(touch.Position.X) end
                end)
            else
                transMoveConn = UserInputService.InputChanged:Connect(function(changed)
                    if transInput and changed.UserInputType == Enum.UserInputType.MouseMovement then
                        ApplyTransX(changed.Position.X)
                    end
                end)
            end
            transEndConn = UserInputService.InputEnded:Connect(function(ended)
                if not transInput then return end
                if ended == transInput
                or (transInput.UserInputType == Enum.UserInputType.MouseButton1
                    and ended.UserInputType == Enum.UserInputType.MouseButton1) then
                    StopTransDrag()
                end
            end)
        end)
