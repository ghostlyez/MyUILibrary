    local M = { Id = 0, Loop = 0, ShellOn = false, Hidden = {} }
    -- Loops (idle outline) keep running normally while the window is shown, but pause while it is
    -- hidden or mid-transition so low-end devices never animate two things at once.
    local function SetLoops(active, delayT)
        M.Loop = M.Loop + 1
        local token = M.Loop
        if not active then
            for _, t in pairs(MotionLoops) do pcall(function() t:Pause() end) end
            return
        end
        task.delay(delayT or 0, function()
            if token ~= M.Loop then return end
            if not MainFrame.Visible or Window._isMinimized then return end
            -- start the loops a few per frame instead of all in one frame (no hitch on restore)
            local started = 0
            for name, t in pairs(MotionLoops) do
                if token ~= M.Loop then return end
                if not (name == "Outline" and WindowFlags.NoOutline) then
                    pcall(function() t:Play() end)
                    started = started + 1
                    if started % 2 == 0 then task.wait() end
                end
            end
        end)
    end
    MainFrame:GetPropertyChangedSignal("Visible"):Connect(function()
        if MainFrame.Visible then SetLoops(true, 0.8) else SetLoops(false) end
    end)

    -- "Shell mode": while the window scales, only its cheap background shell is drawn. Hundreds of
