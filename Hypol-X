    -- User-chosen multiplier (Settings > UI Scale), applied on top of the automatic device scale.
    local UserUIScale = 1
    local ScaleHooks, ScaleToken = {}, 0
    local function ApplyGlobalScale()
        if GlobalUIScale and GlobalUIScale.Parent then
            local s = math.max(ComputeUIScale() * UserUIScale, 0.05)
            GlobalUIScale.Scale = s
            ActiveGlobalScale = s
            Host.Size = UDim2.new(1 / s, 0, 1 / s, 0)
            ScaleToken = ScaleToken + 1
            local tk = ScaleToken
            task.delay(0.06, function()
                if tk == ScaleToken then for _, fn in ipairs(ScaleHooks) do pcall(fn) end end
            end)
        end
    end
    ApplyGlobalScale()

    local function BindCamera()
        if viewportConn then viewportConn:Disconnect() end
        local cam = workspace.CurrentCamera
        if cam then
            viewportConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(ApplyGlobalScale)
        end
        ApplyGlobalScale()
    end
