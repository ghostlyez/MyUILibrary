                    local Shell = Create("Frame",{Parent=TxtFrame,BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,
                        Size=UDim2.new(1,-20,0,32),Position=UDim2.new(0,10,0,20),ClipsDescendants=true,Active=true})
                    Create("UICorner",{Parent=Shell,CornerRadius=UDim.new(0,8)})
                    Create("UIGradient",{Parent=Shell,Rotation=90,Color=ColorSequence.new(Color3.fromRGB(40,41,52),Color3.fromRGB(22,23,30))})
                    
                    local ShellStroke = Create("UIStroke",{Parent=Shell,Color=Color3.fromRGB(70,72,86),Thickness=1.5,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
                    
                    local Input = Create("TextBox",{Parent=Shell,PlaceholderText=placeholder or "Type here...",Text=(type(infoData)=="table" and infoData.DefaultValue ~= nil) and tostring(infoData.DefaultValue) or "",
                        Font=Enum.Font.GothamMedium,TextSize=13,TextColor3=INPUT_TEXT,BackgroundTransparency=1,
                        Size=UDim2.new(1,-16,1,0),Position=UDim2.new(0,12,0,0),TextXAlignment=Enum.TextXAlignment.Left,
                        ClearTextOnFocus=false,ClipsDescendants=true, ZIndex=3})
                    
                    local Clear = Create("TextButton",{Parent=Shell,Text="×",Font=Enum.Font.GothamBold,TextSize=16,TextColor3=Color3.fromRGB(150,152,166),
                        BackgroundTransparency=1,Size=UDim2.new(0,24,1,0),AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-4,0,0),
                        Visible=false,AutoButtonColor=false, ZIndex=4})
                    
                    Input.Focused:Connect(function()
                        Tween(ShellStroke, { Color = Color3.fromRGB(120,124,148), Thickness = 2 }, TI.Fast)
                    end)
                    Input.FocusLost:Connect(function()
                        Tween(ShellStroke, { Color = Color3.fromRGB(70,72,86), Thickness = 1.5 }, TI.Fast)
                    end)

                    local ShellBtn = Create("TextButton",{Parent=Shell,Text="",BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),ZIndex=2})
                    ShellBtn.MouseButton1Click:Connect(function() Input:CaptureFocus() end)
                    Input:GetPropertyChangedSignal("Text"):Connect(function() Clear.Visible = Input.Text ~= "" end)

                    -- Options (all optional, via the info table): DefaultValue, Numeric, MinValue, MaxValue,
                    -- AllowEmpty, SubmitOnEnter (callback only fires when Enter is pressed - ideal for command boxes).
                    local opts = type(infoData) == "table" and infoData or {}
                    local lastValid = Input.Text
                    local function sanitize(v)
                        v = tostring(v)
                        if opts.Numeric then
                            if v == "" then return opts.AllowEmpty and "" or lastValid end
                            local n = tonumber(v)
                            if not n or n ~= n or n == math.huge or n == -math.huge then return lastValid end
                            if opts.MinValue then n = math.max(opts.MinValue, n) end
                            if opts.MaxValue then n = math.min(opts.MaxValue, n) end
                            return tostring(n)
                        end
                        return v
                    end
                    local function internalSet(v)
                        local clean = sanitize(v)
                        Input.Text = clean
                        lastValid = clean
                        if opts.SubmitOnEnter then return end -- programmatic Set only updates the text
                        if callback then callback(opts.Numeric and clean ~= "" and tonumber(clean) or clean) end
                    end
                    Clear.MouseButton1Click:Connect(function() Input.Text = ""; if not opts.SubmitOnEnter and callback then callback("") end end)
                    Input.FocusLost:Connect(function(enterPressed)
                        if opts.SubmitOnEnter then
                            if enterPressed and callback then callback(Input.Text) end
                        else
                            internalSet(Input.Text)
                        end
                    end)

                    do
                        local tw = MeasureTitleWidth(name)
                        AddInfoIcon(TxtFrame, UDim2.new(0, 10+tw+5, 0, 0), infoData)
                    end
                    Window.ConfigElements[name] = { Set=internalSet, Get=function() return Input.Text end, Default=Input.Text }
                    return { Set = function(_, v) internalSet(v) end, Get = function() return Input.Text end, Instance = Input }
                end

                -- ------------------------------------------------------------
