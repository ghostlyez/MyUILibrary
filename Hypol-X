        local GlitchFX = { On = false, Busy = setmetatable({}, { __mode = "k" }), Pool = {}, PoolAt = 0, Serial = 0 }
        local LEET = { a = "4", e = "3", i = "1", o = "0", s = "5", t = "7", l = "1", b = "8", g = "9" }
        local CORRUPT = { "#", "/", "\\", "0", "1", "░", "▒", ">", "_", "<" }
        local function Scramble(txt, p)
            local out = {}
            for ch in txt:gmatch(utf8.charpattern) do
                if ch:match("%a") and math.random() < p then
                    if p > 0.72 and math.random() < 0.24 then
                        out[#out + 1] = CORRUPT[math.random(1, #CORRUPT)]
                    else
                        out[#out + 1] = LEET[ch:lower()] or (math.random() < 0.5 and "1" or "0")
                    end
                else
                    out[#out + 1] = ch
                end
            end
            return table.concat(out)
        end
        function GlitchFX.Hit(lbl)
            if not GlitchFX.On or GlitchFX.Busy[lbl] or not lbl.Parent then return end
            if lbl.MaxVisibleGraphemes ~= -1 then return end -- never compete with the restore typewriter
            local base = lbl.Text
            if #base < 2 or #base > 72 or base:find("\n") then return end
            GlitchFX.Busy[lbl] = true
            task.spawn(function()
                local last = base
                local seq = { 0.98, 0.22, 0.92, 0.48, 0.99, 0.14, 0.78, 0 }
                for _, strength in ipairs(seq) do
                    if not GlitchFX.On or not lbl.Parent or lbl.Text ~= last then break end
                    last = strength == 0 and base or Scramble(base, strength)
                    lbl.Text = last
                    task.wait(0.034)
                end
                if lbl.Parent and lbl.Text == last then lbl.Text = base end
                GlitchFX.Busy[lbl] = nil
            end)
        end
        function GlitchFX.Refresh()
            local pool = {}
            local function AncestorsVisible(d)
                local p = d.Parent
                while p and p ~= MainFrame do
                    if p:IsA("GuiObject") and not p.Visible then return false end
                    p = p.Parent
                end
                return p == MainFrame
            end
            for _, d in ipairs(MainFrame:GetDescendants()) do
                if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible and d.TextTransparency < 0.8
                    and d.AbsoluteSize.X > 20 and d.MaxVisibleGraphemes == -1
                    and d.Name ~= "HackerRain" and not d:GetAttribute("NoGlitch") and not d:IsA("TextBox")
                    and AncestorsVisible(d) then
                    pool[#pool + 1] = d
                end
            end
            GlitchFX.Pool = pool
            GlitchFX.PoolAt = os.clock()
