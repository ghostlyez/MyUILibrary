                if not IsClosing() then Tween(TileScale, { Scale = 1 }, TweenInfo.new(0.3, Enum.EasingStyle.Back)) end
            end)
            for _ = 1, 3 do
                if IsClosing() then return end
                Tween(Stroke, { Transparency = 0, Thickness = 2 }, TweenInfo.new(0.08)).Completed:Wait()
                if IsClosing() then return end
                Tween(Stroke, { Transparency = 0.7, Thickness = 1.2 }, TweenInfo.new(0.14)).Completed:Wait()
            end
            if not IsClosing() then Tween(Stroke, { Transparency = 0.3, Thickness = 1.2 }, TI.Fast) end
        end)
    end

    local pt = TweenService:Create(Fill, TweenInfo.new(displayTime, Enum.EasingStyle.Linear), { Size = UDim2.new(0,0,1,0) })
    pt:Play()
    pt.Completed:Connect(dismiss)
end

function Library:Notify(options)
    options = options or {}
    if not NotificationsEnabled then return end
    createCyberNotification(
        options.Title or "Notification",
        options.Desc or options.Description or "Information.",
        options.Be or "Success",
        options.Duration or DEFAULT_DISPLAY_TIME
    )
end

