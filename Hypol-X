-- [[ DROPDOWN FIELD KIT — select-style field (looks like a dropdown, not a button) ]]
-- ============================================================
local FIELD_BG          = Color3.fromRGB(13, 14, 18)
local FIELD_BG_HOVER    = Color3.fromRGB(19, 20, 26)
local FIELD_STROKE      = Color3.fromRGB(52, 54, 66)
local FIELD_STROKE_HOT  = Color3.fromRGB(120, 124, 148)
local FIELD_PLACEHOLDER = Color3.fromRGB(128, 130, 146)

-- Chevron drawn from two rounded bars (no font/asset dependency, crisp at any scale).
local function CreateChevron(parent, color, zIndex, size)
    size = size or 10
    local holder = Create("Frame", {
        Name = "Chevron", Parent = parent, BackgroundTransparency = 1,
        Size = UDim2.new(0, size, 0, size), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0), ZIndex = zIndex or 5,
    })
    local bars = {}
    for i = 1, 2 do
        local bar = Create("Frame", {
            Parent = holder, BackgroundColor3 = color, BorderSizePixel = 0,
            Size = UDim2.new(0, math.ceil(size * 0.62), 0, 2),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(i == 1 and 0.27 or 0.73, 0, 0.5, 0),
            Rotation = i == 1 and 45 or -45, ZIndex = zIndex or 5,
        })
        Create("UICorner", { Parent = bar, CornerRadius = UDim.new(1, 0) })
        bars[i] = bar
    end
    return holder, bars
end

-- Builds the select-field chrome behind a transparent TextButton: inset body, hairline
-- border, soft top highlight, separated chevron chip. Returns a controller table.
local function StyleDropdownField(button, cornerRadius)
    cornerRadius = cornerRadius or 8
    button.AutoButtonColor = false
    button.BackgroundTransparency = 1
    local surface = Create("Frame", {
        Name = "__DarkGradientSurface_" .. button.Name, Parent = button.Parent,
        Position = button.Position, AnchorPoint = button.AnchorPoint, Size = button.Size,
        BackgroundColor3 = FIELD_BG, BorderSizePixel = 0, Active = false, Selectable = false,
        ZIndex = math.max(1, button.ZIndex - 1), LayoutOrder = button.LayoutOrder,
    })
    Create("UICorner", { Parent = surface, CornerRadius = UDim.new(0, cornerRadius) })
    local stroke = Create("UIStroke", {
        Parent = surface, Color = FIELD_STROKE, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
    Create("UIGradient", {
        Parent = surface, Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(205, 206, 214)),
        }),
    })
    -- Top hairline highlight gives the inset a "pressed-in glass" feel.
    local shine = Create("Frame", {
        Parent = surface, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.93,
        BorderSizePixel = 0, Size = UDim2.new(1, -16, 0, 1), Position = UDim2.new(0, 8, 0, 1),
        ZIndex = surface.ZIndex + 1,
    })

    -- UIPadding insets child coordinates, so compensate to keep the chip flush right.
    local padObj = button:FindFirstChildOfClass("UIPadding")
    local padRight = padObj and padObj.PaddingRight.Offset or 0
    -- Chevron chip on the right: the universal select affordance.
    local chip = Create("Frame", {
        Name = "ChevronChip", Parent = button, BackgroundColor3 = Color3.fromRGB(30, 31, 40),
        BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0.5),
        Size = UDim2.new(0, 22, 1, -8), Position = UDim2.new(1, padRight - 4, 0.5, 0), ZIndex = button.ZIndex + 1,
    })
    Create("UICorner", { Parent = chip, CornerRadius = UDim.new(0, math.max(4, cornerRadius - 3)) })
    local chipStroke = Create("UIStroke", { Parent = chip, Color = Color3.fromRGB(62, 64, 78), Thickness = 1, Transparency = 0.4 })
    local arrow, bars = CreateChevron(chip, SubTextColor, button.ZIndex + 2, 10)

    local ctl = { Surface = surface, Stroke = stroke, Chip = chip, Arrow = arrow, Open = false }
    function ctl.Refresh(hover)
        local open = ctl.Open
        local strokeColor = open and AccentColor or (hover and FIELD_STROKE_HOT or FIELD_STROKE)
        Tween(stroke, { Color = strokeColor, Transparency = open and 0.1 or 0 }, TI.Fast)
        Tween(surface, { BackgroundColor3 = (open or hover) and FIELD_BG_HOVER or FIELD_BG }, TI.Fast)
        Tween(chip, { BackgroundColor3 = open and AccentColor or Color3.fromRGB(30, 31, 40) }, TI.Fast)
        Tween(chipStroke, { Transparency = open and 1 or 0.4 }, TI.Fast)
        for _, bar in ipairs(bars) do
            Tween(bar, { BackgroundColor3 = open and Color3.fromRGB(16, 16, 20) or (hover and TextColor or SubTextColor) }, TI.Fast)
        end
    end
    function ctl.SetOpen(open)
        ctl.Open = open and true or false
        ctl.Refresh(false)
        Tween(arrow, { Rotation = ctl.Open and 180 or 0 },
            TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
    end
    button.MouseEnter:Connect(function() ctl.Refresh(true) end)
    button.MouseLeave:Connect(function() ctl.Refresh(false) end)
    return ctl
end

-- Shared glass-edge stroke gradient (rotating shimmer-free, static, cheap).
local function AddGlassStroke(stroke, accentFirst)
    local g = Create("UIGradient", { Parent = stroke, Rotation = 135 })
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, accentFirst and AccentColor or Color3.fromRGB(120, 122, 140)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(46, 47, 58)),
        ColorSequenceKeypoint.new(1, accentFirst and Color3.fromRGB(110, 72, 210) or Color3.fromRGB(70, 72, 88)),
    })
    return g
end

-- Bottom fade sits beside (not inside) a UIListLayout-backed ScrollingFrame so
-- it cannot be laid out as an item or steal scrolling/selection input.
local function CreateBottomFade(parent, position, size, zIndex, fadeColor)
    fadeColor = fadeColor or BackgroundColor
    local fade = Create("Frame", {
        Parent = parent, Position = position, Size = size,
        BackgroundColor3 = fadeColor, BackgroundTransparency = 0,
        BorderSizePixel = 0, ZIndex = zIndex or 20,
        Active = false, Selectable = false, Visible = false,
    })
    Create("UIGradient", {
        Parent = fade, Rotation = 90,
        Color = ColorSequence.new(fadeColor, fadeColor),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0),
        }),
    })
    return fade
end

local function BindBottomFade(scroller, fade, isOpen, shouldShow)
    local function refresh()
        if not scroller or not scroller.Parent or not fade or not fade.Parent then return end
        local canvasHeight = math.max(scroller.CanvasSize.Y.Offset, scroller.AbsoluteCanvasSize.Y)
        local visibleHeight = scroller.AbsoluteWindowSize.Y
        local maxY = math.max(0, canvasHeight - visibleHeight)
        local open = not isOpen or isOpen()
        local enoughItems = not shouldShow or shouldShow()
        fade.Visible = open and enoughItems and scroller.Visible and maxY > 1
            and scroller.CanvasPosition.Y < maxY - 1
    end
    local connections = {
        scroller:GetPropertyChangedSignal("CanvasPosition"):Connect(refresh),
        scroller:GetPropertyChangedSignal("CanvasSize"):Connect(refresh),
        scroller:GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh),
        scroller:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(refresh),
        scroller:GetPropertyChangedSignal("Visible"):Connect(refresh),
    }
    refresh()
    return refresh, connections
end

-- Shared square/check toggle visuals. Feature code owns its state and callbacks.
local function CreateSquareToggle(parent, position, initialState, size)
    local isOn = initialState and true or false
    -- 1.1x larger than before, and no check mark: the gradient fill (it pops in) is the ON state.
    local baseSize = size or UDim2.new(0, 18, 0, 18)
    local baseW, baseH = baseSize.X.Offset, baseSize.Y.Offset
    local newW, newH = baseW * 1.1, baseH * 1.1
    local button = Create("TextButton", {
        Parent = parent,
        Text = "",
        BackgroundColor3 = ToggleBaseColor,
        BorderSizePixel = 0,
        Size = UDim2.new(baseSize.X.Scale, newW, baseSize.Y.Scale, newH),
        Position = UDim2.new(position.X.Scale, position.X.Offset - (newW - baseW),
            position.Y.Scale, position.Y.Offset - (newH - baseH) / 2),
        AutoButtonColor = false,
        ClipsDescendants = true,
    })
    Create("UICorner", { Parent = button, CornerRadius = UDim.new(0, 4) })
    local TG_EDGE_OFF, TG_EDGE_ON = Color3.fromRGB(78, 80, 95), Color3.fromRGB(128, 131, 150)
    local toggleStroke = Create("UIStroke", { Parent = button, Color = isOn and TG_EDGE_ON or TG_EDGE_OFF, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
    Library.GreyOutline(toggleStroke)

    local fill = Create("Frame", {
        Name = "CheckedFill",
        Parent = button,
        BackgroundColor3 = ToggleGradientEnd,
        BackgroundTransparency = isOn and 0 or 1,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0.8, 0, 0.8, 0),
        Rotation = isOn and 0 or -120,
        ZIndex = button.ZIndex + 1,
    })
    local fillCorner = Create("UICorner", { Parent = fill, CornerRadius = UDim.new(0, isOn and 3 or 10) })
    Create("UIGradient", {
        Parent = fill,
        Rotation = 45,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, ToggleGradientStart),
            ColorSequenceKeypoint.new(1, ToggleGradientEnd),
        }),
    })
    -- UIScale grows from the AnchorPoint (centre), so the fill always blooms from the middle.
    local fillScale = Create("UIScale", { Parent = fill, Scale = isOn and 1 or 0 })
    AddBounce(button, 0.96)
    button.Activated:Connect(function()
        PlayUISound(UI_SOUND_IDS.Toggle)
    end)

    local token = 0
    local bloomInfo = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local spinInfo  = TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local function Burst()
        -- shockwave ring + white core flash, both born at the exact centre
        local ring = Create("Frame", { Parent = button, BackgroundTransparency = 1, BorderSizePixel = 0, Active = false,
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 2, 0, 2),
            ZIndex = fill.ZIndex + 2 })
        Create("UICorner", { Parent = ring, CornerRadius = UDim.new(1, 0) })
        local rs = Create("UIStroke", { Parent = ring, Color = ToggleGradientStart, Thickness = 2, Transparency = 0.05 })
        local ri = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        Tween(ring, { Size = UDim2.new(0, newW * 1.5, 0, newW * 1.5) }, ri)
        Tween(rs, { Transparency = 1, Thickness = 0.5 }, ri)
        local core = Create("Frame", { Parent = button, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.15,
            BorderSizePixel = 0, Active = false, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0, 3, 0, 3), ZIndex = fill.ZIndex + 3 })
        Create("UICorner", { Parent = core, CornerRadius = UDim.new(1, 0) })
        local ci = TweenInfo.new(0.38, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        Tween(core, { Size = UDim2.new(0, newW * 0.9, 0, newW * 0.9), BackgroundTransparency = 1 }, ci)
        task.delay(0.6, function() ring:Destroy(); core:Destroy() end)
    end

    local function SetVisual(enabled)
        token = token + 1
        local my = token
        Tween(toggleStroke, { Color = enabled and TG_EDGE_ON or TG_EDGE_OFF }, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
        if enabled then
            fill.BackgroundTransparency = 0
            fillScale.Scale = 0
            fill.Rotation = -120
            fillCorner.CornerRadius = UDim.new(0, 10)
            Tween(fillScale, { Scale = 1 }, bloomInfo)
            Tween(fill, { Rotation = 0 }, spinInfo)
            Tween(fillCorner, { CornerRadius = UDim.new(0, 3) }, spinInfo)
            Burst()
        else
            Tween(fillScale, { Scale = 0 }, TweenInfo.new(0.26, Enum.EasingStyle.Back, Enum.EasingDirection.In))
            Tween(fill, { Rotation = 100 }, TweenInfo.new(0.26, Enum.EasingStyle.Quad, Enum.EasingDirection.In))
            Tween(fillCorner, { CornerRadius = UDim.new(0, 10) }, TI.Fast)
            task.delay(0.27, function()
                if token == my then fill.BackgroundTransparency = 1 end
            end)
        end
    end

    return button, SetVisual
end

-- ============================================================
-- [[ CLEAN INPUT KIT — calm, modern text fields (no neon / accent glow while typing) ]]
-- ============================================================
local INPUT_BG           = Color3.fromRGB(17, 18, 23)
local INPUT_BG_FOCUS     = Color3.fromRGB(22, 23, 29)
local INPUT_STROKE       = Color3.fromRGB(78, 80, 95)
local INPUT_STROKE_FOCUS = Color3.fromRGB(142, 145, 165)
local INPUT_TEXT         = Color3.fromRGB(222, 224, 232)
local INPUT_PLACEHOLDER  = Color3.fromRGB(108, 110, 124)

-- Shared GREY OUTLINE helper. The stroke-judge further down disables every low-saturation UIStroke,
-- which is why grey outlines looked "missing". zx_keep exempts it; Enabled/Transparency are forced on.
function Library.GreyOutline(stroke, color)
    if not stroke then return end
    stroke:SetAttribute("zx_keep", true)
    stroke.Enabled = true
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.LineJoinMode = Enum.LineJoinMode.Round
    stroke.Thickness = 1
    stroke.Transparency = 0
    if color then stroke.Color = color end
end

-- Applies one consistent, quiet style to a TextBox. While editing, the text keeps the same
-- soft color, has no text stroke, and focus only brightens the neutral border slightly.
-- `stroke` is the field's UIStroke (optional); `surface` is the frame that paints the field
-- background when that is not the TextBox itself (optional).
local function StyleCleanInput(box, stroke, surface, opts)
    surface = surface or box
    opts = opts or {}
    local restStroke = opts.Stroke or INPUT_STROKE
    local focusStroke = opts.StrokeFocus or INPUT_STROKE_FOCUS
    box.Font = Enum.Font.GothamMedium
    box.TextColor3 = opts.Text or INPUT_TEXT
    box.TextTransparency = 0
    box.TextStrokeTransparency = 1
    box.PlaceholderColor3 = INPUT_PLACEHOLDER
    box.ClearTextOnFocus = false
    local paintsBackground = surface.BackgroundTransparency < 1
    if paintsBackground then surface.BackgroundColor3 = INPUT_BG end
    -- Every text field gets a greyish-dark outline, even if the caller did not make one.
    if not stroke then
        stroke = surface:FindFirstChildOfClass("UIStroke") or box:FindFirstChildOfClass("UIStroke")
        if not stroke then
            stroke = Instance.new("UIStroke"); stroke.Parent = surface
            if not surface:FindFirstChildOfClass("UICorner") then
                local cr = Instance.new("UICorner"); cr.CornerRadius = UDim.new(0, 6); cr.Parent = surface
            end
        end
    end
    Library.GreyOutline(stroke, restStroke)
    box.Focused:Connect(function()
        if stroke then Tween(stroke, { Color = focusStroke }, TI.Fast) end
        if paintsBackground then Tween(surface, { BackgroundColor3 = INPUT_BG_FOCUS }, TI.Fast) end
    end)
    box.FocusLost:Connect(function()
        if stroke then Tween(stroke, { Color = restStroke }, TI.Fast) end
        if paintsBackground then Tween(surface, { BackgroundColor3 = INPUT_BG }, TI.Fast) end
    end)
end

-- ============================================================
-- [[ KEY CHIP — simple keybind button: flat rounded chip, quiet border, accent only while listening ]]
-- ============================================================
local KEY_ALIAS = {
    LeftControl="LCtrl", RightControl="RCtrl", LeftShift="LShift", RightShift="RShift",
    LeftAlt="LAlt", RightAlt="RAlt", Return="Enter", Backspace="Bksp", Escape="Esc",
    Insert="Ins", Delete="Del", PageUp="PgUp", PageDown="PgDn", CapsLock="Caps",
    Backquote="`", LeftBracket="[", RightBracket="]", Semicolon=";", Quote="'",
    Comma=",", Period=".", Slash="/", BackSlash="\\", Equals="=", Minus="-",
}
-- Short, readable names for the chip face (stored key names are unchanged).
local function DisplayKeyName(keyName)
    keyName = tostring(keyName or "...")
    return KEY_ALIAS[keyName] or keyName
end

local KEY_CHIP_BG        = Color3.fromRGB(30, 31, 38)
local KEY_CHIP_BG_HOVER  = Color3.fromRGB(40, 42, 52)
local KEY_CHIP_BG_LISTEN = Color3.fromRGB(34, 30, 50)
local KEY_CHIP_STROKE    = Color3.fromRGB(58, 60, 74)

-- Returns { Button, SetKey(keyName), SetListening(bool) }. The chip is anchored by its
-- right edge (AnchorPoint 1,0.5) so `position` refers to the chip's right-center.
local function CreateKeyChip(parent, position, keyName, width)
    width = width or 56
    local current = keyName
    local hovering, listening = false, false
    local chip = Create("TextButton", {
        Parent = parent, Text = DisplayKeyName(current), Font = Enum.Font.GothamMedium, TextSize = 11,
        TextColor3 = TextColor, BackgroundColor3 = KEY_CHIP_BG, BorderSizePixel = 0,
        Size = UDim2.new(0, width, 0, 22), Position = position, AnchorPoint = Vector2.new(1, 0.5),
        AutoButtonColor = false, ClipsDescendants = true,
    })
    Create("UICorner", { Parent = chip, CornerRadius = UDim.new(0, 6) })
    Create("UIPadding", { Parent = chip, PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5) })
    local stroke = Create("UIStroke", {
        Parent = chip, Color = KEY_CHIP_STROKE, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
    AddBounce(chip, 0.95)

    local function refresh()
        if listening then
            Tween(chip, { BackgroundColor3 = KEY_CHIP_BG_LISTEN, TextColor3 = AccentColor }, TI.Fast)
            Tween(stroke, { Color = AccentColor }, TI.Fast)
        else
            Tween(chip, { BackgroundColor3 = hovering and KEY_CHIP_BG_HOVER or KEY_CHIP_BG, TextColor3 = TextColor }, TI.Fast)
            Tween(stroke, { Color = hovering and FIELD_STROKE_HOT or KEY_CHIP_STROKE }, TI.Fast)
        end
    end
    chip.MouseEnter:Connect(function() hovering = true; refresh() end)
    chip.MouseLeave:Connect(function() hovering = false; refresh() end)

    local api = { Button = chip }
    function api.SetKey(newKeyName)
        current = newKeyName
        if not listening then chip.Text = DisplayKeyName(current) end
    end
    function api.SetListening(on)
        listening = on and true or false
        chip.Text = listening and "..." or DisplayKeyName(current)
        refresh()
    end
    return api
end

