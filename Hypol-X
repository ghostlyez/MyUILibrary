        -- Read the game's own values and snap the sliders to them (also after every respawn).
        local function Bind(h)
            for _, c in ipairs(conns.hum or {}) do c:Disconnect() end
            conns.hum = {}
            hum = h
            Speed.orig = h.WalkSpeed
            Jump.orig = GetJump(h)
            Speed.max = math.max(200, math.ceil(Speed.orig * 2))
            Jump.max = math.max(250, math.ceil(Jump.orig * 2))
            if not Speed.on then Speed.Display(Speed.hasSelection and Speed.val or Speed.orig, false) else Speed.Display(Speed.val, false); Speed.Apply() end
            if not Jump.on then Jump.Display(Jump.hasSelection and Jump.val or Jump.orig, false) else Jump.Display(Jump.val, false); Jump.Apply() end
            local function Watch(prop, S, setter, getter)
                table.insert(conns.hum, h:GetPropertyChangedSignal(prop):Connect(function()
                    if applying then return end
                    if S.on then S.Apply() else
                        S.orig = getter(h)
                        -- An intentional slider selection remains visible while OFF, even if
                        -- the baseline property-change event arrives just after a toggle-off.
                        if not S.hasSelection then S.Display(S.orig, false) end
                    end
                end))
            end
            Watch("WalkSpeed", Speed, nil, function(x) return x.WalkSpeed end)
            Watch("JumpPower", Jump, nil, GetJump)
            Watch("JumpHeight", Jump, nil, GetJump)
