        -- ===== Exploiter theme VFX: crimson/violet packet rings, moving scanline, and edge telemetry =====
        -- This is presentation-only and stays inside the existing background groups / window lifecycle.
        local ExploiterFX = { State = nil, On = false }
        local function BuildExploiterFX(state)
            local groups = { LeftBackgroundGroup, RightBackgroundGroup }
            local KC, KN = ColorSequenceKeypoint.new, NumberSequenceKeypoint.new
            local RED = Color3.fromRGB(255, 38, 78)
            local VIOLET = Color3.fromRGB(145, 73, 255)
            local ICE = Color3.fromRGB(255, 190, 214)
            local function Loop(key, target, goal, duration, reverse)
                local info = TweenInfo.new(duration, Enum.EasingStyle.Sine,
                    reverse and Enum.EasingDirection.InOut or Enum.EasingDirection.Out, -1, reverse == true)
                local tw = TweenService:Create(target, info, goal)
                state.Loops[#state.Loops + 1] = tw
