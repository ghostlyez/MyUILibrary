        local function Finalize()
            holdToken = holdToken + 1
            Tween(Sphere, { BackgroundColor3 = sphereOriginalColor }, TI.Fade)
            activeInput = nil
            activeInputType = nil
            dragging = false
            if activeChangedConn then activeChangedConn:Disconnect(); activeChangedConn = nil end
            if activeEndConn then activeEndConn:Disconnect(); activeEndConn = nil end
        end
        local function MoveSphere(position)
            if not activeInput then return end
            local delta = (position - dragStart) / ActiveGlobalScale
            if SphereLock.On then return end -- locked: stays put but can still be opened
            if delta.Magnitude > 3 then
                dragging = true
                Sphere:SetAttribute("Dragging", true)
            end
            if dragging and Sphere.Parent then
                Sphere.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
        Sphere.InputBegan:Connect(function(input)
            if activeInput then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
            activeInput = input
            activeInputType = input.UserInputType
            dragging = false
            dragStart = input.Position
            startPos = Sphere.Position
            Sphere:SetAttribute("Dragging", false)
            holdToken = holdToken + 1
            local myToken, myInput = holdToken, input
            task.delay(3, function()
                if holdToken ~= myToken or activeInput ~= myInput or dragging or not Sphere.Parent then return end
                SphereLock.Set(not SphereLock.On)
                Sphere:SetAttribute("Dragging", true) -- swallow the release so it does not restore the window
