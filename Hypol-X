                local ratio = count > 0 and (done / count) or 1
                SetLoadingProgress(0.08 + 0.68 * ratio, "Retrying assets " .. done .. " / " .. count .. "...")
            end)
        end
        if loadingState.finalized or loadingState.buildFailed or loadingState.timedOut then return end
        loadingState.preloadDone = true
        loadingState.failedAssets = failed or 0
        loadingState.preloadSuccess = ok and (failed or 0) == 0
        if not ok then
