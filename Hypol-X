        -- ===== Complex code / thinking pattern for Exploiter + Hacker backgrounds =====
        SpaceFX.Pat = { States = {}, Specs = {
            Exploiter = { A = Color3.fromRGB(255, 52, 92), B = Color3.fromRGB(150, 104, 255), C = Color3.fromRGB(255, 170, 188), Seed = 31 },
            Hacker = { A = Color3.fromRGB(40, 255, 120), B = Color3.fromRGB(0, 190, 86), C = Color3.fromRGB(196, 255, 214), Seed = 47 },
        } }
        function SpaceFX.Pat.Build(name, spec)
            local st = { Roots = {}, Loops = {} }
            local rng = Random.new(spec.Seed)
            local function hex(c) return string.format("#%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end
            local HA, HB, HC, HD = hex(spec.A), hex(spec.B), hex(spec.C), hex(spec.A:Lerp(Color3.new(0, 0, 0), 0.45))
            local KW = { "local", "function", "return", "if", "then", "else", "for", "while", "do", "not", "and", "or", "pcall" }
            local ID = { "payload", "hook", "stack", "ptr", "reg", "buf", "sock", "proc", "ctx", "node", "token", "kernel", "vec", "seed", "mask", "cache", "thread", "opcode", "frame", "pipe" }
            local ASM = { "mov", "xor", "jmp", "call", "push", "pop", "cmp", "lea", "shl", "ret" }
            local REG = { "eax", "ebx", "ecx", "edx", "rsi", "rdi", "rsp", "r8", "r9" }
            local WORDS = { "scan", "inject", "decrypt", "route", "trace", "bypass", "sync", "probe", "resolve" }
            local function pick(t) return t[rng:NextInteger(1, #t)] end
            local function hx() return string.format("0x%02X", rng:NextInteger(0, 0xFFFFFF)) end
            local function rich(c, t) return '<font color="' .. c .. '">' .. t .. "</font>" end
            local function Line()
                local ind = string.rep("  ", rng:NextInteger(0, 3))
                local k, h = rng:NextInteger(1, 7), hx()
                local a, b, c = pick(KW), pick(ID), pick(ID)
                if k == 1 then
                    return ind .. a .. " " .. b .. " = " .. c .. "(" .. h .. ")", ind .. rich(HA, a) .. " " .. rich(HC, b) .. " = " .. rich(HC, c) .. "(" .. rich(HB, h) .. ")"
                elseif k == 2 then
                    return ind .. "if " .. b .. " ~= " .. h .. " then " .. c .. "() end", ind .. rich(HA, "if") .. " " .. rich(HC, b) .. " ~= " .. rich(HB, h) .. " " .. rich(HA, "then") .. " " .. rich(HC, c) .. "() " .. rich(HA, "end")
                elseif k == 3 then
                    local t = "-- " .. pick(WORDS) .. " " .. b
                    return ind .. t, ind .. rich(HD, t)
                elseif k == 4 then
                    return ind .. b .. "[" .. h .. "] = " .. c .. " ~ " .. hx(), ind .. rich(HC, b) .. "[" .. rich(HB, h) .. "] = " .. rich(HC, c) .. " ~ " .. rich(HB, h)
                elseif k == 5 then
                    local m, r = pick(ASM), pick(REG)
                    return ind .. m .. " " .. r .. ", " .. h, ind .. rich(HA, m) .. " " .. rich(HC, r) .. ", " .. rich(HB, h)
                elseif k == 6 then
                    return ind .. "return " .. b .. "(" .. c .. ", " .. pick(ID) .. ")", ind .. rich(HA, "return") .. " " .. rich(HC, b) .. "(" .. rich(HC, c) .. ")"
                end
                return ind .. "end", ind .. rich(HA, "end")
            end
            for gi, g in ipairs({ { LeftBackgroundGroup, 1, 6 }, { RightBackgroundGroup, 2, 11 } }) do
                local group, cols, nodeCount = g[1], g[2], g[3]
                local W, H = group.AbsoluteSize.X, group.AbsoluteSize.Y
                if W < 60 then W = gi == 1 and 190 or 440 end
                if H < 60 then H = 420 end
                local root = Create("Frame", { Name = "PatternFX_" .. name .. gi, Parent = group, BackgroundTransparency = 1, BorderSizePixel = 0,
                    Active = false, ClipsDescendants = true, Size = UDim2.new(1, 0, 1, 0), ZIndex = 4, Visible = false })
                NoRemap[root] = true
                st.Roots[#st.Roots + 1] = root
                -- lattice of crosses / dots
                local rowsT = {}
                for r = 1, math.floor(H / 12) do
                    local cells = {}
                    for c = 1, math.floor(W / 16) do cells[c] = (c % 4 == 1 and r % 3 == 1) and "+  " or ".  " end
                    rowsT[r] = table.concat(cells)
                end
                NoRemap[Create("TextLabel", { Parent = root, BackgroundTransparency = 1, Text = table.concat(rowsT, "\n"), Font = Enum.Font.Code, TextSize = 10,
                    TextColor3 = spec.A, TextTransparency = 0.92, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
                    Size = UDim2.new(1, 0, 1, 0), ZIndex = 4, Active = false })] = true
                -- scrolling code columns (faded top/bottom)
                local colW = math.floor(W / cols) - 14
                for ci = 1, cols do
                    local plain, rch = {}, {}
                    for n = 1, 34 do plain[n], rch[n] = Line() end
                    local p1, r1 = table.concat(plain, "\n"), table.concat(rch, "\n")
                    local half = TextService:GetTextSize(p1 .. "\n", 9, Enum.Font.Code, Vector2.new(4000, 100000)).Y
                    local view = Create("CanvasGroup", { Parent = root, BackgroundTransparency = 1, BorderSizePixel = 0, Active = false,
                        Size = UDim2.new(0, colW, 1, 0), Position = UDim2.new(0, (ci - 1) * (colW + 14) + 8, 0, 0), ZIndex = 4 })
                    NoRemap[view] = true
                    Create("UIGradient", { Parent = view, Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1),
                        NumberSequenceKeypoint.new(0.18, 0), NumberSequenceKeypoint.new(0.82, 0), NumberSequenceKeypoint.new(1, 1) }) })
                    local down = ci % 2 == 0
                    local lbl = Create("TextLabel", { Parent = view, BackgroundTransparency = 1, RichText = true, Text = r1 .. "\n" .. r1 .. "\n",
                        Font = Enum.Font.Code, TextSize = 9, TextColor3 = WHITE, TextTransparency = 0.72 + ci * 0.04, TextXAlignment = Enum.TextXAlignment.Left,
                        TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = false, Size = UDim2.new(1, 0, 0, half * 2),
                        Position = UDim2.new(0, 0, 0, down and -half or 0), ZIndex = 4, Active = false })
                    NoRemap[lbl] = true
                    st.Loops[#st.Loops + 1] = TweenService:Create(lbl, TweenInfo.new(math.max(half / 13, 8), Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1, false),
                        { Position = UDim2.new(0, 0, 0, down and 0 or -half) })
                end
                -- neural / flow graph
                local pts = {}
                for n = 1, nodeCount do pts[n] = { x = rng:NextInteger(14, W - 14), y = rng:NextInteger(14, H - 14) } end
                local seen, edges = {}, {}
                for a = 1, nodeCount do
