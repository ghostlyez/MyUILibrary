    local function TryFinishLoading()
        if loadingState.finalized or loadingState.buildFailed or not loadingState.buildComplete then return end
        if not (loadingState.preloadDone or loadingState.timedOut) then return end
        if not loadingState.finishScheduled then
            loadingState.finishScheduled = true
            local remaining = introMinVisibleUntil - os.clock()
            if remaining > 0 then
                task.delay(remaining, function()
                    loadingState.finishScheduled = false
                    TryFinishLoading()
                end)
                return
            end
        end
        if loadingState.finalized then return end

        local completedCleanly = loadingState.preloadDone and loadingState.preloadSuccess and not loadingState.timedOut
        LoadingStatus.Text = (completedCleanly or loadingState.skipped) and "Ready" or "Loaded with fallback; some assets may be unavailable"
        loadingState.progress = 1
