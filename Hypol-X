    -- Global search stays scoped to the active page. Cards from other pages are
    -- restored to their original column instead of being moved into the active page.
    RefreshGlobalSearch = function()
        local q = SearchInput.Text:lower()
        for _, d in ipairs(Window.AllCards) do
            local searchGroup = d.Group or d.Card
            searchGroup.Parent = d.OrigParent
            if q ~= "" and d.Tab == Window.CurrentTab and d.Page == Window.CurrentTab.CurrentPage then
                if not d.SearchIndex then d.SearchIndex = BuildSearchIndex(searchGroup) end
                searchGroup.Visible = string.find(d.SearchIndex, q, 1, true) ~= nil
            else
                searchGroup.Visible = true
            end
        end
    end
