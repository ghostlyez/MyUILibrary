            end

            B.Red = function(st, root, i, th, r)
                for k = 1, 3 do Pulse(st, root, th.Accent, 0.5, 0.5, 4, 240 + k * 40, 1.1 + k * 0.45) end
                for k = 1, 10 do
                    Rise(st, root, k % 2 == 0 and th.Accent or Color3.fromRGB(255, 170, 60), 5, r:NextNumber(0.05, 0.95), r:NextNumber(0.05, 0.95), 1.05, 0.45, 1.6 + (k % 5) * 0.35)
