    local function SetShellMode(on)
        if on == M.ShellOn then return end
        M.ShellOn = on
        RS.ShellOn = on
        if on then
            if not M.Snap then M.Snap = RS.Snapshot() end
            M.Hidden = {}
            for _, child in ipairs(MainFrame:GetChildren()) do
                if child:IsA("GuiObject") and child ~= LeftBackgroundGroup and child ~= RightBackgroundGroup
                and child.Visible then
                    M.Hidden[#M.Hidden + 1] = child
                    child.Visible = false
                end
            end
        else
            for _, child in ipairs(M.Hidden) do
                if child and child.Parent then child.Visible = true end
            end
            M.Hidden = {}
        end
    end

