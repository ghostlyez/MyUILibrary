                end)
                if ApplyIntroTransparency then ApplyIntroTransparency() end
                -- shockwave ring + sparks from the window centre
                task.spawn(function()
                    local ring = Create("Frame", { Parent = Host, BackgroundTransparency = 1, BorderSizePixel = 0, Active = false,
                        Size = UDim2.new(0, 60, 0, 60), AnchorPoint = Vector2.new(0.5, 0.5), Position = main.Position, ZIndex = 120 })
                    Create("UICorner", { Parent = ring, CornerRadius = UDim.new(1, 0) })
                    local rs = Create("UIStroke", { Parent = ring, Color = Color3.new(1, 1, 1), Thickness = 4, Transparency = 0.1 })
                    local ri = TweenInfo.new(0.8, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                    Tween(ring, { Size = UDim2.new(0, 820, 0, 820) }, ri)
                    Tween(rs, { Transparency = 1, Thickness = 0.5 }, ri)
                    local rng = Random.new()
                    for i = 1, 18 do
                        local a = (i / 18) * math.pi * 2 + rng:NextNumber(-0.15, 0.15)
                        local dist = rng:NextNumber(180, 380)
                        local sz = rng:NextInteger(5, 10)
                        local spark = Create("Frame", { Parent = Host, BorderSizePixel = 0, Active = false, Rotation = 45,
                            BackgroundColor3 = (i % 2 == 0) and Color3.new(1, 1, 1) or AccentColor,
                            Size = UDim2.new(0, sz, 0, sz), AnchorPoint = Vector2.new(0.5, 0.5), Position = main.Position, ZIndex = 119 })
                        local c = main.Position
                        local si = TweenInfo.new(rng:NextNumber(0.55, 0.95), Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                        Tween(spark, { Position = UDim2.new(c.X.Scale, c.X.Offset + math.cos(a) * dist, c.Y.Scale, c.Y.Offset + math.sin(a) * dist),
                            BackgroundTransparency = 1, Size = UDim2.new(0, 2, 0, 2), Rotation = rng:NextInteger(-200, 200) }, si)
                        task.delay(1, function() spark:Destroy() end)
                    end
                    task.delay(0.9, function() ring:Destroy() end)
                    if RS.Sweep then task.delay(0.75, RS.Sweep) end
                end)
            end
            EnableWindowBlur()
        end

        task.delay(1.4, RS.Run)
