                -- Usage: Section:AddExecutor("Executor", { Title=..., Description=... }, { Height = 190, Placeholder = "..." })
                -- Run uses the environment's loadstring (same mechanism the library is loaded with).
                -- ------------------------------------------------------------
                function Elements:AddExecutor(name, infoData, opts)
                    opts = opts or {}
                    local boxH = opts.Height or 190
                    local Exec = Create("Frame",{Parent=ItemContainer,BackgroundTransparency=1,Size=UDim2.new(1,0,0,20+boxH+8+26)})
                    Create("TextLabel",{Parent=Exec,Text=name or "Executor",Font=Enum.Font.GothamBold,TextSize=12,
                        TextColor3=SubTextColor,BackgroundTransparency=1,Size=UDim2.new(1,-20,0,15),
                        Position=UDim2.new(0,10,0,0),TextXAlignment=Enum.TextXAlignment.Left})
                    do AddInfoIcon(Exec, UDim2.new(0, 10+MeasureTitleWidth(name or "Executor")+5, 0, 0), infoData) end

                    -- Editor shell (outlined, clipped) holding a vertical ScrollingFrame; the TextBox grows inside it.
                    local Shell = Create("Frame",{Parent=Exec,BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,
                        Size=UDim2.new(1,-20,0,boxH),Position=UDim2.new(0,10,0,20),ClipsDescendants=true})
                    Create("UICorner",{Parent=Shell,CornerRadius=UDim.new(0,10)})
                    Create("UIGradient",{Parent=Shell,Rotation=90,Color=ColorSequence.new(Color3.fromRGB(24,25,34),Color3.fromRGB(12,13,18))})
                    local ShellStroke = Create("UIStroke",{Parent=Shell,Color=INPUT_STROKE,Thickness=1.25,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
                    local Scroll = Create("ScrollingFrame",{Parent=Shell,BackgroundTransparency=1,BorderSizePixel=0,
                        Size=UDim2.new(1,-8,1,-8),Position=UDim2.new(0,4,0,4),CanvasSize=UDim2.new(0,0,0,0),
                        AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y,
                        ScrollBarThickness=3,ScrollBarImageColor3=AccentColor,ClipsDescendants=true})
                    Create("UIPadding",{Parent=Scroll,PaddingLeft=UDim.new(0,6),PaddingRight=UDim.new(0,8),PaddingTop=UDim.new(0,4),PaddingBottom=UDim.new(0,4)})
                    local Input = Create("TextBox",{Parent=Scroll,Text="",PlaceholderText=opts.Placeholder or "-- Paste or type your script here...",
                        MultiLine=true,TextWrapped=true,ClearTextOnFocus=false,TextEditable=true,
                        TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,
                        BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,
                        TextSize=12,RichText=false})
                    StyleCleanInput(Input, ShellStroke)
                    Input.Font = Enum.Font.Code
                    Create("UISizeConstraint",{Parent=Input,MinSize=Vector2.new(0,boxH-16)})

                    -- Buttons (outlined to match the textbox).
                    local Row = Create("Frame",{Parent=Exec,BackgroundTransparency=1,Size=UDim2.new(1,-20,0,26),Position=UDim2.new(0,10,0,20+boxH+8)})
                    Create("UIListLayout",{Parent=Row,FillDirection=Enum.FillDirection.Horizontal,SortOrder=Enum.SortOrder.LayoutOrder,
                        Padding=UDim.new(0,8)})
                    
                    local function MakeBtn(text, order, accent)
                        local Holder = Create("Frame", { Parent = Row, BackgroundTransparency = 1, Size = UDim2.new(0.333,-6,1,0), LayoutOrder = order })
                        local B = Create("TextButton", { Parent = Holder, Text = text, Font = Enum.Font.GothamBold, TextSize = 11,
                            TextColor3 = accent and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(220, 222, 232),
                            BackgroundTransparency = 1, AutoButtonColor = false, Size = UDim2.new(1, 0, 1, 0), ZIndex = 2 })
                        local Surface = Create("Frame", { Parent = Holder, BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0,
                            Size = UDim2.new(1, 0, 1, 0), ZIndex = 1, Active = false })
                        Create("UICorner", { Parent = Surface, CornerRadius = UDim.new(0, 8) })
                        local Grad
                        if accent then
                            Grad = Create("UIGradient", { Parent = Surface, Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(140, 90, 240), Color3.fromRGB(90, 50, 180)) })
                        else
                            Grad = Create("UIGradient", { Parent = Surface, Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(54, 56, 68), Color3.fromRGB(32, 34, 44)) })
                        end
                        local St = Create("UIStroke", { Parent = Surface, Color = accent and Color3.fromRGB(180, 140, 255) or Color3.fromRGB(70, 72, 86), Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
                        
                        AddBounce(Holder, 0.94)
                        B.MouseEnter:Connect(function()
                            Tween(Grad, { Offset = Vector2.new(0, 0.2) }, TI.Fast)
                            Tween(St, { Color = accent and Color3.fromRGB(220, 190, 255) or Color3.fromRGB(120, 124, 148) }, TI.Fast)
                        end)
                        B.MouseLeave:Connect(function()
                            Tween(Grad, { Offset = Vector2.new(0, 0) }, TI.Normal)
                            Tween(St, { Color = accent and Color3.fromRGB(180, 140, 255) or Color3.fromRGB(70, 72, 86) }, TI.Normal)
                        end)
                        return B, Surface, St
                    end
                    
                    local RunBtn = MakeBtn("Run",1,true)
                    local ClearBtn = MakeBtn("Clear",2,false)
                    local CopyBtn = MakeBtn("Copy",3,false)

                    Input.Focused:Connect(function() Tween(ShellStroke,{Color=INPUT_STROKE_FOCUS},TI.Fast) end)
                    Input.FocusLost:Connect(function() Tween(ShellStroke,{Color=INPUT_STROKE},TI.Fast) end)

                    local function Flash(btn, text)
                        if btn:GetAttribute("Flashing") then return end
                        btn:SetAttribute("Flashing", true)
                        local old = btn.Text
                        btn.Text = text
                        task.delay(1.2, function()
                            if btn.Parent then
                                btn.Text = old
                                btn:SetAttribute("Flashing", nil)
                            end
                        end)
                    end

                    RunBtn.MouseButton1Click:Connect(function()
                        local code = Input.Text
                        if code:gsub("%s", "") == "" then
                            Library:Notify({ Title = "Executor", Desc = "Nothing to run.", Be = "Warning" })
                            return
                        end
                        local compile = loadstring or load
                        if type(compile) ~= "function" then
                            Library:Notify({ Title = "Executor", Desc = "loadstring is not available in this environment.", Be = "Error" })
                            return
                        end
                        local fn, compileErr = compile(code, "ZyronX_Executor")
                        if not fn then
                            Library:Notify({ Title = "Executor: syntax error", Desc = tostring(compileErr), Be = "Error" })
                            return
                        end
                        Flash(RunBtn, "Running...")
                        task.spawn(function()
                            local ok, runErr = pcall(fn)
                            if ok then
                                Library:Notify({ Title = "Executor", Desc = "Script executed.", Be = "Success" })
                            else
                                Library:Notify({ Title = "Executor: runtime error", Desc = tostring(runErr), Be = "Error" })
                            end
                        end)
                    end)
                    ClearBtn.MouseButton1Click:Connect(function()
                        Input.Text = ""
                        Scroll.CanvasPosition = Vector2.new(0, 0)
                        Flash(ClearBtn, "Cleared")
                    end)
                    CopyBtn.MouseButton1Click:Connect(function()
                        local ok, err = CopyToClipboard(Input.Text)
                        if ok then Flash(CopyBtn, "Copied")
                        else Library:Notify({ Title = "Executor", Desc = tostring(err or "Copy failed."), Be = "Error" }) end
                    end)

                    return { Get = function() return Input.Text end, Set = function(v) Input.Text = tostring(v or "") end, TextBox = Input }
                end
                -- Short alias matching the "addwindowcardcontainermini" style requested.
                Elements.AddWindowCardContainerMini = Elements.AddExecutor

