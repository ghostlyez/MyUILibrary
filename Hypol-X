                    st.Loops[#st.Loops + 1] = TweenService:Create(pk, TweenInfo.new(1.2 + len / 70 + rng:NextNumber(0, 1.5), Enum.EasingStyle.Linear,
                        Enum.EasingDirection.Out, -1, false, rng:NextNumber(0, 2)), { Position = UDim2.new(0, q.x, 0, q.y) })
                end
                for n, p in ipairs(pts) do
                    local nd = Create("Frame", { Parent = root, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.3, BorderSizePixel = 0, Active = false,
                        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, p.x, 0, p.y), Size = UDim2.new(0, 7, 0, 7), ZIndex = 6 })
                    Create("UICorner", { Parent = nd, CornerRadius = UDim.new(1, 0) })
                    local sk = Create("UIStroke", { Parent = nd, Color = spec.A, Thickness = 1, Transparency = 0.2 })
                    NoRemap[nd], NoRemap[sk] = true, true
                    st.Loops[#st.Loops + 1] = TweenService:Create(sk, TweenInfo.new(0.8 + (n % 5) * 0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, (n % 4) * 0.25), { Transparency = 0.85 })
                    if n % 3 == 0 then
                        NoRemap[Create("TextLabel", { Parent = root, BackgroundTransparency = 1, Text = "node_" .. n .. " :: " .. hx(), Font = Enum.Font.Code, TextSize = 9,
                            TextColor3 = spec.C, TextTransparency = 0.55, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0, 90, 0, 10),
                            Position = UDim2.new(0, math.min(p.x + 8, W - 92), 0, p.y - 5), ZIndex = 6, Active = false })] = true
