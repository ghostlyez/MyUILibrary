                    local dropdownListBackground = OPTION_LIST_BACKGROUND
                    local ListFrame = Create("ScrollingFrame", {
                        Parent = DropFrame, BackgroundColor3 = dropdownListBackground,
                        BackgroundTransparency = 0, Size = UDim2.new(1, -20, 0, listHeight),
                        Position = UDim2.new(0, 10, 0, 96),
                        CanvasSize = UDim2.new(0, 0, 0, #options * rowHeight),
                        ScrollBarThickness = #options > 3 and 2 or 0,
                        ScrollBarImageColor3 = OPTION_SCROLLBAR_COLOR,
                        BorderSizePixel = 0, ClipsDescendants = true, Visible = false,
                        ScrollingDirection = Enum.ScrollingDirection.Y,
                        ScrollingEnabled = #options > 3, AutomaticCanvasSize = Enum.AutomaticSize.None,
                        ZIndex = 18, Active = true,
                    })
                    Create("UICorner", { Parent = ListFrame, CornerRadius = UDim.new(0, 9) })
                    Create("UIPadding", { Parent = ListFrame, PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), PaddingTop = UDim.new(0, 2) })
                    local DList = Create("UIListLayout", {
                        Parent = ListFrame, SortOrder = Enum.SortOrder.LayoutOrder,
                        Padding = UDim.new(0, 0),
                    })
                    local ListFade = CreateBottomFade(DropFrame,
                        UDim2.new(0, 10, 0, 96 + math.max(0, listHeight - 16)),
                        UDim2.new(1, -20, 0, 16), 24, dropdownListBackground)
                    local LimitInfo
                    if showLimitInfo then
                        LimitInfo = Create("TextLabel", {
                            Parent = DropFrame, Text = "You can only choose " .. limit .. " options.",
                            Font = Enum.Font.Ubuntu, TextSize = 10, TextColor3 = SubTextColor,
                            BackgroundTransparency = 1, Size = UDim2.new(1, -(limitX + 10), 0, 16),
                            Position = UDim2.new(0, limitX, 0, 96 + listHeight + 6),
                            Visible = false, TextXAlignment = Enum.TextXAlignment.Left,
                        })
                    end

                    -- Space reserved under the list: the widen row (when present) also hosts the limit note.
                    local function ExtraBottom()
                        if hasWiden then return 28 end
                        return showLimitInfo and 20 or 0
                    end

                    -- ---- Widen button (bottom-left of the list) ----
                    -- Framed like a plus-style button; the glyph is two chevrons around a centre bar
                    -- (expand arrows). It flips inward while the list is widened.
                    local WidenBtn, WidenHolder, WidenStroke
                    local WidenBars = {}
                    if hasWiden then
                        WidenBtn = Create("TextButton", {
                            Parent = DropFrame, Text = "", AutoButtonColor = false, BorderSizePixel = 0,
                            BackgroundColor3 = FIELD_BG, Size = UDim2.new(0, 28, 0, 20),
                            Position = UDim2.new(0, 10, 0, 96 + listHeight + 4), Visible = false, ZIndex = 26,
                        })
                        Create("UICorner", { Parent = WidenBtn, CornerRadius = UDim.new(0, 6) })
                        WidenStroke = Create("UIStroke", { Parent = WidenBtn, Color = FIELD_STROKE, Thickness = 1,
                            ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
                        WidenHolder = Create("Frame", { Parent = WidenBtn, BackgroundTransparency = 1,
                            Size = UDim2.new(0, 14, 0, 14), AnchorPoint = Vector2.new(0.5, 0.5),
                            Position = UDim2.new(0.5, 0, 0.5, 0), Active = false, ZIndex = 27 })
                        -- centre bar
                        local mid = Create("Frame", { Parent = WidenHolder, BackgroundColor3 = SubTextColor, BorderSizePixel = 0,
                            Size = UDim2.new(0, 8, 0, 2), AnchorPoint = Vector2.new(0.5, 0.5),
                            Position = UDim2.new(0.5, 0, 0.5, 0), ZIndex = 27 })
                        Create("UICorner", { Parent = mid, CornerRadius = UDim.new(1, 0) })
                        WidenBars[#WidenBars + 1] = mid
                        -- upper chevron "^" and lower chevron "v"
                        for _, dir in ipairs({ -1, 1 }) do
                            for _, side in ipairs({ -1, 1 }) do
                                local bar = Create("Frame", { Parent = WidenHolder, BackgroundColor3 = SubTextColor, BorderSizePixel = 0,
                                    Size = UDim2.new(0, 6, 0, 2), AnchorPoint = Vector2.new(0.5, 0.5),
                                    Position = UDim2.new(0.5 + side * 0.17, 0, 0.5 + dir * 0.3, 0),
                                    Rotation = (dir * side == 1) and -45 or 45, ZIndex = 27 })
                                Create("UICorner", { Parent = bar, CornerRadius = UDim.new(1, 0) })
                                WidenBars[#WidenBars + 1] = bar
                            end
                        end
                    end

                    local function IsSelected(option)
                        if isMulti then return table.find(selected, option) ~= nil end
                        return selected == option
                    end
                    local function UpdateText()
                        if isMulti then
                            local parts = {}
                            for _, value in ipairs(selected) do parts[#parts + 1] = tostring(value) end
                            MainBtn.Text = (#parts == 0) and "Select Options..." or table.concat(parts, ", ")
                            MainBtn.TextColor3 = (#parts == 0) and FIELD_PLACEHOLDER or TextColor
                        else
                            MainBtn.Text = selected ~= nil and tostring(selected) or "Select..."
                            MainBtn.TextColor3 = selected ~= nil and TextColor or FIELD_PLACEHOLDER
                        end
                        if LimitInfo then LimitInfo.Text = "You can only choose " .. limit .. " options." end
                    end
                    local function UpdateSelectionVisuals()
                        for _, row in ipairs(optionRows) do
                            local selectedNow = IsSelected(row.Option)
                            row.Button.TextColor3 = selectedNow and TextColor or SubTextColor
                            row.Button.BackgroundTransparency = selectedNow and OPTION_ROW_SELECTED_TRANSPARENCY or 1
                        end
                    end

                    local function RefreshListMetrics(resetScroll, animate)
                        local visibleCount = 0
                        for _, row in ipairs(optionRows) do
                            if row.Button.Visible then visibleCount = visibleCount + 1 end
                        end
                        visibleOptionCount = visibleCount
                        local contentHeight = visibleCount * rowHeight
                        local dynHeight = math.min(contentHeight, listHeight)
                        ListFrame.CanvasSize = UDim2.new(0, 0, 0, contentHeight)
                        local newSize = UDim2.new(1, -20, 0, dynHeight)
                        if animate then Tween(ListFrame, { Size = newSize }, WIDEN_TWEEN) else ListFrame.Size = newSize end
                        local overflow = contentHeight > dynHeight + 1
                        ListFrame.ScrollingEnabled = overflow
                        ListFrame.ScrollBarThickness = overflow and 2 or 0
                        if resetScroll or ListFrame.CanvasPosition.Y > math.max(0, contentHeight - dynHeight) then
                            settingScroll = true
                            ListFrame.CanvasPosition = Vector2.new(0, 0)
                            settingScroll = false
                        end
                        local fadePos = UDim2.new(0, 10, 0, 96 + math.max(0, dynHeight - 16))
                        if animate then Tween(ListFade, { Position = fadePos }, WIDEN_TWEEN) else ListFade.Position = fadePos end
                        local belowY = 96 + dynHeight + 4
                        if LimitInfo then
                            LimitInfo.Visible = dropped
                            local limitPos = UDim2.new(0, limitX, 0, belowY + 2)
                            if animate then Tween(LimitInfo, { Position = limitPos }, WIDEN_TWEEN) else LimitInfo.Position = limitPos end
                        end
                        if WidenBtn then
                            WidenBtn.Visible = dropped
                            local widenPos = UDim2.new(0, 10, 0, belowY)
                            if animate then Tween(WidenBtn, { Position = widenPos }, WIDEN_TWEEN) else WidenBtn.Position = widenPos end
                        end
                        if dropped then
                            local base = 70 + 32 + dynHeight + ExtraBottom()
                            Tween(DropFrame, { Size = UDim2.new(1, 0, 0, base) }, animate and WIDEN_TWEEN or TI.Fade)
                        end
                        if overflow and not userScrolled and not settingScroll then
                            ListFrame.CanvasPosition = Vector2.new(0, 0)
                        end
                        return contentHeight, dynHeight
                    end

                    local ListStroke = Create("UIStroke", { Parent = ListFrame, Color = FIELD_STROKE_HOT,
                        Thickness = 1, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
                    local DROP_OPEN  = TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                    local DROP_CLOSE = TweenInfo.new(0.52, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
                    -- ===== Cinematic sci-fi layer: scan-beam + trailing glow, HUD corner brackets, hologram flicker =====
                    local FX = { built = false, gen = 0 }
                    -- Bottom brackets follow the REAL list height and only show once the list is scrolled to its end.
                    local function ListBottomY(hgt)
                        local h = ListFrame.Size.Y.Offset
                        if h <= 0 then h = hgt or 0 end
                        return 96 + h
                    end
                    local function AtBottom()
                        local maxY = math.max(0, ListFrame.CanvasSize.Y.Offset - ListFrame.Size.Y.Offset)
                        return maxY <= 1 or ListFrame.CanvasPosition.Y >= maxY - 1
                    end
                    local function PlaceBrackets(spread, hgt)
                        for i = 1, 4 do
                            local right, bottom = (i == 2 or i == 4), (i == 3 or i == 4)
                            local pos = UDim2.new(right and 1 or 0, right and (-10 + spread) or (10 - spread), 0, bottom and (ListBottomY(hgt) + spread) or (96 - spread))
                            FX.Br[i].h.Position = pos; FX.Br[i].v.Position = pos
                        end
                    end
                    local function BuildFX()
                        if FX.built then return end
                        FX.built = true
                        FX.Beam = Create("Frame", { Name = "ZXBeam", Parent = DropFrame, BackgroundColor3 = AccentColor, BorderSizePixel = 0,
                            Size = UDim2.new(1, -20, 0, 2), Position = UDim2.new(0, 10, 0, 96), BackgroundTransparency = 1, ZIndex = 30, Active = false, Visible = false })
                        Create("UIGradient", { Parent = FX.Beam, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) })
                        FX.Glow = Create("Frame", { Name = "ZXGlow", Parent = DropFrame, BackgroundColor3 = AccentColor, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1),
                            Size = UDim2.new(1, -20, 0, 26), Position = UDim2.new(0, 10, 0, 96), BackgroundTransparency = 1, ZIndex = 29, Active = false, Visible = false })
                        Create("UIGradient", { Parent = FX.Glow, Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.55) }) })
                        FX.Br = {}
                        for i = 1, 4 do
                            local ax, ay = (i == 2 or i == 4) and 1 or 0, (i == 3 or i == 4) and 1 or 0
                            local function Bar(w, h)
                                return Create("Frame", { Parent = DropFrame, BackgroundColor3 = AccentColor, BorderSizePixel = 0, Size = UDim2.new(0, w, 0, h),
                                    AnchorPoint = Vector2.new(ax, ay), BackgroundTransparency = 1, ZIndex = 31, Active = false, Visible = false })
                            end
                            FX.Br[i] = { h = Bar(11, 2), v = Bar(2, 11) }
                        end
                    end
                    local function BracketsTo(spread, hgt, transp, info)
                        for i = 1, 4 do
                            local right, bottom = (i == 2 or i == 4), (i == 3 or i == 4)
                            local pos = UDim2.new(right and 1 or 0, right and (-10 + spread) or (10 - spread), 0, bottom and (ListBottomY(hgt) + spread) or (96 - spread))
                            local tr = transp
                            if bottom and transp < 1 and not AtBottom() then tr = 1 end
                            for _, p in ipairs({ FX.Br[i].h, FX.Br[i].v }) do
                                p.Visible = true
                                Tween(p, { Position = pos, BackgroundTransparency = tr }, info)
                            end
                        end
                    end
                    local function SyncBottomBrackets()
                        if not FX.built or not dropped then return end
                        local show, y = AtBottom(), ListBottomY(0)
                        for i = 3, 4 do
                            local pos = UDim2.new(i == 4 and 1 or 0, i == 4 and -8 or 8, 0, y + 2)
                            for _, p in ipairs({ FX.Br[i].h, FX.Br[i].v }) do
                                p.Visible = true
                                Tween(p, { Position = pos, BackgroundTransparency = show and 0.3 or 1 }, TI.Fast)
                            end
                        end
                    end
                    local function Flicker(seq, g, fin)
                        task.spawn(function()
                            for _, v in ipairs(seq) do
                                if FX.gen ~= g then return end
                                ListFrame.BackgroundTransparency = v
                                task.wait(0.035)
                            end
                            if FX.gen == g and fin then ListFrame.BackgroundTransparency = fin end
                        end)
                    end
                    local function PlayOpenFX(hgt)
                        BuildFX()
                        FX.gen = FX.gen + 1
                        local g = FX.gen
                        local col = AccentColor
                        FX.Beam.BackgroundColor3 = col; FX.Glow.BackgroundColor3 = col
                        for i = 1, 4 do FX.Br[i].h.BackgroundColor3 = col; FX.Br[i].v.BackgroundColor3 = col end
                        PlaceBrackets(16, hgt)
                        for i = 1, 4 do FX.Br[i].h.BackgroundTransparency = 1; FX.Br[i].v.BackgroundTransparency = 1 end
                        BracketsTo(2, hgt, 0.15, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
                        -- the scan beam drops through the list and leaves a glow trail
                        FX.Beam.Position = UDim2.new(0, 10, 0, 96); FX.Glow.Position = FX.Beam.Position
                        FX.Beam.Visible = true; FX.Glow.Visible = true
                        FX.Beam.BackgroundTransparency = 0; FX.Glow.BackgroundTransparency = 0.35
                        local dest = UDim2.new(0, 10, 0, 96 + math.max(hgt, 4))
                        local sweep = TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                        Tween(FX.Beam, { Position = dest }, sweep)
                        local glowT = Tween(FX.Glow, { Position = dest }, sweep)
                        glowT.Completed:Once(function()
                            if FX.gen ~= g then return end
                            Tween(FX.Beam, { BackgroundTransparency = 1 }, TweenInfo.new(0.25))
                            Tween(FX.Glow, { BackgroundTransparency = 1 }, TweenInfo.new(0.35))
                            task.delay(0.4, function() if FX.gen == g then FX.Beam.Visible = false; FX.Glow.Visible = false end end)
                            -- bracket "heartbeat" once the beam lands
                            BracketsTo(5, hgt, 0.05, TweenInfo.new(0.16, Enum.EasingStyle.Sine, Enum.EasingDirection.Out))
                            task.delay(0.16, function() if FX.gen == g and dropped then BracketsTo(2, hgt, 0.45, TweenInfo.new(0.35, Enum.EasingStyle.Sine)) end end)
                        end)
                        Tween(ListStroke, { Color = col, Transparency = 0.1 }, TweenInfo.new(0.1))
                        Flicker({ 0.7, 1, 0.4, 0.9, 0.15, 0.55, 0 }, g, 0)
                    end
                    local function HideFX()
                        if not FX.built then return end
                        FX.Beam.Visible = false; FX.Glow.Visible = false
                        for i = 1, 4 do FX.Br[i].h.Visible = false; FX.Br[i].v.Visible = false end
                    end
                    local function PlayCloseFX()
                        if not FX.built then ListFrame.BackgroundTransparency = 1 return end
                        FX.gen = FX.gen + 1
                        local g = FX.gen
                        local hgt = ListFrame.Size.Y.Offset
                        -- HUD brackets snap outward, beam rewinds bottom -> top, panel glitches out
                        BracketsTo(18, hgt, 1, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.In))
                        FX.Beam.BackgroundColor3 = AccentColor; FX.Glow.BackgroundColor3 = AccentColor
                        FX.Beam.Position = UDim2.new(0, 10, 0, 96 + hgt); FX.Glow.Position = FX.Beam.Position
                        FX.Glow.AnchorPoint = Vector2.new(0, 0)
                        FX.Beam.Visible = true; FX.Glow.Visible = true
                        FX.Beam.BackgroundTransparency = 0; FX.Glow.BackgroundTransparency = 0.5
                        local up = TweenInfo.new(0.34, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                        Tween(FX.Beam, { Position = UDim2.new(0, 10, 0, 96) }, up)
                        Tween(FX.Glow, { Position = UDim2.new(0, 10, 0, 96), BackgroundTransparency = 1 }, up).Completed:Once(function()
                            FX.Glow.AnchorPoint = Vector2.new(0, 1)
                            if FX.gen == g then Tween(FX.Beam, { BackgroundTransparency = 1 }, TweenInfo.new(0.15)) end
                        end)
                        Flicker({ 0.25, 0.8, 0.35, 0.95, 0.5, 1 }, g, 1)
                    end
                    -- Row padding is owned by ONE helper: every writer (cascade, hover, close, settle) cancels the previous
-- tween first, so a late/delayed tween can never strand a row at its slide-in offset any more.
                    local ROW_PAD = 12
                    local padTweens = setmetatable({}, { __mode = "k" })
                    local cascadeGen = 0
                    local function SetPad(btn, target, info)
                        local pad = btn:FindFirstChildOfClass("UIPadding")
                        if not pad then return end
                        local old = padTweens[btn]
                        if old then old:Cancel(); padTweens[btn] = nil end
                        if not info then pad.PaddingLeft = UDim.new(0, target); return end
                        local tw = TweenService:Create(pad, info, { PaddingLeft = UDim.new(0, target) })
                        padTweens[btn] = tw
                        tw:Play()
                    end
                    local function ResetRowPads()
                        cascadeGen = cascadeGen + 1
                        for _, row in ipairs(optionRows) do SetPad(row.Button, ROW_PAD) end
                    end
                    -- Rows slide in with a springy overshoot, one after another.
                    local function CascadeRows()
                        cascadeGen = cascadeGen + 1
                        local g = cascadeGen
                        local n = 0
                        for _, row in ipairs(optionRows) do
                            local b = row.Button
                            if b.Visible then
                                n = n + 1
                                if n <= 7 then
                                    local delayT = 0.05 + (n - 1) * 0.04
                                    b.TextTransparency = 1
                                    local oc = b.TextColor3
                                    b.TextColor3 = Color3.new(1, 1, 1)
                                    TweenService:Create(b, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, false, delayT + 0.04), { TextColor3 = oc }):Play()
                                    TweenService:Create(b, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, false, delayT), { TextTransparency = 0 }):Play()
                                    SetPad(b, 46)
                                    SetPad(b, ROW_PAD, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, delayT))
                                else
                                    b.TextTransparency = 0
                                    SetPad(b, ROW_PAD)
                                end
                            end
                        end
                        -- Settle pass: whatever happened during the cascade, every row ends on the standard inset.
                        task.delay(1.0, function()
                            if g ~= cascadeGen or not dropped then return end
                            for _, row in ipairs(optionRows) do
                                local pad = row.Button:FindFirstChildOfClass("UIPadding")
                                if pad and math.abs(pad.PaddingLeft.Offset - ROW_PAD) > 0.5 and math.abs(pad.PaddingLeft.Offset - 16) > 0.5 then
                                    SetPad(row.Button, ROW_PAD, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out))
                                end
                            end
                        end)
                    end

                    -- Cinematic close, stage 1: rows peel away bottom-to-top, sliding right while fading.
                    local function CascadeOut()
                        local visibleRows = {}
                        for _, row in ipairs(optionRows) do
                            if row.Button.Visible then visibleRows[#visibleRows + 1] = row.Button end
                        end
                        local count = math.min(#visibleRows, 7)
                        for i, b in ipairs(visibleRows) do
                            local delayT = (count - math.min(i, count)) * 0.035
                            TweenService:Create(b, TweenInfo.new(0.22, Enum.EasingStyle.Sine,
                                Enum.EasingDirection.In, 0, false, delayT), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
                            SetPad(b, 30, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.In, 0, false, delayT))
                        end
                    end

                    local function SetWidenVisual(on)
                        if not WidenBtn then return end
                        Tween(WidenHolder, { Rotation = on and 180 or 0 },
                            TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
                        Tween(WidenBtn, { BackgroundColor3 = on and Color3.fromRGB(34, 28, 56) or FIELD_BG }, TI.Fast)
                        Tween(WidenStroke, { Color = on and AccentColor or FIELD_STROKE }, TI.Fast)
                        for _, bar in ipairs(WidenBars) do
                            Tween(bar, { BackgroundColor3 = on and AccentColor or SubTextColor }, TI.Fast)
                        end
                    end
                    local function SetWidened(state, silent)
                        widened = state and true or false
                        listHeight = math.min(#options, widened and EXPANDED_ROWS or COLLAPSED_ROWS) * rowHeight
                        SetWidenVisual(widened)
                        if silent then RefreshListMetrics(true, false) else RefreshListMetrics(false, true) end
                    end
                    if WidenBtn then
                        WidenBtn.MouseEnter:Connect(function()
                            if not widened then
                                Tween(WidenStroke, { Color = FIELD_STROKE_HOT }, TI.Fast)
                                Tween(WidenBtn, { BackgroundColor3 = FIELD_BG_HOVER }, TI.Fast)
                            end
                        end)
                        WidenBtn.MouseLeave:Connect(function()
                            if not widened then
                                Tween(WidenStroke, { Color = FIELD_STROKE }, TI.Fast)
                                Tween(WidenBtn, { BackgroundColor3 = FIELD_BG }, TI.Fast)
                            end
                        end)
                        AddBounce(WidenBtn, 0.92)
                        WidenBtn.MouseButton1Click:Connect(function()
                            PlayUISound(UI_SOUND_IDS.Control)
                            SetWidened(not widened)
                        end)
                    end

                    local function CloseDropdown()
                        local myClose = closeToken
                        SB.Out()
                        if LimitInfo then LimitInfo.Visible = false end
                        FieldKit.SetOpen(false)
                        CascadeOut()
                        -- Stage 2: the frame rim flares violet, then everything dims out.
                        Tween(ListStroke, { Color = AccentColor, Transparency = 0.05 },
                            TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)).Completed:Once(function()
                            if myClose ~= closeToken then return end
                            Tween(ListStroke, { Transparency = 1 }, TweenInfo.new(0.32, Enum.EasingStyle.Sine, Enum.EasingDirection.In))
                        end)
                        PlayCloseFX()
                        -- Stage 3: the whole field folds shut with a smooth in-out glide.
                        task.delay(0.1, function()
                            if myClose ~= closeToken or dropped then return end
                            local fold = Tween(DropFrame, { Size = UDim2.new(1, 0, 0, 70) }, DROP_CLOSE)
                            fold.Completed:Once(function()
                                if myClose ~= closeToken or dropped then return end
                                ListFrame.Visible = false
                                HideFX()
                                if WidenBtn then WidenBtn.Visible = false end
                                for _, row in ipairs(optionRows) do
                                    row.Button.TextTransparency = 0
                                    SetPad(row.Button, ROW_PAD)
                                end
                                UpdateSelectionVisuals()
                                ListFrame.BackgroundTransparency = 0
                                ListStroke.Transparency = 1
                                ListStroke.Color = FIELD_STROKE_HOT
                                if widened then SetWidened(false, true) end
                            end)
                        end)
                    end

                    local refreshFade = BindBottomFade(ListFrame, ListFade,
                        function() return dropped end,
                        function() return visibleOptionCount > 4 end)
                    ListFrame:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
                        if not settingScroll and dropped then userScrolled = true end
                        refreshFade()
                        SyncBottomBrackets()
                    end)
                    ListFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(refreshFade)
                    ListFrame:GetPropertyChangedSignal("Size"):Connect(SyncBottomBrackets)
                    ListFrame:GetPropertyChangedSignal("CanvasSize"):Connect(SyncBottomBrackets)

                    local function InternalSet(value)
                        if isMulti then
                            local normalized = {}
                            if type(value) == "table" and selectionLimit ~= 0 then
                                for _, requestedOption in ipairs(value) do
                                    local validOption = FindValidOption(requestedOption)
                                    if validOption ~= nil and not table.find(normalized, validOption) then
                                        normalized[#normalized + 1] = validOption
                                        if selectionLimit and #normalized >= selectionLimit then break end
                                    end
                                end
                            end
                            selected = normalized
                        else
                            if value == nil then
                                selected = nil
                            else
                                selected = FindValidOption(value)
                            end
                        end
                        UpdateText()
                        UpdateSelectionVisuals()
                        if callback then callback(selected) end
                    end
                    local function ToggleOption(option)
                        if isMulti then
                            local idx = table.find(selected, option)
                            if idx then
                                table.remove(selected, idx)
                            else
                                table.insert(selected, option)
                                if selectionLimit then
                                    while #selected > selectionLimit do table.remove(selected, 1) end
                                end
                            end
                            InternalSet(selected)
                        else
                            InternalSet(option)
                        end
                    end

                    for index, option in ipairs(options) do
                        local selectedInitially = (not isMulti and selected == option)
                        local OptBtn = Create("TextButton", {
                            Parent = ListFrame, Text = tostring(option), Font = Enum.Font.GothamMedium,
                            TextSize = 12, TextColor3 = selectedInitially and TextColor or SubTextColor,
                            BackgroundColor3 = OPTION_ROW_BACKGROUND, BackgroundTransparency = 1,
                            Size = UDim2.new(1, 0, 0, rowHeight), AutoButtonColor = false,
                            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
                            LayoutOrder = index, ZIndex = 19, ClipsDescendants = true,
                        })
                        local OptPad = Create("UIPadding", { Parent = OptBtn, PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 6) })
                        Create("UICorner", { Parent = OptBtn, CornerRadius = UDim.new(0, 7) })
                        local OptBar = Create("Frame", { Parent = OptBtn, BackgroundColor3 = AccentColor, BorderSizePixel = 0, Active = false,
                            Size = UDim2.new(0, 3, 0, 13), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -9, 0.5, 0),
                            BackgroundTransparency = 1, ZIndex = 20 })
                        Create("UICorner", { Parent = OptBar, CornerRadius = UDim.new(1, 0) })
                        OptBtn:GetPropertyChangedSignal("BackgroundTransparency"):Connect(function()
                            local sel = IsSelected(option)
                            Tween(OptBar, { BackgroundTransparency = sel and 0 or 1 }, TI.Fast)
                        end)
                        OptBtn.MouseEnter:Connect(function() SetPad(OptBtn, 16, TI.Fast) end)
                        OptBtn.MouseLeave:Connect(function() SetPad(OptBtn, ROW_PAD, TI.Normal) end)
                        local row = { Button = OptBtn, Option = option }
                        optionRows[#optionRows + 1] = row
                        OptBtn.MouseEnter:Connect(function()
                            Tween(OptBtn, { BackgroundTransparency = OPTION_ROW_HOVER_TRANSPARENCY }, TI.Fast)
                        end)
                        OptBtn.MouseLeave:Connect(function()
                            Tween(OptBtn, { BackgroundTransparency = IsSelected(option)
                                and OPTION_ROW_SELECTED_TRANSPARENCY or 1 }, TI.Fast)
                        end)
                        OptBtn.MouseButton1Click:Connect(function()
                            PlayUISound(UI_SOUND_IDS.Control)
                            ToggleOption(option)
                        end)
                    end

                    UpdateText()
                    UpdateSelectionVisuals()
                    if configuredDefault then
                        -- Normalize silently, then fire the callback once (deferred).
                        local realCallback = callback
                        callback = nil
                        InternalSet(selected)
                        callback = realCallback
                        FireInitialCallback(realCallback, selected)
                    end
                    RefreshListMetrics(true)
                    refreshFade()

                    SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
                        local query = SearchBox.Text:lower()
                        for _, row in ipairs(optionRows) do
                            row.Button.Visible = query == "" or string.find(row.Button.Text:lower(), query, 1, true) ~= nil
                        end
                        RefreshListMetrics(true)
                        refreshFade()
                    end)

                    MainBtn.MouseButton1Click:Connect(function()
                        PlayUISound(UI_SOUND_IDS.Control)
                        dropped = not dropped
                        closeToken = closeToken + 1
                        if dropped then
                            ListFrame.Visible = true
                            SearchBox.Visible = true
                            SearchBox.Text = ""
                            SB.In()
                            if LimitInfo then LimitInfo.Visible = true end
                            FieldKit.SetOpen(true)
                            UpdateSelectionVisuals()
                            ListStroke.Color = FIELD_STROKE_HOT
                            local _, dynHeight = RefreshListMetrics(false)
                            local totalHeight = 70 + 32 + dynHeight + ExtraBottom()
                            ListFrame.BackgroundTransparency = 1
                            ResetRowPads()
                            PlayOpenFX(dynHeight)
                            Tween(ListStroke, { Transparency = 0.45 }, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.In, 0, false, 0.12))
                            CascadeRows()
                            Tween(DropFrame, { Size = UDim2.new(1, 0, 0, totalHeight) }, DROP_OPEN)
                            refreshFade()
                        else
                            CloseDropdown()
                            refreshFade()
                        end
                    end)

                    do
                        local tw = MeasureTitleWidth(tostring(name))
                        AddInfoIcon(DropFrame, UDim2.new(0, 10 + tw + 5, 0, 0), infoData)
                    end
                    return InternalSet, function() return selected end, function() return DropFrame end
                end

