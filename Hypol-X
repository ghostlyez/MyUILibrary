local AccentColor     = Color3.fromRGB(190, 140, 255)
local BackgroundColor = Color3.fromRGB(18, 18, 20)
local CardColor       = Color3.fromRGB(24, 24, 27)
local HoverColor      = Color3.fromRGB(35, 35, 40)
local TextColor       = Color3.fromRGB(240, 240, 240)
local SubTextColor    = Color3.fromRGB(150, 150, 150)
-- Selected sidebar tab fill: 40% transparent (BackgroundTransparency 0.4).
local TAB_SELECTED_TRANSPARENCY = 0.4
local TAB_HOVER_TRANSPARENCY    = 0.75

-- Shared option-list palette.  The selected fill is 3x as opaque as the old
-- dropdown selection (6% -> 18% opacity), while hover remains distinct.
local OPTION_LIST_BACKGROUND = Color3.fromRGB(19, 20, 23)
local OPTION_ROW_BACKGROUND = Color3.fromRGB(78, 79, 88)
local OPTION_SCROLLBAR_COLOR = Color3.fromRGB(88, 89, 99)
local OPTION_ROW_HOVER_TRANSPARENCY = 0.84
local OPTION_ROW_SELECTED_TRANSPARENCY = 0.82

-- Square toggle palette: slightly lighter than CardColor for clear off-state visibility.
local ToggleBaseColor = Color3.fromRGB(34, 34, 38)
local ToggleGradientStart = Color3.fromRGB(118, 76, 225)
local ToggleGradientEnd = Color3.fromRGB(190, 140, 255)

-- >>> Cinematic charcoal gradient for primary control buttons.
--     Richer multi-stop ramp with a subtle diagonal for depth.
local BUTTON_GRADIENT_TOP    = Color3.fromRGB(82, 84, 95)
local BUTTON_GRADIENT_MID    = Color3.fromRGB(44, 46, 54)
local BUTTON_GRADIENT_BOTTOM = Color3.fromRGB(20, 21, 26)
local BUTTON_STROKE_COLOR    = Color3.fromRGB(74, 76, 86)
local BUTTON_HOVER_STROKE    = Color3.fromRGB(124, 126, 138)

-- Consistent charcoal gradient for primary control buttons. A separate
-- backing frame receives the gradient so button labels retain their own color.
local function ApplyDarkButtonStyle(button, cornerRadius, cinematic)
    if not button or not button:IsA("GuiButton") or not button.Parent then return nil end
    button.AutoButtonColor = false

    local corner = button:FindFirstChildOfClass("UICorner")
    local radius = (corner and corner.CornerRadius) or UDim.new(0, cornerRadius or 6)
    if not corner then
        corner = Create("UICorner", { Parent = button, CornerRadius = radius })
    end

    -- Keep the gradient off the text-bearing button itself. UIGradient affects
    -- the rendered parent GuiObject, so a sibling surface preserves clear text.
    local surfaceName = "__DarkGradientSurface_" .. button.Name
    local surface = button.Parent:FindFirstChild(surfaceName)
    if not surface then
        surface = Create("Frame", {
            Name = surfaceName, Parent = button.Parent,
            Position = button.Position, AnchorPoint = button.AnchorPoint, Size = button.Size,
            BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0,
            BorderSizePixel = 0, Active = false, Selectable = false,
            ZIndex = math.max(1, button.ZIndex - 1), LayoutOrder = button.LayoutOrder,
        })
    end
    surface.Position = button.Position
    surface.AnchorPoint = button.AnchorPoint
    surface.Size = button.Size
    surface.LayoutOrder = button.LayoutOrder
    surface.ZIndex = math.max(1, button.ZIndex - 1)
    surface.BackgroundColor3 = Color3.new(1, 1, 1)
    surface.BackgroundTransparency = 0
    local surfaceCorner = surface:FindFirstChildOfClass("UICorner")
    if not surfaceCorner then
        surfaceCorner = Create("UICorner", { Parent = surface, CornerRadius = radius })
    else
        surfaceCorner.CornerRadius = radius
    end

    local gradient = surface:FindFirstChildOfClass("UIGradient")
    if not gradient then
        gradient = button:FindFirstChildOfClass("UIGradient")
        if gradient then gradient.Parent = surface end
    end
    if not gradient then gradient = Create("UIGradient", { Parent = surface }) end
    -- Slight diagonal + 3-stop ramp gives a much more cinematic read than a
    -- flat top/bottom two-stop.
    gradient.Rotation = 100
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   BUTTON_GRADIENT_TOP),
        ColorSequenceKeypoint.new(0.5, BUTTON_GRADIENT_MID),
        ColorSequenceKeypoint.new(1,   BUTTON_GRADIENT_BOTTOM),
    })

    local stroke = button:FindFirstChildOfClass("UIStroke")
    if not stroke then stroke = Create("UIStroke", { Parent = button, Thickness = 1 }) end
    stroke.Color = BUTTON_STROKE_COLOR
    stroke.Transparency = 0.2

    -- The transparent button stays on the upper layer for reliable hit-testing;
    -- the inactive sibling surface supplies only the visual fill.
    button.ZIndex = math.max(button.ZIndex, surface.ZIndex + 1)
    button.BackgroundColor3 = Color3.new(1, 1, 1)
    button.BackgroundTransparency = 1

    if cinematic then
        -- Cinematic outline: the hairline border carries a bright comet arc. At rest the arc is a
        -- faint static glint; on hover it ignites and orbits the button; on press it whips around
        -- once with a thickness pulse, then settles back into the orbit.
        local DIM = ColorSequence.new({
            ColorSequenceKeypoint.new(0,    Color3.fromRGB(62, 64, 76)),
            ColorSequenceKeypoint.new(0.35, Color3.fromRGB(66, 68, 80)),
            ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(104, 106, 122)),
            ColorSequenceKeypoint.new(0.65, Color3.fromRGB(66, 68, 80)),
            ColorSequenceKeypoint.new(1,    Color3.fromRGB(62, 64, 76)),
        })
        local LIT = ColorSequence.new({
            ColorSequenceKeypoint.new(0,    Color3.fromRGB(52, 53, 64)),
            ColorSequenceKeypoint.new(0.10, Color3.fromRGB(58, 60, 74)),
            ColorSequenceKeypoint.new(0.38, Color3.fromRGB(150, 104, 235)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.62, Color3.fromRGB(190, 140, 255)),
            ColorSequenceKeypoint.new(0.90, Color3.fromRGB(58, 60, 74)),
            ColorSequenceKeypoint.new(1,    Color3.fromRGB(52, 53, 64)),
        })
        stroke.Color = Color3.new(1, 1, 1)
        stroke.Transparency = 0.2
        local arc = Create("UIGradient", { Parent = stroke, Rotation = 0, Color = DIM })
        local function LitNow()
            local Mp = LiveTheme.Map
            return ColorSequence.new({
                ColorSequenceKeypoint.new(0,    Color3.fromRGB(52, 53, 64)),
                ColorSequenceKeypoint.new(0.10, Color3.fromRGB(58, 60, 74)),
                ColorSequenceKeypoint.new(0.38, Mp(Color3.fromRGB(150, 104, 235))),
                ColorSequenceKeypoint.new(0.50, Color3.fromRGB(255, 255, 255)),
                ColorSequenceKeypoint.new(0.62, Mp(Color3.fromRGB(190, 140, 255))),
                ColorSequenceKeypoint.new(0.90, Color3.fromRGB(58, 60, 74)),
                ColorSequenceKeypoint.new(1,    Color3.fromRGB(52, 53, 64)),
            })
        end
        local spin, burst
        local hovering = false
        local function stopSpin()
            if spin then spin:Cancel() spin = nil end
        end
        local function startSpin()
            stopSpin()
            arc.Rotation = 0
            spin = TweenService:Create(arc,
                TweenInfo.new(0.7, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), { Rotation = 360 })
            spin:Play()
        end
        button.MouseEnter:Connect(function()
            hovering = true
            Tween(gradient, { Rotation = 116 }, TI.Normal)
            arc.Color = LitNow()
            Tween(stroke, { Thickness = 1.6, Transparency = 0 }, TI.Fast)
            if not burst then startSpin() end
        end)
        button.MouseLeave:Connect(function()
            hovering = false
            Tween(gradient, { Rotation = 100 }, TI.Normal)
            stopSpin()
            if burst then burst:Cancel() burst = nil end
            arc.Color = DIM
            arc.Rotation = 0
            Tween(stroke, { Thickness = 1, Transparency = 0.2 }, TI.Normal)
        end)
        button.MouseButton1Down:Connect(function()
            stopSpin()
            if burst then burst:Cancel() end
            arc.Color = LitNow()
            arc.Rotation = 0
            Tween(stroke, { Thickness = 2.4, Transparency = 0 }, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
            local myBurst = TweenService:Create(arc,
                TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Rotation = 360 })
            burst = myBurst
            myBurst:Play()
            myBurst.Completed:Once(function(state)
                if state ~= Enum.PlaybackState.Completed or burst ~= myBurst then return end
                burst = nil
                if hovering then
                    Tween(stroke, { Thickness = 1.6, Transparency = 0 }, TI.Normal)
                    startSpin()
                end
            end)
        end)
        button.MouseButton1Up:Connect(function()
            if hovering then Tween(stroke, { Thickness = 1.6 }, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)) end
        end)
    else
        button.MouseEnter:Connect(function()
            Tween(gradient, { Rotation = 116 }, TI.Normal)
            Tween(stroke, { Color = BUTTON_HOVER_STROKE, Transparency = 0.08 }, TI.Fast)
        end)
        button.MouseLeave:Connect(function()
            Tween(gradient, { Rotation = 100 }, TI.Normal)
            Tween(stroke, { Color = BUTTON_STROKE_COLOR, Transparency = 0.2 }, TI.Fast)
        end)
    end
    return gradient
end


