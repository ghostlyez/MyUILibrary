    }
    local introMinVisibleUntil = os.clock() + 2.4
    local function SetLoadingProgress(progress, status)
        if loadingState.finalized or loadingState.buildFailed then return end
        loadingState.progress = math.max(loadingState.progress, math.clamp(progress, 0, 1))
        if status then LoadingStatus.Text = status end
        LoadingPercent.Text = string.format("%d%%", math.floor(loadingState.progress * 100 + 0.5))
    end
    local function EnableWindowBlur()
        -- loadingState.blurDisabled is toggled from Settings > Background Blur.
        if loadingState.blurDisabled then return end
        if not loadingState.blurActive then
            AcquireUIBlur()
            loadingState.blurActive = true
        end
    end
    local function DisableWindowBlur()
        if loadingState.blurActive then
