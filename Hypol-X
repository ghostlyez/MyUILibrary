        if rowW <= 0 then rowW = 190 end
        row.TagX = math.min(pageW + QPTag.Gap, math.max(0, rowW - 10 - 76 + 8))
        row.TabTag.Size = UDim2.new(0, math.min(math.ceil(tabW) + 2, 62), 0, 17)
        row.TabTag.Position = QPTag.UDim(row)
    end

