local function PlayUISound(soundId, volume)
    if not UISoundsEnabled then return end
    if type(soundId) ~= "string" or soundId == "" then return end
    local playedSound = Instance.new("Sound")
    playedSound.Name = "ZyronX_UIInteractionSound"
    playedSound.SoundId = soundId
    playedSound.Volume = (volume or 0.55) * UISoundVolume
    playedSound.Parent = SoundService
    playedSound.Ended:Connect(function()
        if playedSound and playedSound.Parent then playedSound:Destroy() end
    end)
    playedSound:Play()
    -- A fallback cleanup prevents a stuck Sound from accumulating if an asset
    -- fails to load or never raises Ended.
    task.delay(8, function()
        if playedSound and playedSound.Parent then playedSound:Destroy() end
    end)
end

