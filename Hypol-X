                    -- Coalesced refresh: many calls in one frame = one rebuild. Also driven by the shared config bus.
                    local refreshQueued = false
                    local function RefreshMonitor()
                        if refreshQueued then return end
                        refreshQueued = true
                        task.defer(function()
                            refreshQueued = false
                            if ManagerFrame.Parent then RebuildMonitor() end
                        end)
                    end
                    CfgBus.Listen(function(src) if src ~= "vault" then RefreshMonitor() end end)

                    local function ExecuteSave(saveName)
                        local payload = {}
                        for k, el in pairs(Window.ConfigElements) do
                            if el.Get then
                                local ok, value = pcall(el.Get)
                                if ok then payload[k] = value end
                            end
                        end
                        local encoded = HttpService:JSONEncode(payload)
                        local uniqueKey = tostring(math.floor(tick()))
                        _writefile(folderName.."/"..saveName.."_"..uniqueKey..".json", encoded)
                        RefreshMonitor()
                        CfgBus.Fire("vault")
                        Library:Notify({Title="Saved Successfully",
                            Desc="Config ["..saveName.."] secured.", Be="Success"})
                    end

                    CreateBtn.MouseButton1Click:Connect(function()
                        PlayUISound(UI_SOUND_IDS.Control)
                        local saveName = (NameBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
                        if saveName == "" then
                            SaveNameWarning.Visible = true
                            return
                        end
                        SaveNameWarning.Visible = false
                        ExecuteSave(saveName)
                    end)

                    DeleteTogBtn.MouseButton1Click:Connect(function()
                        if editMode then return end
                        PlayUISound(UI_SOUND_IDS.Control)
                        deleteMode = true
                        ConfirmActionBtn.Text = "Delete Selected"
                        SetConfirmStyle("disabled")
                        ApplyModeUi()
                        RefreshMonitor()
                    end)

                    ConfirmActionBtn.MouseButton1Click:Connect(function()
                        if ConfirmActionBtn:GetAttribute("Disabled") then return end
                        if deleteMode then
                            ShowConfirmPopup("Delete presets?",
                                "These saved configs will be erased from your device for good. This can't be undone.",
                                function()
                                    for f in pairs(selectedForDelete) do pcall(function() _delfile(f) end) end
                                    CfgBus.Fire("vault")
                                    deleteMode = false
                                    ApplyModeUi()
                                    RefreshMonitor()
                                    Library:Notify({Title="Deletions Complete",
                                        Desc="Selected saves erased from system.", Be="Warning"})
                                end)
                        elseif editMode then
                            PlayUISound(UI_SOUND_IDS.Control)
                            local newName = NameBox.Text
                            if newName ~= "" then
                                pcall(function() _delfile(editTargetFile) end)
                                ExecuteSave(newName)
                            end
                            editMode = false
                            ApplyModeUi()
                            RefreshMonitor()
                        end
                    end)

                    P_Yes.MouseButton1Click:Connect(function()
                        PlayUISound(UI_SOUND_IDS.Confirm)
                        if _pendingConfirmAction then
                            local act = _pendingConfirmAction
                            _pendingConfirmAction = nil
                            pcall(act)
                        end
                        HideInternalPopup()
                    end)
                    P_No.MouseButton1Click:Connect(function()
                        PlayUISound(UI_SOUND_IDS.Confirm)
                        _pendingConfirmAction = nil
                        HideInternalPopup()
                    end)
                    CancelActionBtn.MouseButton1Click:Connect(function()
                        PlayUISound(UI_SOUND_IDS.Control)
                        editMode = false
                        deleteMode = false
                        NameBox.Text = ""
                        SaveNameWarning.Visible = false
                        SetConfirmStyle("save")
                        ApplyModeUi()
                        RefreshMonitor()
                    end)

                    local function ValuesMatch(cur, def)
                        if type(cur) == "table" and type(def) == "table" then
                            if cur.enabled ~= nil or def.enabled ~= nil then
                                if (cur.enabled or false) ~= (def.enabled or false) then return false end
                                if tostring(cur.key or "") ~= tostring(def.key or "") then return false end
                                return true
                            end
                            local function toSet(t)
                                local s = {}
                                for _, v in ipairs(t) do s[v] = true end
                                return s
                            end
                            local a, b = toSet(cur), toSet(def)
                            for k in pairs(a) do if not b[k] then return false end end
                            for k in pairs(b) do if not a[k] then return false end end
                            return true
                        end
                        if type(cur) ~= type(def) then
                            return tostring(cur) == tostring(def)
                        end
                        return cur == def
                    end

                    ResetBtn.MouseButton1Click:Connect(function()
                        if editMode or deleteMode then return end
                        ShowConfirmPopup("Reset All Features?",
                            "This will turn OFF every toggle and reset all sliders, dropdowns, textboxes, colors, keybinds, indicators, and HV groups back to their defaults. Only features currently different from their defaults will be changed. Continue?",
                            function()
                                local changed, skipped, failed = 0, 0, 0
                                for _, el in pairs(Window.ConfigElements) do
                                    if el.Set and el.Default ~= nil and el.Get then
                                        local okCur, current = pcall(el.Get)
                                        if not okCur then
                                            skipped = skipped + 1
                                        else
                                            local def = el.Default
                                            if ValuesMatch(current, def) then
                                                skipped = skipped + 1
                                            else
                                                local toSet = type(def) == "table" and SafeClone(def) or def
                                                local ok = pcall(function() el.Set(toSet) end)
                                                if ok then changed = changed + 1 else failed = failed + 1 end
                                            end
                                        end
                                    end
                                end
                                Library:Notify({
                                    Title="Reset Complete",
                                    Desc="Changed "..changed.." • Skipped "..skipped.." (already default)",
                                    Be="Warning"
                                })
                            end)
                    end)

                    ManagerSearch:GetPropertyChangedSignal("Text"):Connect(function()
                        local q = ManagerSearch.Text:lower()
                        for _, v in ipairs(Monitor:GetChildren()) do
                            if v:IsA("Frame") then
                                local lbl = v:FindFirstChild("NameLabel")
                                if lbl then
                                    v.Visible = (q == "" or string.find(lbl.Text:lower(), q, 1, true) ~= nil)
                                end
                            end
                        end
                    end)

                    ApplyModeUi()
                    RefreshMonitor()
                end

                return Elements
            end
            return PageObj
        end

        -- The Home tab is always shown first now, so a default tab is no longer force-selected.
        if false and isDefault then
            if Window.CurrentTab and Window.CurrentTab ~= TabConfig then
                Window.CurrentTab.Content.Visible = false
                Window.CurrentTab.Button.BackgroundTransparency = 1
                Window.CurrentTab.Indicator.Size = UDim2.new(0, 3, 0, 0)
                Window.CurrentTab.Txt.TextColor3 = SubTextColor
            end
            TabBtn.BackgroundTransparency = TAB_SELECTED_TRANSPARENCY
            Indicator.Size = UDim2.new(0,3,0,18)
            Txt.TextColor3 = TextColor
            TabContent.Visible = true
            Window.CurrentTab = TabConfig
            selectedQuickPage = nil
            if RefreshQuickPages then RefreshQuickPages(false) end
        end
        if RefreshQuickPages then RefreshQuickPages(false) end
        return TabConfig
    end

    loadingState.buildComplete = true
    SetLoadingProgress(math.max(loadingState.progress, 0.88), "Finalizing interface...")
    TryFinishLoading()
    UpdateBottomBar()
    return Window
end

return Library
