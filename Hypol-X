    -- ============================================================
    -- REST-STATE GUARD (minimize / unminimize stability)
    -- Layout observers (canvas sizes, group heights) read AbsoluteContentSize, which is multiplied by
    -- every UIScale. While the window scales 0 <-> 1 they used to write shrunken sizes into cards, groups
    -- and scroll canvases, so scrolled pages jumped and hidden/collapsed frames popped into view.
    -- Guarded() observers only run once the window is at rest; RunSettle() replays them afterwards, and a
    -- visibility / scroll snapshot makes sure every frame comes back exactly as it was.
    -- ============================================================
    RS.ShellOn = false
    RS.Fns = {}
    RS.Healers = {} -- per-card self-repair callbacks (ip: hypol-X / ZyronX core)
    function RS.AtRest()
        return (not RS.ShellOn) and math.abs(MainScale.Scale - windowScale) < 0.002
    end
    function RS.Guarded(fn)
        RS.Fns[#RS.Fns + 1] = fn
        return function() if RS.AtRest() then fn() end end
    end
    function RS.Run()
        if not RS.AtRest() then return end
        -- time-sliced: the settle callbacks used to all run inside ONE frame (the restore hitch); now ~5 ms per frame
        RS.RunId = (RS.RunId or 0) + 1
        local id = RS.RunId
        task.spawn(function()
            local t0 = os.clock()
            local function Step(fn)
                pcall(fn)
                if os.clock() - t0 > 0.005 then
                    task.wait()
                    t0 = os.clock()
                    return id == RS.RunId
                end
                return true
            end
            for _, fn in ipairs(RS.Fns) do if not Step(fn) then return end end
            for _, fn in ipairs(RS.Healers) do if not Step(fn) then return end end
        end)
    end
    function RS.Snapshot()
        local snap = { hidden = {}, scroll = {} }
        for _, d in ipairs(MainFrame:GetDescendants()) do
            if d:IsA("GuiObject") then
                if not d.Visible then snap.hidden[#snap.hidden + 1] = d end
                if d:IsA("ScrollingFrame") then snap.scroll[d] = d.CanvasPosition end
            end
        end
        return snap
    end
    function RS.Apply(snap)
        if not snap then return end
        for _, d in ipairs(snap.hidden) do
            if d.Parent and d.Visible then d.Visible = false end
        end
        for sf, pos in pairs(snap.scroll) do
            if sf.Parent and sf.CanvasPosition.Y < pos.Y - 0.5 then sf.CanvasPosition = pos end
