                Create("UICorner",{Parent=TitleNotch,CornerRadius=UDim.new(1,0)})
                Create("UIGradient",{Parent=TitleNotch,Rotation=90,Color=ColorSequence.new(AccentColor,Color3.fromRGB(110,72,210))})
