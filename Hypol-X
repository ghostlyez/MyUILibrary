                    Transparency = NumberSequence.new({ KN(0, 0.38), KN(0.5, 0.84), KN(1, 0.3) }) }))
                Loop("ZXExploiter_Aura_" .. i, haze, { BackgroundTransparency = 0.86 }, 1.75 + i * 0.3, true)

                local ringSpecs = {
                    { w = 184, h = 68, rot = -17, thick = 2.7, trans = 0.18, speed = 360 },
                    { w = 154, h = 49, rot = 19, thick = 1.9, trans = 0.25, speed = -360 },
                    { w = 122, h = 36, rot = -5, thick = 1.35, trans = 0.38, speed = 360 },
