                PageMarks.Diamond = Mk({AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(0,8,0.5,0),Size=UDim2.new(0,0,0,0),Rotation=45})
                PageMarks.Bars[1] = Mk({Position=UDim2.new(0,3,0,3),Size=UDim2.new(0,0,0,2)})
                PageMarks.Bars[2] = Mk({Position=UDim2.new(0,3,0,3),Size=UDim2.new(0,2,0,0)})
                PageMarks.Bars[3] = Mk({AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-3,1,-3),Size=UDim2.new(0,0,0,2)})
                PageMarks.Bars[4] = Mk({AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-3,1,-3),Size=UDim2.new(0,2,0,0)})
                PageMarks.Sheen = Mk({BackgroundColor3=Color3.new(1,1,1),AnchorPoint=Vector2.new(0.5,0.5),
                    Position=UDim2.new(-0.3,0,0.5,0),Size=UDim2.new(0,14,1.6,0),Rotation=18,BackgroundTransparency=1})
                Create("UIGradient",{Parent=PageMarks.Sheen,Transparency=NumberSequence.new({
                    NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.5,0.35),NumberSequenceKeypoint.new(1,1)})})
                function PageMarks.Set(sel)
                    local info = sel and TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                        or TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                    local L = sel and 7 or 0
                    Tween(PageMarks.Diamond, { Size = sel and UDim2.new(0,4,0,4) or UDim2.new(0,0,0,0) }, info)
                    Tween(PageMarks.Bars[1], { Size = UDim2.new(0,L,0,2) }, info)
                    Tween(PageMarks.Bars[2], { Size = UDim2.new(0,2,0,L) }, info)
                    Tween(PageMarks.Bars[3], { Size = UDim2.new(0,L,0,2) }, info)
                    Tween(PageMarks.Bars[4], { Size = UDim2.new(0,2,0,L) }, info)
                    if sel then
                        PageMarks.Sheen.Position = UDim2.new(-0.3,0,0.5,0)
                        PageMarks.Sheen.BackgroundTransparency = 0
                        Tween(PageMarks.Sheen, { Position = UDim2.new(1.3,0,0.5,0) },
                            TweenInfo.new(0.55, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)).Completed:Once(function()
                            PageMarks.Sheen.BackgroundTransparency = 1
                        end)
                    end
                end
            end
            local PageHighlight = Create("Frame",{Parent=PageBtn,BackgroundColor3=Color3.fromRGB(232,234,242),
