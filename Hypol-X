    -- Anti-stuck watchdog: if the build finished but something still blocks the reveal, force it through.
    task.delay(16, function()
        if loadingState.finalized or loadingState.buildFailed or not loadingState.buildComplete then return end
        introMinVisibleUntil = 0
        loadingState.timedOut = true
        loadingState.preloadDone = true
        TryFinishLoading()
    end)
    end

    task.spawn(function()
        local ok, completed, total, failed, err = PreloadAssets(preloadAssets, function(done, count)
            if loadingState.finalized or loadingState.buildFailed or loadingState.timedOut then return end
            local ratio = count > 0 and (done / count) or 1
            SetLoadingProgress(0.08 + 0.68 * ratio, "Loading assets " .. done .. " / " .. count .. "...")
        end)
        if (not ok or (failed or 0) > 0) and not loadingState.timedOut and not loadingState.finalized then
            SetLoadingProgress(0.78, "Retrying asset loading...")
            ok, completed, total, failed, err = PreloadAssets(preloadAssets, function(done, count)
