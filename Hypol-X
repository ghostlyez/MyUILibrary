    local function GetOrderedQuickRows()
        local ordered = {}
        if not Window or not Window.Tabs then return ordered end
        for _, tab in ipairs(Window.Tabs) do
            for _, page in ipairs(tab.Pages) do
                local row = quickPageRows[page]
                if row and row.Button and row.Button.Parent and row.Button.Visible then
                    ordered[#ordered + 1] = row
                end
            end
        end
        table.sort(ordered, function(a, b)
            return (a.Button.LayoutOrder or 0) < (b.Button.LayoutOrder or 0)
        end)
        return ordered
    end

    -- Tag X (inside the row's padded area) = page-name width + a small gap, clamped so it stays inside the row.
