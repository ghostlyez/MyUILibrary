    -- Backgrounds are flattened independently on each side.  All surfaces inside
    -- a CanvasGroup are opaque and share the same color, so overlapping seam/corner
    -- patches are composited into one texture before GroupTransparency is applied.
    -- CanvasGroup requires Sibling ZIndexBehavior (set on ScreenGui above).
    local BackgroundSurfaceRefs = {}
    local function RegisterBackgroundSurface(surface, isRightSide)
        BackgroundSurfaceRefs[#BackgroundSurfaceRefs + 1] = {
            Object = surface,
            IsRightSide = isRightSide,
        }
        return surface
    end

    local LeftBackgroundGroup = RegisterBackgroundSurface(Create("CanvasGroup", {
        Name = "LeftBackgroundGroup", Parent = MainFrame,
        Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(0, 160, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        GroupTransparency = 0.02, Active = false, ZIndex = 1,
    }), false)
    local RightBackgroundGroup = RegisterBackgroundSurface(Create("CanvasGroup", {
        Name = "RightBackgroundGroup", Parent = MainFrame,
        Position = UDim2.new(0, 160, 0, 0), Size = UDim2.new(1, -160, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        GroupTransparency = 0.1, Active = false, ZIndex = 1,
    }), true)

    local function CreateSplitBackgroundPanel(parent, name, position, size, cornerRadius)
        local panel = Create("Frame", {
            Name = name, Parent = parent,
            BackgroundColor3 = BackgroundColor, BackgroundTransparency = 0,
            BorderSizePixel = 0, Position = position, Size = size,
            Active = false, ZIndex = 1,
        })
        if cornerRadius then
            Create("UICorner", { Parent = panel, CornerRadius = UDim.new(0, cornerRadius) })
        end
        return panel
    end
    local function AddBackgroundPatch(parent, name, position, size)
        return Create("Frame", {
            Name = name, Parent = parent,
            BackgroundColor3 = BackgroundColor, BackgroundTransparency = 0,
            BorderSizePixel = 0, Position = position, Size = size,
            Active = false, ZIndex = 2,
        })
    end

    -- Left rail: rounded outer-left corners with opaque patches to square the
    -- center seam. The groups' final 2% sheen is applied once to the flattened side.
    local TopBarLeftBackground = CreateSplitBackgroundPanel(LeftBackgroundGroup,
        "TopBarLeftBackground", UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 40), 12)
    AddBackgroundPatch(TopBarLeftBackground, "TopBarLeftSeamPatch",
        UDim2.new(1, -12, 0, 0), UDim2.new(0, 12, 1, 0))
    AddBackgroundPatch(TopBarLeftBackground, "TopBarLeftBottomPatch",
        UDim2.new(0, 0, 1, -12), UDim2.new(1, 0, 0, 12))

    local LeftBackground = CreateSplitBackgroundPanel(LeftBackgroundGroup,
        "LeftBackground", UDim2.new(0, 0, 0, 40), UDim2.new(1, 0, 1, -40), 12)
    AddBackgroundPatch(LeftBackground, "LeftBackgroundTopPatch",
        UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 12))
    AddBackgroundPatch(LeftBackground, "LeftBackgroundSeamPatch",
        UDim2.new(1, -12, 0, 0), UDim2.new(0, 12, 1, 0))

    -- Right rail: a single rounded outer surface with opaque seam patches that
    -- square only its left edge. No full-width square layer extends past the
    -- rounded right corners.
    local RightBackground = CreateSplitBackgroundPanel(RightBackgroundGroup,
        "RightBackground", UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), 12)
    AddBackgroundPatch(RightBackgroundGroup, "RightBackgroundTopSeamPatch",
        UDim2.new(0, 0, 0, 0), UDim2.new(0, 12, 0, 12))
    AddBackgroundPatch(RightBackgroundGroup, "RightBackgroundBottomSeamPatch",
        UDim2.new(0, 0, 1, -12), UDim2.new(0, 12, 0, 12))

    local LEFT_BASE_TRANSPARENCY = 0.02
    local RIGHT_BASE_TRANSPARENCY = 0.1
    local ThemeRefs = { GlassExtra = 0 } -- gradient refs + Settings > Transparency extra (5%), one local on purpose
    local function ApplyBackgroundTransparency(value, info)
        local leftTransparency = math.clamp(math.max(value, LEFT_BASE_TRANSPARENCY) + ThemeRefs.GlassExtra, 0, 1)
        local rightTransparency = math.clamp(math.max(value, RIGHT_BASE_TRANSPARENCY) + ThemeRefs.GlassExtra, 0, 1)
        for _, entry in ipairs(BackgroundSurfaceRefs) do
            local transparency = entry.IsRightSide and rightTransparency or leftTransparency
            if info then
                Tween(entry.Object, { GroupTransparency = transparency }, info)
            else
                entry.Object.GroupTransparency = transparency
            end
        end
    end

    -- Aurora tint: the gradients live on the CanvasGroups, so they tint the already
    -- flattened side textures. Window transparency (GroupTransparency) still fades them as one.
    ThemeRefs.Left = Create("UIGradient", {
        Parent = LeftBackgroundGroup, Rotation = 115,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.55, Color3.fromRGB(226, 220, 246)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(196, 178, 240)),
        }),
    })
    ThemeRefs.Right = Create("UIGradient", {
        Parent = RightBackgroundGroup, Rotation = 62,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(236, 230, 252)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(222, 212, 250)),
        }),
    })
    Create("UICorner", { Parent = MainFrame, CornerRadius = UDim.new(0, 12) })
    -- AURORA OUTLINE v3: every layer is a UIStroke on a frame that is EXACTLY MainFrame-sized and centred
    -- (AnchorPoint .5/.5, same UICorner). UIStroke Border mode draws OUTWARD only, so the ring hugs the window edge and
    -- never deepens inward. The old grey/dark base gradient is gone: the base ring is a seamless, fully coloured aurora.
    local MainFrameStroke = Create("UIStroke", { Parent = MainFrame, Color = Color3.new(1, 1, 1), Thickness = 3.5,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, LineJoinMode = Enum.LineJoinMode.Round })
    MainFrameStroke:SetAttribute("zx_keep", true)
    local MotionLoops = {}
    do
        local mc = MainFrame:FindFirstChildOfClass("UICorner")
        local KC, KN = ColorSequenceKeypoint.new, NumberSequenceKeypoint.new
        local TEAL, VIOLET, MAG, BLUE = Color3.fromRGB(70, 214, 226), Color3.fromRGB(150, 104, 235), Color3.fromRGB(226, 122, 232), Color3.fromRGB(96, 128, 255)
        local ICE, MINT = Color3.fromRGB(238, 230, 255), Color3.fromRGB(120, 255, 214)
        ThemeRefs.Stroke = Instance.new("UIGradient") -- detached sink: theme code may tween it, nothing is drawn from it
        local function Spin(name, g, rot, dur)
            MotionLoops[name] = TweenService:Create(g, TweenInfo.new(dur, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), { Rotation = rot })
        end
        local function Layer(name, z, thick, grad)
            local f = Create("Frame", { Name = name, Parent = MainFrame, BackgroundTransparency = 1, BorderSizePixel = 0, Active = false, ZIndex = z,
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(1, 0, 1, 0) })
            if mc then Create("UICorner", { Parent = f, CornerRadius = mc.CornerRadius }) end
            local s = Create("UIStroke", { Parent = f, Thickness = thick, Color = Color3.new(1, 1, 1),
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border, LineJoinMode = Enum.LineJoinMode.Round })
            s:SetAttribute("zx_keep", true)
            grad.Parent = s
            return f, s
        end
        -- (1) base ring: seamless teal > violet > magenta > blue > teal, slow and calm
        local baseG = Create("UIGradient", { Parent = MainFrameStroke, Rotation = 0,
            Color = ColorSequence.new({ KC(0, TEAL), KC(0.25, VIOLET), KC(0.5, MAG), KC(0.75, BLUE), KC(1, TEAL) }),
            Transparency = NumberSequence.new({ KN(0, 0), KN(0.475, 0), KN(0.476, 1), KN(0.524, 1), KN(0.525, 0), KN(1, 0) }) }) -- 5% of the ring is cut away
        Spin("Outline", baseG, 360, 0.85)
        -- (2) aurora curtains: soft green/cyan/violet bands drifting the other way
        local curG = Create("UIGradient", { Rotation = 0,
            Color = ColorSequence.new({ KC(0, MINT), KC(0.3, TEAL), KC(0.55, VIOLET), KC(0.8, MAG), KC(1, MINT) }),
            Transparency = NumberSequence.new({ KN(0, 0.5), KN(0.2, 0), KN(0.38, 0.35), KN(0.55, 0.55), KN(0.7, 0), KN(0.85, 0.4), KN(1, 0.5) }) })
        Layer("OutlineAurora", 38, 4.5, curG)
        Spin("OutlineAurora", curG, -360, 0.8)
        -- (3) bright comet with a long fading tail
        local w = 0.34
        local cometG = Create("UIGradient", { Rotation = 0,
            Color = ColorSequence.new({ KC(0, VIOLET), KC(0.5 - w, VIOLET), KC(0.5 - w * 0.5, VIOLET:Lerp(ICE, 0.4)), KC(0.5, ICE), KC(0.52, Color3.new(1, 1, 1)), KC(0.53, VIOLET), KC(1, VIOLET) }),
            Transparency = NumberSequence.new({ KN(0, 1), KN(0.5 - w, 1), KN(0.5 - w * 0.55, 0.8), KN(0.5 - w * 0.2, 0.35), KN(0.5, 0), KN(0.53, 0.1), KN(0.535, 1), KN(1, 1) }) })
        Layer("OutlineCometA", 39, 4.5, cometG)
        Spin("OutlineCometA", cometG, 360, 0.6)
        -- (4) two breathing outer halos (outward only, start at the edge)
        local function Halo(name, thick, t0, t1, dur, phase, col)
            local hg = Create("UIGradient", { Rotation = 0, Color = ColorSequence.new({ KC(0, col), KC(0.5, BLUE), KC(1, col) }) })
            local _, hs = Layer(name, 37, thick, hg)
            hs.Transparency = t0
            MotionLoops[name] = TweenService:Create(hs, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, phase), { Transparency = t1, Thickness = thick * 0.6 })
            Spin(name .. "Spin", hg, 360, 4.4)
        end
        Halo("OutlineHalo", 8, 0.88, 0.7, 2.2, 0, TEAL)
        Halo("OutlineHalo2", 13, 0.95, 0.84, 3.4, 0.9, MAG)
    end
    Tween(MainScale, {Scale=1}, TI.Slow)

    -- IDLE FRAME FX: only frames / outlines animate (corner brackets breathe, edge scanners sweep).
    -- Nothing here moves the window or its content; it rides MainFrame so it follows drags.
    do
        local IdleFX = Create("Frame", { Name = "IdleFX", Parent = MainFrame, BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0), Active = false, ZIndex = 40 })
        local corners = { { 0, 0 }, { 1, 0 }, { 1, 1 }, { 0, 1 } }
        for i, c in ipairs(corners) do
            local ax, ay = c[1], c[2]
            local px = UDim2.new(ax, ax == 0 and 4 or -4, ay, ay == 0 and 4 or -4)
            for k = 1, 2 do
                local f = Create("Frame", { Parent = IdleFX, BackgroundColor3 = AccentColor, BorderSizePixel = 0, Active = false,
                    AnchorPoint = Vector2.new(ax, ay), Position = px, BackgroundTransparency = 0.82,
                    Size = k == 1 and UDim2.new(0, 11, 0, 2) or UDim2.new(0, 2, 0, 11) })
                Create("UICorner", { Parent = f, CornerRadius = UDim.new(1, 0) })
                MotionLoops["IdleCorner" .. i .. k] = TweenService:Create(f,
                    TweenInfo.new(1.5 + i * 0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, (i - 1) * 0.25),
                    { BackgroundTransparency = 0.08 })
            end
        end
        local function EdgeSweep(name, y, dir, dur)
            local line = Create("Frame", { Parent = IdleFX, BackgroundColor3 = AccentColor, BorderSizePixel = 0, Active = false,
                Size = UDim2.new(1, -44, 0, 1), AnchorPoint = Vector2.new(0.5, y), Position = UDim2.new(0.5, 0, y, y == 0 and 1 or -1) })
            local g = Create("UIGradient", { Parent = line, Offset = Vector2.new(-dir, 0), Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.42, 1), NumberSequenceKeypoint.new(0.5, 0.05),
