            Tween(dot, {
                Position = UDim2.new(sp.X.Scale, sp.X.Offset + math.cos(ang) * dist, sp.Y.Scale, sp.Y.Offset + math.sin(ang) * dist),
                BackgroundTransparency = 1, Size = UDim2.new(0, 2, 0, 2),
