            -- Single source of truth for the chip: selected / hover state drives ONE tracked tween,
            -- so hover tweens can never overwrite (and hide) the selected highlight.
            local chipTween
            local function ApplyChip()
                if chipTween then chipTween:Cancel() end
                local selected = PageBtn:GetAttribute("__Sel") == true
                local hover = PageBtn:GetAttribute("__Hover") == true
                local bgT = selected and 0.3 or (hover and 0.82 or 1)
                local bgC = selected and LiveTheme.Map(Color3.fromRGB(96,66,176)) or Color3.fromRGB(66,68,78)
                chipTween = TweenService:Create(PageBtn, TI.Fast, { BackgroundTransparency = bgT, BackgroundColor3 = bgC })
                chipTween:Play()
            end
            PageBtn.MouseEnter:Connect(function()
